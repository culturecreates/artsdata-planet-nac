      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ravel, Chopin & Kevin Chen | Piano, Ballet, and Beyond | Apr 28 - 29, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40405/naco_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know...\n\n\n\tReconnect with your inner child as you experience music that conjures the fantasy and nostalgia of fairy tales and a classic carnival ride.\n\tFrom Ravel’s storybook ballet to the sweeping romance of Chopin’s piano writing, this program will leave you feeling refreshed and filled with wonder.\n\n\nMaurice Ravel was known for his childlike imagination, and in his ballet Ma mère l’Oye (Mother Goose), the French composer brings that childlike innocence to life with music of unbridled imagination. Get ready..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
