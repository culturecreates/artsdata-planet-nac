    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Boréalis | National Creation Fund"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-creationfund.s3.amazonaws.com/41805/0001-2547293538466260663__hero_large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In Boréalis, Mishka Lavigne transforms the Canadian landscape into a mythical realm. Drawing inspiration from northern forests, villages, animals, and scenery, this three-part cycle explores the unsettling encounter between the human world and the forces that transcend it. Adopting a Gothic aesthetic that delves into the shadows and crevices of the northern environment, the project aims to depict the region in a new way: intimate yet epic, familiar yet mysterious.\n\nTo bring this..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
