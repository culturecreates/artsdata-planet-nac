    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "“The artistic concepts we are so proud to present to you are impressively imaginative in their forms and styles. Without pretension, they reflect the concerns of our society and express, from very different perspectives, beauty and hope. They are a helping hand toward a more just, more humane society.”"
      }
    ],
