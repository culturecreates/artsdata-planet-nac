    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Direction d’orchestre : Brahms, Debussy et Dvořák | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/28666/alexander_shelley-conducting_masterclasses_credit_reYmy_theYriault__meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Disponible en anglais seulement.\n\nAssistez à cette serie de classes de direction d’orchestre avec le Directeur musical du CNA Alexander Shelley et Murray Lefebvre et Adrian Lo, boursiers du programme de résidence pour jeunes directeurs.trices d’orchestre de MusicFest Canada 2021 et  Frédéric Michaud et Charles-Éric Fontaine, étudiants en direction orchestrale de l’école de musique Schulich de l’Université McGill."
      }
