    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Artemis II astronauts live at Canada’s NAC"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The wait is over! Watch the full, uncut conversation with the historic Artemis II crew live from your National Arts Centre. In this exclusive panel discussion, the crew shares firsthand insights into their rigorous training, what it truly feels like to prepare for a historic journey around the Moon, and Canada&rsquo;s pivotal role in the future of deep space exploration. Featuring the Artemis II panel: Jeremy Hansen,&nbsp;Canadian Space Agency Astronaut&nbsp; Reid Wiseman,&nbsp;NASA Artemis II Commander&nbsp; Victor Glover,&nbsp;NASA Artemis II Pilot&nbsp; Christina Koch,&nbsp;NASA Artemis II Mission Specialist&nbsp; Jenni Gibbons,&nbsp;CSA Astronaut &amp; Artemis II Backup/Capcom Moderated by Caroline Ohrt, Executive Producer of NAC Dance"
      }
    ]
  },
