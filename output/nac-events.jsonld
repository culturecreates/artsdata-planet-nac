    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Choir! Choir! Choir! Un-Silent Night"
      },
      {
        "@language": "fr",
        "@value": "Choir! Choir! Choir! Un-Silent Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Un-Silent Night is Choir! Choir! Choir!’s warmest and fuzziest night ever! Imagine yourself surrounded by hundreds of other voices, making your way through an unforgettable mix of holiday classics and seasonal pop gems!"
      },
      {
        "@language": "fr",
