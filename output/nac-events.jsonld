    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/17015/header-lantern__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Son abondante lumière naturelle et ses vues spectaculaires du parlement et de la Tour de la Paix font de la Salle de la lanterne Mohammad Al Zaibak un choix fort populaire pour les activités d’affaires et les événements sociaux.\n\nLe CNA offre un éventail de salles uniques qui constitueront le cadre parfait pour votre événement. Nous nous ferons un plaisir de vérifier les disponibilités pour vous, d’organiser une visite privée de nos installations et de répondre à toutes vos questions."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
