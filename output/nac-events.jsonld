  {
    "@id": "https://nac-cna.ca/fr/theatrefrancais",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/theatrefrancais"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Théâtre français du CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/theatrefrancais/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Être au présent · Être au présent, pour nous, c’est rester attentif au monde tel qu’il est – complexe, inquiet, traversé de tensions.\n\nC’est être présent aux artistes, à leurs voix singulières, à leurs prises de risque.\n\nC’est être présent au public, qui accepte encore de s’asseoir ensemble, dans un même espace, pour écouter, ressentir, réfléchir."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/theatrefrancais"
      }
    ]
  },
