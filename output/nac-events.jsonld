    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "An Evening with Min Jin Lee | Award-winning & Bestselling Author of Pachinko |  Tue, Mar 16, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41645/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "When Min Jin Lee publishes her third novel, American Hagwon, on September 29, it will have been just shy of ten years since her historical epic Pachinko. That book, which became a best seller and was shortlisted for the National Book Award, was meticulously researched and had a massive emotional sweep, with twists, heartbreaks, and family secrets held by generations of one Korean family living mainly in Japan. American Hagwon will pick up thematically as the third entry in what will be a quartet..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
