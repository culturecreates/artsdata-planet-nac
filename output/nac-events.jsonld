  {
    "@id": "https://nac-cna.ca/fr/dance",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/dance"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Danse CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/dance/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Danse CNA est ici! · La saison de danse 2026–2027 célèbre avant tout le corps en mouvement comme source de vitalité, de renouvellement; révélant l’essence-même de notre relation au monde et la puissance intime des gestes. \n\nLes voix chorégraphiques canadiennes et internationales invitées proposent des œuvres sensibles et audacieuses, où le mouvement se déploie comme un souffle, un lieu d’écoute et de métamorphoses. Du street dance au kathak, des danses traditionnelles autochtones et cubaines au ballet contemporain, la saison de danse révèle la richesse des cultures et leurs multiples façons de s'affirmer et de célébrer la vie. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/dance"
