    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tournée Canada 150 de l’Orchestre du cna Canada 150"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_landing.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pour souligner le 150e anniversaire de la Confédération canadienne, l’Orchestre du Centre national des Arts effectuera une tournée pancanadienne au printemps et à l’automne 2017.\n\nMenée par le directeur musical Alexander Shelley, la Tournée Canada 150 comprend plus d’une douzaine de grands concerts et plus de 150 activités éducatives et culturelles qui se tiendront aux quatre coins du pays."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
