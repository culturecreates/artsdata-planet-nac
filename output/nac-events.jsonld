    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Notes artistiques : Rhino"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40370/rhino_by_out_innerspace_photo_of_adam_khazhmuradov_by_mark_kelly_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une mystérieuse aventure lynchéenne   Tiffany Tregarthen et David Raymond, codirecteurs de la compagnie vancouvéroise Out Innerspace, font preuve d’une imagination sans bornes. Avec un langage chorégraphique empreint de fluidité et de plasticité, ils créent des œuvres à caractère surréaliste qui..."
      }
    ],
