    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Under the leadership of Alexander Shelley, this exceptional orchestra is breaking new ground for the orchestral experience both inside and outside the concert hall. With adventurous new works, fresh interpretations of classics and meaningful community partnerships, the NAC Orchestra is crossing the spaces between us by telling the stories of our shared humanity."
      }
