    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Résidence artistique : Le Projecteur | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/40534/melissa-ouimet_crop-01635__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Projecteur est un programme de développement professionnel unique du CNA destiné aux artistes en chanson de la francophonie canadienne. L’initiative vise à perfectionner les compétences professionnelles et artistiques des interprètes francophones au Canada.\n\nCette résidence artistique a un objectif spécifique : améliorer la prestation des artistes sur scène et leur donner les moyens de perfectionner leur art pour évoluer avec assurance dans le monde de la musique. Le programme aborde différentes facettes de l’interprétation comme les arrangements, l’orientation générale du spectacle, les transitions entre les morceaux et ce que les artistes souhaitent transmettre à propos de leurs chansons pendant les concerts."
      }
    ],
