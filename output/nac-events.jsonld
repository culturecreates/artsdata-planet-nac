    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Le Projecteur: Resident artist Jacques Surette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The National Arts Centre&rsquo;s Projecteur Program focuses on enhancing the professional and artistic skills of Franco-Canadian performers.&nbsp; Acadian singer&#8209;songwriter Jacques Surette was invited to work with award winning multidisciplinary Ga&euml;le for a two day residency. Together they workshopped various aspects of performance, including song arrangements, overall show direction, transitions between pieces, and storytelling."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/d4080181e50a4248",
