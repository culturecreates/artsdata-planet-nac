    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Che_nous  | D-Track, Dumis9ne et Quest |   sam  7 nov 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41601/che_nous-upsized__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Accompagné par Jean-François Tremblay au piano et Eazy El Dee aux platines, Che_nous propose une prestation acoustique aux accents reggae, à la fois organique et minimaliste, où la musique et le texte respirent pleinement. Reconnu pour ses chansons engagées et chaleureuses, le groupe sait captiver le public et le faire danser sur des rythmes accrocheurs. \n\nFondé en 2025, Che_nous fusionne hip-hop, reggae et musiques du monde. Le projet réunit D-Track (Gatineau) et Dumis9ne I (Malawi) aux textes, ainsi que Quest (Ottawa)..."
      }
    ],
