    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NAC English Theatre\n \n \n  |  Events"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/englishtheatre/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Past Forward · Theatre is my favourite time machine: you walk into a dark room in 2026, and somehow, you’re in 1609, 1950s Toronto, the Red River in the 40s, Phnom Penh in the 70s, and you’re also in an ancient text, a family kitchen, a rehearsal hall, a remembered homeland, or a history book you didn’t realize you’d been carrying. The lights come up and—blink—you’re back in your own life, seeing it differently. That’s the spirit of PAST FORWARD."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
