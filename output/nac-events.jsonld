      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Indigenous performing artists are developing skills, processes and frameworks rooted in culturally specific ways of working. During Mòshkamo: Indigenous Arts Festival, we are thrilled to offer Masterclasses with Indigenous artists from our season."
      }
    ],
