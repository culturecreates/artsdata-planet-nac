    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Bashir Lazhar  | Le retour à la scène du charismatique professeur |  25-27 fév 2027|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40432/tfcna2627_bashir_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Onde de choc à sa création en 2007, ce monologue à plusieurs voix signé Evelyne de la Chenelière continue de résonner dans l’espace collectif actuel, interrogeant notre système de valeurs et d’éducation. Sous la direction de Marie Brassard, Mani Soleymanlou revisite avec son propre bagage identitaire l’iconique rôle du professeur venu d’ailleurs pour nous offrir une vibrante leçon d’humanité. \n\nSurvivant d’une tragédie personnelle et politique, un homme d’origine algérienne remplace au pied levé une institutrice de sixième année qui s’est enlevée..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
