      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "About | Mòshkamo | Indigenous Arts Festival"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://cdn.nac-cna.ca/img/indigenoustheatre/moshkamo/moshkamo_meta_en.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Come celebrate the launch of Indigenous Theatre’s first season at Mòshkamo Indigenous Arts Festival! Our story begins with an all-Indigenous takeover of the National Arts Centre’s performance and public spaces on unceded Algonquin Anishinaabeg territory!\n\nIn ceremony with Elders from Kitigan Zibi, the name Mòshkamo was gifted to us in honour of the work we are presenting. Mòshkamo embodies the art of appearing out of water and invites others to bear witness to..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
