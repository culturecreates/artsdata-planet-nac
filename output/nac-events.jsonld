    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2024-12-12T16:27:00-05:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/video/vancouver-reconcilethis-2024"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "#ReconcileThis Vancouver"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&Agrave; Vancouver, Kelsey Wavey aborde son processus de r&eacute;appropriation et de partage de son don pour le chant. Avec sa chanson Give It Up / Give It Back, l&rsquo;artiste se rem&eacute;more les excuses du gouvernement relatives aux pensionnats autochtones et sa premi&egrave;re participation &agrave; une manifestation &agrave; l&rsquo;&acirc;ge de 15 ans. Dans la vid&eacute;o, Kelsey Wavey croise ses r&eacute;flexions personnelles avec une chanson engag&eacute;e sur la terre, la renaissance et le r&ocirc;le de l&rsquo;art dans la d&eacute;colonisation et la r&eacute;appropriation culturelle."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/ade619f71f85bd76",
    "@type": [
      "http://schema.org/VideoObject"
