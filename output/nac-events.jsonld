    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Story Behind the Song: A Women in Music Songwriter’s Circle hosted by Bif Naked"
      },
      {
        "@language": "fr",
        "@value": "L’histoire derrière la chanson : un cercle d’autrices-compositrices de Women in Music animé par Bif Naked"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Story Behind the Song: A Women in Music Songwriter’s Circle Presented as part of Capital Music Week and hosted by Canadian rock icon Bif Naked, Story Behind the Song brings together Kellylee Evans, Jessica Pearson, Emma Lamontagne and Vaan Thibz for an intimate songwriter’s circle exploring the stories and experiences behind their music. Hear the songs stripped back, discover what inspired them and get a rare look inside the creative process of some incredible women making music today. Presented by National Arts Centre and Women in Music Ottawa. 4 ticket limit per order."
      },
      {
        "@language": "fr",
        "@value": "L’histoire derrière la chanson : un cercle d’autrices-compositrices de Women in Music Présenté dans le cadre de la Semaine musicale de la capitale et animé par l’icône du rock canadien Bif Naked, L’histoire derrière la chanson réunit Kellylee Evans, Jessica Pearson, Emma Lamontagne et Vaan Thibz pour un cercle intime autour des chansons, des histoires et des expériences qui les ont inspirées. Découvrez leurs chansons dans leur plus simple expression, ce qui les a inspirées et les coulisses du processus créatif de femmes remarquables qui font vibrer la scène musicale d’aujourd’hui. Présenté par le Centre national des Arts et Women in Music Ottawa. Limite de 4 billets par commande."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Talk"
      }
    ]
  },
