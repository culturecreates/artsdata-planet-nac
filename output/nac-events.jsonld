    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une saison spectaculaire s’annonce à Ottawa avec des nouveautés et des incontournables de Broadway, dont trois premières mondiales et deux grands succès. Cette année encore, préparez-vous à des performances éblouissantes, des musiques inoubliables et des histoires marquantes."
      }
