    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Je comprends. Respect.   | Battle de hip-hop théâtral |   3- 5 déc 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40436/tfcna2627_jecomprends_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Il est permis de faire du bruit pour cet irrésistible spectacle hybride entre un véritable battle de hip-hop et le captivant récit autobiographique d’Etienne Lou, comédien et danseur prodige. Sans filtre, il dévoile son chaotique parcours de jeunesse pour percer le milieu de la danse urbaine. Mille dollars en prix, trois juges, un DJ, une foule en transe, du vrai, du faux, bref, du théâtre, mais avec beaucoup – beaucoup – de beat! \n\nDeux combats se déroulent sur la scène :..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
