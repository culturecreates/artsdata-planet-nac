    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Classic Albums Live est un projet regroupant de talentueux instrumentistes qui reprennent sur scène – note par note – les grands classiques de la musique. « Ce projet est un peu comme un récital, » souligne son fondateur, Craig Martin « ces albums ont marqué l’histoire et s’inscrivent dans la durée ».\n\nClassic Albums Live fait l’impasse sur les costumes et les imitations pour se concentrer exclusivement sur la musique. « Nous ne portons aucun déguisement ni artifice. Nous nous contentons..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/series/classic-albums-live"
      }
    ]
  },
