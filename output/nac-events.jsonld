  {
    "@id": "https://nac-cna.ca/fr/indigenoustheatre",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/indigenoustheatre"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Théâtre autochtone du CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/indigenoustheatre/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le pouvoir de nos contes · Une nouvelle saison incroyable s’annonce au Théâtre autochtone en 2026–2027!\n\nAu programme, Beautiful Scars, une comédie musicale rock inspirée de la vie de Tom Wilson, la pièce Waiting for Godot de Beckett revisitée en inuktitut, et The Comeback une œuvre où les cultures métisse et allochtone s’entrechoquent avec humour et sensibilité.\n\nS’ajoutent en coprésentation, The Diviners, un hommage vibrant à la culture michif, Pakuneu, la nouvelle œuvre saisissante de Soleil Launière, et Jordan, une aventure de superhéros pour petits et grands. En clôture de saison, place à Matriarchs Uprising, une célébration dansée au féminin.\n\nDes histoires qui touchent et inspirent!"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/indigenoustheatre"
      }
    ]
  },
