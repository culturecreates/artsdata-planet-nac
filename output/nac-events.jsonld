    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Musique pour un dimanche après-midi : Édition d’hiver  | avec des membres de l’Orchestre du CNA |   dim 21 fév 2027, 15 h 30|  Église presbytérienne St. Andrew's"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40411/9169_nac_naco_26_27_batch2_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\n\n\tDans le cadre de notre populaire série Musique pour un dimanche après-midi, nous vous proposons un concert intime dans la lumineuse et historique église presbytérienne St. Andrew’s d’Ottawa.\n\tPréparé par Sam Loeck, contrebasse solo de l’Orchestre du CNA, ce programme rend hommage à des compositeurs juifs réduits au silence dans l’Allemagne des années 1940.\n\n\nUne sélection de pièces d’Erich Wolfgang Korngold (dont les musiques de film ont marqué l’âge d’or d’Hollywood) met en valeur le talent du compositeur pour les..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
