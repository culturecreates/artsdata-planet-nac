    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Storgårds, Beethoven & Dvořák (Free Livestream) | and Élisabeth Pion's Debut |  Thu, Nov 5, 2026, 8:00 pm | Online"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42362/metaadtemplate_8_(1)__event_1024__event_1024__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know...\n\nThis program celebrates John Storgårds’s first program as Music Director of the NAC Orchestra!\nFrom a musical meditation on the universe to a symphony overflowing with tranquil melodies, this program offers countless moments of beauty and calm.\nBeethoven wrote that he composed to express “what I have in my heart”—a sentiment brought to life in his tender, soul-stirring music for piano and orchestra.\n\nFeel your breath expand, and your mind unwind with the dreamy lyricism of Beethoven’s Fourth Piano..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
