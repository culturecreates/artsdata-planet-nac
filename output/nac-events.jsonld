      {
        "@id": "https://nac-cna.ca/en/event/41636#2026-12-10T20:00:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41636/rounded_corner_design__large.png"
      }
    ],
