    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_western_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "From October 30 – November 3, the National Arts Centre Orchestra will continue its Canada 150 Tour in Victoria and Vancouver. The tour will celebrate the 150th anniversary of Confederation through music, by engaging with audiences, young audiences and young artists.\n\nThis is the first tour led by the NAC Orchestra’s highly acclaimed Music Director, Alexander Shelley, and will feature Calgary-based pianist, Jan Lisiecki."
      }
    ],
