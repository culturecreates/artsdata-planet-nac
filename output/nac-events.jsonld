    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for a conversation with the Royal Winnipeg Ballet's Artistic Director Christopher Stowell and Music Director Ming Luke, on Thursday, October 29 at 7 p.m. in the Peter A. Herrndorf Place."
      },
      {
        "@language": "fr",
        "@value": "Joignez-vous à nous pour une causerie avec le directeur artistique du Royal Winnipeg Ballet, Christopher Stowell, et le directeur musical, Ming Luke, le jeudi 29 octobre à 19 h à l’Espace Peter A. Herrndorf."
      }
