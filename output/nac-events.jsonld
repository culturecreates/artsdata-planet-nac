      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Théâtre anglais du CNA\n \n \n  | Apprendre et partager"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/assets/img/season2020/meta/englishtheatre_meta_image_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« Au cours des dernières années, un changement radical s’est opéré dans la façon qu’ont les Canadiens de voir le monde, et dans celle qu’ont nos artistes de le raconter. Les débats qui se déroulent autour des tables de cuisine partout au pays sont reflétés sur les scènes canadiennes, empreints d’intelligence, d’espièglerie et d’esprit.  »"
      }
    ],
