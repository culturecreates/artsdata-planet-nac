    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "SPHÈRE : Arctic Imagination | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/31973/sphere-card-arctic-imagination__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Arctic Imagination est une série de conférences à ne pas manquer, présentée par la Bibliothèque royale du Danemark et l’Orchestre du CNA, inspirée de la collaboration transatlantique, en 2018, des bibliothèques de Nuuk, Copenhague, Stockholm, Oslo et New York.\n\nCet événement ravivera moult discussions pressantes concernant la transformation de l’Arctique – qui voit sa glace disparaître – et les conséquences des changements climatiques sur la géopolitique mondiale et l’humanité en général.\n\nPrésenté dans le cadre du Festival SPHÈRE de l'Orchestre du CNA en septembre 2022."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
