    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40675/9169_nac_naco_26_27_batch1_14__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Pianist Marc-André Hamelin is celebrated around the world for his extraordinary virtuosity, musical imagination, and ability to bring both familiar masterpieces and rarely heard gems to life.\n\nIn this solo recital, Hamelin takes audiences on a journey through the expressive range of the piano, from the emotional intensity of Chopin’s dramatic Funeral March Sonata to the shimmering colours and evocative soundscapes of Debussy.\n\nThe evening also reveals Hamelin’s remarkable versatility, moving from introspective and poetic works to the dazzling energy of Earl..."
      }
    ],
