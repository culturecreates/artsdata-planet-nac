      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Dancing Queen: The Best of ABBA | with the NAC Orchestra | Jan 7 - 9, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40414/9169_nac_2627_pops_illustration_3840x2160_abba__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Sing along, dance in your seat, and have the time of your life as Rajaton fills Southam Hall with the electrifying sound of ABBA’s high-energy anthems!\n\nFor 30 years, Rajaton has blown audiences away with “an explosion of sound, light, dance, and sheer grooviness” (D.C. Theater Arts). Now’s your chance to experience that magic firsthand when the Finnish vocal group joins the NAC Orchestra for a symphonic pop spectacular featuring ABBA’s biggest hits—including “Dancing Queen,” “Mamma Mia,” and “Gimme, Gimme, Gimme.”"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
