      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Comeback | By Trish Cooper and Sam Vint | Nov 26 - Dec 5, 2026 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40386/comeback_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A co-production with The Citadel Theatre\n\nA surprise baby sends two very different families crashing together. Chaotic? Just a little. Hilarious? Absolutely!\n\nAdam is writing a play about his Métis family: lovingly loud and carrying generations of hurt. He hopes it will spark their comeback. Jesse fell for Adam and wants his family to like her. Her settler family is"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
