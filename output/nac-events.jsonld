    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Storgårds, Beethoven & Dvořák | and Élisabeth Pion's Debut | Nov 4 - 5, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40423/metaadtemplate_8_(1)__event_1024__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate with us after the concert!\n\nJoin us in the Canal Lobby following the November 4 performance for a special reception celebrating John Storgårds’s first concert as Music Director of the NAC Orchestra.\n\nMeet fellow music lovers, mingle with musicians, and raise a glass to the beginning of an exciting new chapter for the Orchestra!\n\n - - - - - - - -\n\nA few things to know...\n\n\n\tThis program celebrates John Storgårds’s first program as Music Director of the NAC Orchestra!\n\tFrom a musical meditation on the universe..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/event/42251",
    "http://ogp.me/ns/fb#app_id": [
