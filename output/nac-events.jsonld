    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Orchestre de Jazz d'Ottawa  | Coltrane 100 |  17-19 nov 2026|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41709/coltrane_100__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pour marquer un tournant historique dans l'histoire de la musique, l'Orchestre de Jazz d'Ottawa présente avec fierté une célébration du centenaire de la vie, de l'esprit et du génie inégalé de John Coltrane. Ce programme, interprété par 19 musiciens, mettra en vedette deux œuvres majeures : son chef-d'œuvre Africa/Brass et une interprétation émouvante pour big band de son chef-d’œuvre spirituel, A Love Supreme.  Rejoignez-nous pour un hommage vibrant, puissant et riche en histoire, dédié à l'un des plus grands architectes..."
      }
    ],
