    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Music for a Sunday Afternoon: Spring Edition | with members of the NAC Orchestra |  Sun, Apr 4, 2027, 3:30 pm | Carleton Dominion-Chalmers Centre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40410/9169_nac_naco_26_27_batch2_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know ... \n\n\n\tSink into some seriously relaxing weekend vibes as you experience intimate performances from some of your favourite NAC Orchestra musicians. \n\tSurrounded by the acoustic and architectural marvels of the Carleton Dominion-Chalmers Centre, you’ll feast on music of soaring romance and operatic lyricism. \n\n\nLudwig Spohr’s Nonet for strings and winds gives each instrument the chance to showcase its unique character in an emotional journey through serenity, shadowy mystery, and joyful dancing. \n\n“I consider it to be the best thing I have ever written,” Mozart said of his..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
