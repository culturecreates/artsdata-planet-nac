      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/40534/melissa-ouimet_crop-01635__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Le Projecteur is a distinctive professional development NAC program designed for Franco-Canadian musicians. This initiative focuses on enhancing the professional and artistic skills of Franco-Canadian performers.\n\nThe artistic residency specifically aims to improve their live performance and empower artists to refine their craft to help navigate the music industry with confidence. The program delves into various aspects of performance, including song arrangements, overall show direction, transitions between pieces, and the narratives artists wish to convey about their songs during their sets."
      }
    ],
