    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Paolo Fresu  | Improvvisi |   mer  4 nov 2026, 20 h 00|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42251/paolo_fresu__uri_caine_(@roberto_cifarelli)03__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec leur nouvel album, Uri Caine et Paolo Fresu font revivre une histoire musicale commune qui a pris une place importante au fil des ans. Habituellement, lorsque deux musiciens se lancent dans l’enregistrement d’une nouvelle œuvre, ils entrent en studio avec une idée bien arrêtée de ce qu’ils vont jouer. Mais cette fois, Uri Caine et Paolo Fresu sont arrivés les mains vides, avec pour seule certitude que le jazz est, par essence, une musique de liberté totale. Ils ont..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/fr/event/40439",
    "http://ogp.me/ns/fb#app_id": [
      {
