        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/indigenoustheatre"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NAC Indigenous Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/indigenoustheatre/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Our Stories are Medicine  · Join us for an incredible 2026-27 season of Indigenous Theatre!\n\nExperience Tom Wilson’s autobiographical rock musical Beautiful Scars, Samuel Beckett’s Waiting for Godot - Inuktitut, and The Comeback—where Métis and settler cultures collide with hilarity and heart.\n\nWe co-present The Diviners celebrating Michif culture, Soleil Launière’s powerful new work Pakuneu, and Jordan—a superhero tale for all ages. The season closes with Matriarchs Uprising, a femme-centered dance celebration.\n\nStories that move and inspire!"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/indigenoustheatre"
      }
    ]
  },
