    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Masters in the Hall  | Musique celtique pour Noël |   mar 15 déc 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42152/screenshot_2026-09-18_152547__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le champion nord-américain de violon irlandais Kyle Burghout s'associe au flûtiste Justin Thériault et à la harpiste celtique Susan Toman. Ces trois artistes exceptionnels se produiront au CNA pour interpréter un répertoire de musique celtique traditionnelle et contemporaine d'Irlande, d'Écosse et du Canada. Le concert mettra en vedette des morceaux spécialement sélectionnés pour la période des fêtes, accompagnés d'anecdotes sur l'histoire des airs et des récits tirés des voyages du trio. Il s'agit d'une occasion rare pour le public d'entendre..."
      }
    ],
