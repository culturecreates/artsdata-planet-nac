    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Musique pour un dimanche après-midi : Édition d’automne (Webdiffusion gratuite)  | Avec John Storgårds et des membres de l’Orchestre du CNA |   dim  8 nov 2026, 15 h 30|  En ligne"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42365/9169_nac_naco_26_27_batch1_12__event_1024__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\nPassez un week-end des plus relaxants avec ce concert intime mettant en vedette certains de vos musiciennes et musiciens préférés de l’OCNA.\nAu cœur des merveilles acoustiques et architecturales du Centre Carleton Dominion-Chalmers, régalez-vous d’un programme d’orchestre à cordes couvrant trois siècles de musique.\nNotre directeur musical John Storgårds sera sur scène, pas pour diriger, mais pour jouer du violon!\n\nVoyagez dans le temps avec notre directeur musical John Storgårds et les cordes de l’Orchestre du CNA, qui exploreront trois siècles..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
