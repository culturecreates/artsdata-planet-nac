    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Cambodian Rock Band By Lauren Yee featuring songs by Dengue Fever"
      },
      {
        "@language": "fr",
        "@value": "Cambodian Rock Band De Lauren Yee, avec les chansons de Dengue Fever"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Cambodian Rock Band is a vibrant story about familial love, resilience, and music that has continued to rock long after history tried to silence it."
      },
      {
        "@language": "fr",
        "@value": "Cambodian Rock Band, c’est une histoire vibrante sur l’amour familial, sur la résilience et sur la musique, qui continue de résonner bien après que l’histoire n’ait tenté de la faire taire."
      }
    ]
