      {
        "@id": "https://nac-cna.ca/fr/video/le-projecteur-jacques-surette-et-gaelle-entrevue"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Projecteur : Artist en résidence Jacques Surette "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Projecteur est un programme offert par le Centre national des Arts qui vise &agrave; perfectionner les comp&eacute;tences professionnelles et artistiques des interpr&egrave;tes francophones au Canada.&nbsp; Jacques Surette, auteur-compositeur-interpr&egrave;te acadien, a &eacute;t&eacute; convi&eacute; &agrave; une r&eacute;sidence de deux jours avec l&rsquo;artiste multidisciplinaire prim&eacute;e Ga&euml;le pour travailler ensemble sur diff&eacute;rents aspects de l&rsquo;interpr&eacute;tation comme les arrangements, la direction g&eacute;n&eacute;rale du spectacle, les transitions entre les morceaux et les messages transmis par les chansons."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/f9b940edad5ad3d8",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/40896/2026-03-17-projecteur-jacques-surette-performance-thumbnail-08__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-16T16:34:00-04:00"
