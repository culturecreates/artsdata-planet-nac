    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Et danse la terre | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/29556/dtl-christine-friday-credit-gerry-gooderham_web__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans le cadre du projet Et danse la terre, le Théâtre autochtone a invité des artistes d’un océan à l’autre, à l’autre, à concevoir de brèves œuvres numériques s’inspirant du territoire. Ces artistes nous ont offert de magnifiques explorations, sincères et passionnées, de leur relation à la terre et au moment présent. \n\nVoici les dix-huit magnifiques créations des quatre coins de l’île de la Tortue et au-delà. Elles sont nées chacune dans sa communauté. Leurs racines sont celles des premiers peuples. \n\nBienvenue à Et danse la terre. "
      }
    ],
