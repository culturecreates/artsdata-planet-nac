    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Pink Martini  |   ven 19 mar 2027, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41650/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec son irrésistible répertoire de chansons intemporelles venues des quatre coins du monde, Pink Martini fait voyager depuis plus de 30 ans des publics de tous âges sur les six continents grâce à un univers musical cosmopolite qui transcende les genres et les frontières. L’inimitable Storm Large mène Pink Martini avec panache dans une célébration de pop orchestrale rétro et de glamour hollywoodien, plus flamboyante que jamais. Embarquez pour une fête musicale planétaire menée tambour battant par ce mythique « petit orchestre »! "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
