    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Théâtre anglais du CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/englishtheatre/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Reculer pour mieux avancer · Le théâtre est ma machine à voyager dans le temps préférée : on entre dans une salle sombre en 2026 et soudainement, on se retrouve en 1609, dans le Toronto des années 1950, sur les berges de la rivière Rouge dans les années 1940 ou dans le Phnom Penh des années 1970; dans un texte ancien, dans la cuisine d’une famille, dans une salle de répétition, dans la nostalgie d’une terre natale ou dans un livre d’histoire qu’on traînait avec soi sans le savoir. Et quand les lumières se rallument, un clin d’œil et nous voilà de retour dans notre propre vie, où rien n’est plus pareil. Voilà ce que c’est que de RECULER POUR MIEUX AVANCER."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/englishtheatre"
      }
    ]
  },
