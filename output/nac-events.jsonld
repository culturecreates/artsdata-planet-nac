    "@id": "https://nac-cna.ca/genid/a0ec45a02b2cc350",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/41303/nina-lee-aquino_nac-creators-retreat__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-21T09:00:00-04:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/super-duper-mega-retreat"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "NAC Creators' Intensive aka The Super Duper Mega Retreat"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In summer 2025, NAC English Theatre and the NAC National Creation Fund took over the Banff Centre for a two-week creative intensive&mdash;four large-scale musical theatre/dance projects, one shared sandbox, and two days of showings&nbsp;to cap it all off.&nbsp; More than 90 artists, with four theatre company partners, came together to push&#8239;big&#8239;work forward&mdash;building, breaking, testing, reshaping&mdash;making space for ambition, imagination, and risk.&nbsp;Most importantly, the retreat gave creators the rarest thing in our industry: time. Time to go deeper, get bolder, and let the work reveal what it wants to become.&nbsp; We give you:&#8239;The&nbsp;NAC&nbsp;Creators Intensive&nbsp;aka&#8239;THE&nbsp;SUPER DUPER&nbsp;MEGA RETREAT.&nbsp;"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/e67f4161f7f80f64",
    "@type": [
