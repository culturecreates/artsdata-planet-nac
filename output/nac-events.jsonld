    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Handel's Messiah"
      },
      {
        "@language": "fr",
        "@value": "Le Messie de Haendel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Hallelujah! A beloved holiday tradition returns to Southam Hall: Handel’s Messiah, a miraculous meditation on faith, hope, and the power of redemption."
      },
      {
        "@language": "fr",
        "@value": "Alléluia! Un grand classique des fêtes est de retour à la Salle Southam : le Messie de Haendel, une méditation miraculeuse sur la foi, l’espoir et le pouvoir de la rédemption."
      }
    ]
