      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/canada150tour/atlantic"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Provinces de l’Atlantique  | Tournée Canada 150 de l’Orchestre du cna Canada 150"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_atlantic_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Du 25 avril au 7 mai, l’Orchestre du Centre national des Arts était au Canada atlantique dans le cadre de sa Tournée Canada 150. Des arrêts étaient prévus à St. John’s (Terre-Neuve), Moncton, Charlottetown, Eskasoni, Saint John (Nouveau-Brunswick) et Halifax. La tournée est une célébration en musique du 150e anniversaire de la Confédération à l’intention des mélomanes de tous âges et des jeunes artistes.\n\nIl s’agit de la première tournée de l’Orchestre du CNA sous la conduite de son renommé directeur musical, Alexander Shelley. Elle mettra en vedette le Canadien James Ehnes, violoniste de renommée mondiale couronné aux GRAMMY® et lauréat de dix JUNO."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/canada150tour/atlantic"
      }
    ]
  },
