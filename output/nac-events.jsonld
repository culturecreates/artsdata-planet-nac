    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The NAC’s offering of ASL (American Sign Language) and LSQ (Langue des signes québécoise) interpreted performances provide access for audiences who are d/Deaf or hard of hearing. Professional interpreters are located near the stage so that patrons can easily follow the interpretation and the action. These performances have been curated with our audience needs in mind and are part of our efforts to better serve the community.   "
      }
