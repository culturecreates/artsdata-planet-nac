    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "2par2 Ebnflōh Dance Company"
      },
      {
        "@language": "fr",
        "@value": "2par2 Compagnie de danse Ebnflōh"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In 2par2, choreographer and major player on the Québec Hip Hop dance scene Alexandra ‘Spicey’ Landé places relationships, in all their contradictions, at the centre of her artistic explorations. Conceived as a play of dualities and polarities, the work embraces an intimate and demanding narrative that probes the transformative power of human connections"
      },
      {
        "@language": "fr",
        "@value": "Figure majeure de la scène hip-hop au Québec, la chorégraphe Alexandra « Spicey » Landé s’intéresse dans 2par2 aux relations humaines et leurs contradictions, qu’elle place au cœur de sa démarche artistique. Conçue comme un jeu de dualités et de polarités, l’œuvre offre un récit intime et exigeant qui interroge le pouvoir transformateur de nos relations."
      }
    ]
  },
