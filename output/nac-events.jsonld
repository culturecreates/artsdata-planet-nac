    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41963/rounded_corner_design_(3)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Axé WorldFest is proud to partner with the National Arts Centre in celebrating Latin American Heritage Month with the return of the acclaimed Brazilian ensemble Passarim, featuring singer-songwriter Tika for her Canadian debut. \n\nFollowing a sold-out performance at the National Arts Centre's Azrieli Studio in 2024, Passarim returns to Ottawa as part of Latin Heritage Month 2026, this time welcoming Tika, one of the group's founders and original lead vocalist—for her first-ever performance in Ottawa \n\nAs the world approaches the 100th anniversary of..."
      }
    ],
