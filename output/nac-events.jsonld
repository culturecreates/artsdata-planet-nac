      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/video/series/canada-moves-canada-en-mouvement"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Canada en mouvement | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/26982/canada-in-movement-demo-sioned-watkins__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Créez votre propre chorégraphie pour la fête du Canada grâce à notre « trousse de mouvements » ludique, pour tous niveaux d’aptitudes. Les vidéos ci-dessous incluent des gestes pour chaque lettre du mot C-A-N-A-D-A à enchaîner pour ainsi créer votre solo, duo ou danse en groupe.\n\nTéléchargez notre trame sonore, enregistrez votre prestation et partagez-la sur vos médias sociaux! #CanadaEnMouvement #FêteduCanada​.\n\nCOMMENT PARTICIPER!\n\nÉtape 1 : Téléchargez la musique.\n\nÉtape 2 : Consultez nos deux trousses de mouvements, puis choisissez votre option favorite pour chaque lettre du mot CANADA.\n\nÉtape 3 : Enregistrez votre chorégraphie. Visionnez la vidéo de démonstration ci-dessous pour vous inspirer!\n\nÉtape 4 : Partagez votre vidéo sur les médias sociaux en utilisant les mots-clics #CanadaEnMouvement #FêteduCanada. Assurez-vous que votre publication soit publique pour que Danse CNA puisse la voir!"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/video/series/canada-moves-canada-en-mouvement"
      }
    ]
  },
  {
