      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41722#2027-01-30T19:30:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41722/rounded_corner_design__large.png"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://nac-cna.ca/genid/41d5db2caca664f0"
      }
    ],
    "http://schema.org/location": [
