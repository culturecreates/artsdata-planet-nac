    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/canada150tour/education"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Activités éducatives | Tournée Canada 150 de l’Orchestre du cna Canada 150"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_education_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une célébration des artistes, éducateurs et jeunes espoirs qui façonneront l’avenir\n\nÀ l’occasion du 150e anniversaire du Canada, l’Orchestre du Centre national des Arts est ravi de collaborer avec de nombreuses organisations partenaires des quatre coins du pays pour offrir 150 activités éducatives et culturelles sous le thème Le Canada en scène. Une série de concerts — musique symphonique, chorale ou de chambre, prestations conjointes, etc. —, de discussions, d’ateliers et de classes de maître nous permettrons de nouer des liens avec des mélomanes de tous âges. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/canada150tour/education"
      }
    ]
  },
