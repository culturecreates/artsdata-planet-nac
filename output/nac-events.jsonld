    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "BON Chat: Between Two Worlds | A free pre-show conversation exploring migration, identity, and belonging (in French) |  Sat, Oct 10, 2026, 6:00 pm | Salon"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
