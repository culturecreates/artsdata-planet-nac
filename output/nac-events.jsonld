    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "New Work | National Creation Fund"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-creationfund.s3.amazonaws.com/42214/mayday_creationfund_header-a__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Could this be a mundane reflection on the cycle of life? On the infinite expansion of the universe and the agony of the stars. On humanity’s great march and the decline of civilizations. On the missing link and my own insignificance. On life before life and life after death. On black holes, on nothingness. On conquests, revolutions, on battles being fought and those yet to come. On the survival instinct and self-destruction. On the majesty of the clitoris. Could this be simply an attempt..."
      }
    ],
