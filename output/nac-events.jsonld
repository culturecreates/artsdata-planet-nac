      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les panais, version sucrée : Chefs en résidence au CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire de Vancouver, en Colombie-Britannique, Celeste&#8239;Mah a &eacute;t&eacute; couronn&eacute;e meilleure cheffe p&acirc;tissi&egrave;re au Canada en 2019. Elle joue avec les saveurs et les textures pour cr&eacute;er des desserts aux associations surprenantes.&nbsp;&nbsp; Celeste Mah a &eacute;t&eacute; cheffe en r&eacute;sidence de mars &agrave; mai&#8239;2025 aux c&ocirc;t&eacute;s du chef Ross&#8239;Larkin, son partenaire &agrave; la ville comme en cuisine. Ensemble, le couple a ouvert son propre restaurant, le Portage, dans le centre-ville historique de St. John&rsquo;s, &agrave; Terre-Neuve.&nbsp; Le mandat du CNA est de cultiver et d&rsquo;appuyer une vaste gamme d&rsquo;artistes de la sc&egrave;ne de tout le pays. Formidable vitrine gastronomique, le programme de Chefs en r&eacute;sidence du restaurant 1&#8239;Elgin permet aux artistes culinaires de talent du Canada de partager leur savoir culinaire et leur amour pour les produits r&eacute;gionaux.&nbsp;"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/48c1f07e18d0cbb7",
