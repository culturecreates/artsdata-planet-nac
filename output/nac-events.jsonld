    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "“Partis pour veiller tard” by Mélissa Ouimet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "M&eacute;lissa Ouimet, a Franco-Ontarian singer-songwriter, sets stages across Quebec and French-speaking Canada alight with her infectious energy and undeniable talent. Her sound blends elements of pop, rock, neo-soul, and R&amp;B. Genuine and moving, she sings from the heart. This is a live performance by M&eacute;lissa Ouimet performing &ldquo;Partis pour veiller tard&rdquo; from her newly released album Mille raisons. M&eacute;lissa participated in the professional development NAC program, Le Projecteur, designed for Franco-Canadian musicians. The performance was recorded live at the Fourth Stage at the National Arts Centre on Sept. 17, 2025."
      }
    ]
