    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41922#2026-11-25T19:30:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41922/sheilalucilewallace__large.jpg"
      }
    ],
    "http://schema.org/location": [
      {
