    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This season features an exciting mix of groundbreaking new musicals and beloved Broadway blockbusters, including three premiere engagements and two record-breaking hits, offering Ottawa audiences a year filled with show-stopping performances, unforgettable music, and world-class storytelling."
      }
