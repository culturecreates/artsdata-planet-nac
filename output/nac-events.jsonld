    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "When the Bleeding Stops  | Lovísa Ósk Gunnarsdóttir |  28-29 avr 2027|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40369/photo_owen_fiene-32_copy_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une révolution de joie\n\nPuisant dans son cheminement personnel de guérison et de découverte, Lovísa Ósk Gunnarsdóttir propose une écriture chorégraphique qui célèbre le pouvoir émancipateur de la danse. Dans cette création saluée par la critique, l’interprète et chorégraphe islandaise élève et renouvelle la conversation autour de la ménopause dans toute sa complexité.\n\nAvec humour, sincérité et éclat, When the Bleeding Stops plonge le public dans un univers où paroles et mouvements se rencontrent. Grâce à l’implication de femmes de la communauté en amont..."
      }
    ],
