        "@language": "en-ca",
        "@value": "https://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_landing.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "To mark the 150th anniversary of Canadian Confederation, the National Arts Centre Orchestra will undertake a cross-Canada tour during the spring and fall of 2017. \n\nLed by Music Director Alexander Shelley, the Canada 150 Tour will include over a dozen major concert performances and 150 education and outreach programs in communities across the country. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
