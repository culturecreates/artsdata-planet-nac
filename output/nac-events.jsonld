    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "NAC Dance Teaching Artist Siôned Watkins invites you to take a moment out of your busy day to stretch and relax with the goal of releasing the tension in your neck and back muscles; often caused by the stress and ergonomics of the makeshift office spaces at home."
