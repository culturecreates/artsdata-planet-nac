    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41298/250804_cirqueeloize_idevolution_show-124__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In iD – Evolution, the city becomes a stage and a character in itself. Acrobats defy gravity, dancers explode into striking urban movements, and every space is transformed into a playground for the imagination.  \n\nTrampoline, aerial hoop, trial bike, breakdancing, and many other disciplines intertwine in an electrifying ballet where every jump, every movement, and every note of music tells a story.  \n\niD – Evolution explores identity and encounter in a world where bodies speak, clash, and respond to each other. It..."
      }
    ],
