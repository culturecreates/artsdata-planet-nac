    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Music"
      },
      {
        "@language": "en",
        "@value": "Singer/Songwriter"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/42097#2027-03-20T20:00:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/42097/tommyemmanuel-ottawa-imageonly-3840x2160-credit-to-luiciano-viti__large.jpg"
      }
    ],
