    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "SLAM and Creative Writing: Texts in 3D with YAO | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/29520/map-yao-3-sauter__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this four-part series, YAO shares creative ways for everyone to activate their imagination, remove blocks and reduce anxiety when facing a blank page, and to craft and structure their works. These techniques can be used by anyone who wants to try out writing, and for a variety of genres (fiction, plays, poetry, film scripts, essays, and other non-fiction works).  \n\nYAO is an award-winning performer and has been leading workshops for students and professional artists for over 10 years now. In 2018, he received the Ontario Arts Foundation Artist Educator Award. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
