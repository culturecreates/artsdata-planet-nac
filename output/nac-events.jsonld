    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Je comprends. Respect. A theatrical hip-hop battle"
      },
      {
        "@language": "fr",
        "@value": "Je comprends. Respect. Battle de hip-hop théâtral"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An irresistible hybrid between an authentic hip hop battle and Etienne Lou’s life story. The brilliant actor and dancer humorously and candidly reveals his chaotic youth. A thousand dollars, three judges, an entranced crowd, truth, lies… in a word, theatre—with lots of beat!"
      },
      {
        "@language": "fr",
        "@value": "Un irrésistible hybride entre un véritable battle de hip-hop et le récit autobiographique d’Etienne Lou. Le comédien et danseur prodige dévoile avec humour et sans filtre son chaotique parcours de jeunesse. Mille dollars, trois juges, une foule en transe, du vrai, du faux, bref, du théâtre... avec beaucoup de beat!"
      }
    ]
  },
