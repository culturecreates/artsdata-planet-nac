    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Unpardoned and unstoppable: Director Cherissa Richards on Black entrepreneur Viola Desmond’s impact"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this video, Rose-Ingrid Benjamin, NAC Senior Engagement Strategist, Community &amp; Partnerships chats with artist Cherissa Richards, Director of Controlled Damage by Andrea Scott. In this discussion, Cherissa and Rose-Ingrid talk about Cherissa&#39;s history in theatre, her experiences as an artist and the importance of Black women in positions in leadership. Learn more about the play Controlled Damage in the program notes."
      }
    ]
  },
  {
