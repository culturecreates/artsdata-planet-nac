    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Leaving Home  | De David French |  19-27 mar 2027|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40377/andrew_musselman_and_lou_campbell_barry_mccluskey__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une production du Matchstick Theatre\n \n\nTel père, quels fils?\n\nFaites connaissance avec les Mercer, une famille originaire de Terre-Neuve, maintenant établie à Toronto et qui peine à se redéfinir et à s’entendre. Nous sommes en 1950. Bill, 17 ans, est à la veille d’un mariage obligé. C’est alors qu’éclatent les tensions entre Bill, ses parents Jacob et Mary, et son frère Ben. Ce dernier se braque contre les attentes démesurées et la cruauté de son père tout en étant en quête de..."
      }
    ],
