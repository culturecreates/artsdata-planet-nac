    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Matinées scolaires : Flots, tout ce qui brille voit  | \n\n  2- 4 jun 2027"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40434/tfcna2627_flots_1920x1080.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Est-ce qu’on peut mettre toute la mer dans une bouteille? Est-ce qu’on peut y enfermer des odeurs aussi? L’homme-qui-parle et L’homme-qui-chante vont réussir l’impossible : créer avec des objets du quotidien et quelques instruments un parfait monde marin..."
      }
    ],
