        "@id": "https://nac-cna.ca/en/event/41222#2026-11-28T20:00:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41222/web_resize_(1)__large.png"
      }
    ],
