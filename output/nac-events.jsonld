    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Canadian violinist James Ehnes joins the NAC Orchestra and a rotating cast of soloists in Bach’s Brandenburg Concertos— music of exhilarating joy, awe, and wonder."
      },
      {
        "@language": "fr",
        "@value": "Le violoniste canadien James Ehnes se joint à l’Orchestre du CNA et à son enfilade de solistes dans les Concertos brandebourgeois de Bach, source inépuisable de joie et d’émerveillement."
      }
    ]
