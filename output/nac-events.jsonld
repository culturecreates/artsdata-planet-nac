    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/41062/20260305-fb-chef-residency-steph-baryluk-thumb-web-no-icon__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-04-07T08:33:00-04:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/1elgin-resident-chefs-2026-steph-baryluk"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "From tradition to table: Inside an Indigenous chef’s creative process"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this exclusive look inside the kitchen, 1 Elgin Resident Chef Steph Baryluk shares what drives her creativity, the meaning behind key ingredients, and how Indigenous cuisine continues to evolve today. Join us as we celebrate culture, storytelling, and a unique culinary journey."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/d350266cd6072d3f",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/41047/25-05-06_philippe_boutin_ludovic_dsc03946__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-30T10:55:00-04:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/fonds-creation-entrevue-philippe-boutin-blingbling"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "A space of freedom for artistic creation"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&ldquo;For the first time, we have a space of freedom, a&nbsp;space for creation&nbsp;where we can bring fantasies to life and see an idea through to the end.&rdquo; &mdash; Philippe Boutin,&#8239;The Rise of the&nbsp;BlingBling&nbsp;&ndash; Le diptyque&nbsp; In this interview, Philippe Boutin talks about The Rise of the BlingBling and reflects on the creative process behind the piece, which was collaboratively devised by everyone involved. He also highlights the crucial role that the National Arts Centre&rsquo;s National Creation Fund played in fully bringing his artistic vision and ambitions to life.&nbsp; The Rise of the BlingBling is one of more than 115&nbsp;works supported by the Fund, and it was presented at the NAC as part of French Theatre&rsquo;s 2024&ndash;2025 season.&nbsp; The Fund empowers Canadian artists to embrace creative risks, explore new forms and make their most ambitious dreams a reality, resulting in innovative performances that are enjoyed by audiences across Canada and abroad.&nbsp; The National Creation Fund is powered by philanthropy. Thank you to our donors for making it possible."
      }
    ]
  },
