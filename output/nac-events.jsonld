    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Classic Albums Live : Fleetwood Mac  | Rumours |   sam 30 jan 2027, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41892/fm_band_3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Paru le 4 février 1977 sous l’étiquette Warner Bros. Records, Rumours est le onzième album studio de Fleetwood Mac, groupe de rock américano-britannique. Enregistré dans un contexte particulièrement mouvementé, alors que les membres du groupe traversent des ruptures amoureuses et composent avec une consommation excessive de drogues, l’album porte l’empreinte de ces tensions, qui façonneront sa direction musicale et ses paroles.\n\nAvec l’ambition de prolonger le succès de leur dixième album studio, Fleetwood Mac (1975), le groupe poursuit dans une veine..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
