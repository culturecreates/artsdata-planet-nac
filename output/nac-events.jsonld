    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stravinsky Stories Canada’s Royal Winnipeg Ballet"
      },
      {
        "@language": "fr",
        "@value": "Soirée Stravinsky Royal Winnipeg Ballet du Canada"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "In this special evening, Stravinsky’s compositions will be brought to life on stage in two one-act ballets: The Fairy’s Kiss, composed in 1928 for Les Ballets de Madame Ida Rubinstein and Firebird, composed in 1910 for Diaghilev's Les Ballets Russes."
      },
      {
        "@language": "fr",
        "@value": "Ce programme est une célébration vibrante et flamboyante de l’audace et de la magie de Stravinsky. Ses compositions résonneront au cœur de deux ballets : Le Baiser de la fée, composé en 1928 pour les Ballets de Madame Ida Rubinstein et L’Oiseau de feu, créé en 1910 pour les Ballets russes de Diaghilev."
      }
    ]
  },
