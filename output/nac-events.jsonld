    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Disney : L’Étrange Noël de monsieur Jack de Tim Burton, ciné-concert  | avec l’Orchestre du CNA |  10-12 déc 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40427/hero_nightmare-before-christmas_the_ih_movies-anywhere_2560x1440_key-image_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Présenté en version originale anglaise avec sous-titres en français.\n\nVeuillez noter que les billets Moinsde30 et TMR sont en nombre limité pour ces représentations.\n\nL’Orchestre du CNA présente Disney : L’Étrange Noël de monsieur Jack de Tim Burton en ciné-concert, une projection de ce classique des fêtes sur grand écran accompagnée par la trame sonore du compositeur primé aux Grammy Awards Danny Elfman, interprétée en direct dans toute sa splendeur symphonique.\n\nLas de faire peur aux gens année après année, Jack Skellington, le roi..."
      }
    ],
