    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Arts Vivants est le pôle jeunesse, écoles et familles du Centre national des Arts. Ici, le théâtre, la danse et la musique prennent vie! Nous vous invitons à découvrir tout ce que nous offrons en ligne et en personne : ateliers scolaires, spectacles destinés aux familles et aux écoles, activités de perfectionnement professionnelles, ressources pour pédagogues et artistes, et plus encore. Nous sommes ravis que vous soyez ici. Entrez en scène!</p>"
      }
    ],
