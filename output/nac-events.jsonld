    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Could you put the whole ocean in a bottle? Could you capture smells in there too? The Talking Man and the Singing Man will achieve the impossible: using everyday objects and a few instruments, they will build a perfect underwater world where we can gather, in small schools of dreaming fish, like..."
      }
