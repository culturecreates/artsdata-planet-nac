    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "l’Orchestre de Jazz d’Ottawa | Série la Programmation régionale"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/41748/series-header-ojo-2026__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à l’Orchestre de Jazz d’Ottawa pour célébrer ses 20 ans en grande pompe! Cette saison marquante s’annonce comme la plus exaltante de l’OJO, avec six concerts uniques. Au programme : une soirée intime de chansons classiques françaises et québécoises, et cinq concerts mettant en valeur l’incroyable polyvalence, la puissance et la passion du big band, avec des hommages aux légendes du jazz, une double réinterprétation de Casse-Noisette et des versions inédites de grands tubes rock et pop. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
