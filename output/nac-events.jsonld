    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Perfectionnement professionnel"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.nac-cna.ca/img/professional-development/meta/profedv-meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "<p>Le Centre national des Arts propose un large éventail de programmes de perfectionnement professionnel, dont des stages, du mentorat et des programmes intensifs. Les programmes sont destinés à des artistes et des personnes travaillant dans les domaines de la production, la conception, la technique et l’administration en début ou en milieu de carrière, de partout au Canada, qui souhaitent élargir leur réseau professionnel, accéder à des rôles ou à des projets plus ambitieux ou de plus grande envergure, et diversifier, approfondir ou améliorer leurs pratiques en arts ou en leadership.</p>"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
