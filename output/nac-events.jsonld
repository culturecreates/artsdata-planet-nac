        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/canada150tour/education"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Education & Outreach | NAC Orchestra Canada 150 tour"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_education_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrating the artists, educators and youth who will shape our future\n\nAs we celebrate our country’s 150th anniversary, Canada’s National Arts Centre Orchestra is pleased to partner with many organizations across the country to bring to life the theme of this tour – Canada is our Stage - through 150 education and engagement events. We will connect with music lovers of all ages through collaborative performances, meaningful discussions, chamber and choir performances, workshops and masterclasses. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/canada150tour/education"
      }
    ]
  },
