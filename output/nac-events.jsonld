    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/619/theatre-2013-003a-2__hero_xlarge__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Théâtre Babs Asper est le deuxième plus grand espace de représentation au CNA, et la salle principale pour les productions de théâtre et de danse contemporaine au CNA. La scène peut être configurée pour une scène avec proscenium ou une scène élisabéthaine. La conception du système technique du Théâtre rend ce lieu idéal pour tous les genres de concerts de musique – des ensembles intimes de musique de chambre au jazz, en passant par le rock et la pop."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/venue/theatre/rent"
      }
    ]
  },
