    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Storgårds, Beethoven & Tetzlaff With the NAC Orchestra"
      },
      {
        "@language": "fr",
        "@value": "Storgårds, Beethoven et Tetzlaff Avec l'Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From the heart-racing romance of Beethoven to the nostalgia and melancholy of Elgar, experience music that journeys between bold heroism and brooding interior drama."
      },
      {
        "@language": "fr",
        "@value": "De la nostalgie mélancolique d’Elgar au romantisme fougueux de Beethoven, plongez dans un concert où se mêlent actes d’héroïsme et ruminations intimes."
      }
    ]
