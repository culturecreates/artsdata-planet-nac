      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/40994/theatreworks_-_thumbnail_-_lionel1_-_logo__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Are you an educator, or do you know someone who is? This video series is part of Theatre Works, an Arts Alive educational resource that celebrates the people who bring Canadian theatre to life. \n\nCreated in collaboration with NAC English Theatre, French Theatre, and Indigenous Theatre, each installment introduces elementary and secondary school learners to the wide range of professions and often unexpected pathways that shape the industry.\n\nVisit the full Theatre Works resource and browse more free learning materials in the Arts Alive resource library."
      }
    ],
