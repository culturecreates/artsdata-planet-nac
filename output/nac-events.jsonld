        "@id": "https://nac-cna.ca/en/video/acte-de-sororite-et-de-bienveillance-safia-nolin-surveillee-et-punie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Act of sisterhood and benevolence"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On World Mental Health Day, Safia Nolin and Debbie Lynch-White from the show Surveill&eacute;e et punie&nbsp;discuss hatred, pride, and the art of listening.&nbsp;"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/7c4871c39f64e325",
