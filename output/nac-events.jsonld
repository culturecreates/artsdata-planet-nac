    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Rankin Family |  Wed, Mar 24, 2027, 7:30 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42519/cooked-photography-rankinfamily-oct-retouched-sept-2026-9__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Roots\n\nThe Rankin Family hail from Mabou, a small coastal community nestled along the highlands of Cape Breton Island, Nova Scotia — a place where music is woven into daily life as naturally as the tides. Growing up in a family of twelve children, the Rankins played for neighbours at local ceilidhs, weddings, and dances from as far back as the 1970s. Music was never a career plan. It was simply what the family did.\n\nWhat set them apart wasn't just..."
      }
    ],
