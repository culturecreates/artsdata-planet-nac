    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Hailed as “one of the best acoustic guitarists in the world” by NPR’s World Cafe, Tommy Emmanuel got his start at the age of six, when he first began touring his native Australia with his family’s band. As a teenager, he earned a reputation as a highly sought after sideman and session player, and by his early twenties, Emmanuel was playing on chart-topping hits and performing with acts like Air Supply and Men at Work. Inspired in part by his..."
      }
    ],
