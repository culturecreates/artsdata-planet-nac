    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Pink Martini"
      },
      {
        "@language": "fr",
        "@value": "Pink Martini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Featuring an irresistible mix of timeless songs from all corners of the world, Pink Martini’s mission of multicultural musical connection continues to charm audiences of all ages after more than three decades of bringing its genre- and border-defying musical adventure to fans on six continents. With the inimitable Storm Large commanding the stage on lead vocals, Pink Martini’s mélange of classic big band pop and Hollywood glamour is always in fashion. Don’t miss the nonstop global party from our “little orchestra”!"
      },
      {
        "@language": "fr",
        "@value": "Avec son irrésistible répertoire de chansons intemporelles venues des quatre coins du monde, Pink Martini fait voyager depuis plus de 30 ans des publics de tous âges sur les six continents grâce à un univers musical cosmopolite qui transcende les genres et les frontières. L’inimitable Storm Large mène Pink Martini avec panache dans une célébration de pop orchestrale rétro et de glamour hollywoodien, plus flamboyante que jamais. Embarquez pour une fête musicale planétaire menée tambour battant par ce mythique « petit orchestre »!"
      }
    ]
  },
