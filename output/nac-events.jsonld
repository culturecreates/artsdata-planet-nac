    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/26847/republic_of_inclusion___morning_session_5-11_screenshot__meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Cycle is a trilogy of two-year research initiatives developed by Associate Artistic Director Sarah Garton Stanley in partnership with artists and leaders from across the country. Our goal with each in-depth investigation is to gather practitioners around big ideas, and in theatrical terms engage with the concerns of our contemporary society.\n\nOur areas of focus: \n\n\n\tClimate Change (2019-2020)\n\tDeaf, disability, Mad arts and Inclusion (2016-2017)\n\tIndigenous Performance (2014-2015)"
      }
    ],
