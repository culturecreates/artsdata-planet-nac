      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/40783#2026-10-08T19:30:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/40783/untitled_design_(1)__large.png"
      }
    ],
    "http://schema.org/organizer": [
