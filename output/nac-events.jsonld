      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_central_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In June, the National Arts Centre Orchestra continued its cross-Canada tour, performing Life Reflected in Toronto as part of the Luminato Festival. \n\nThis is the first tour led by the NAC Orchestra’s highly acclaimed Music Director, Alexander Shelley."
      }
    ],
