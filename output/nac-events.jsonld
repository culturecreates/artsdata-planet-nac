    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Storgårds, Beethoven et Dvořák  | et les débuts d’Élisabeth Pion |   4- 5 nov 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40423/metaadtemplate_8_(1)__event_1024__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Célébrez le premier concert de John Storgårds à titre de directeur musical!\n\nJoignez-vous aux célébrations dans le foyer du Canal après le concert inaugural du 4 novembre pour une réception spéciale soulignant le premier concert de John Storgårds à titre de directeur musical de l’Orchestre du CNA.\n\nRencontrez d’autres mélomanes, échangez avec les musiciennes et musiciens de l’Orchestre et levez votre verre pour célébrer le début d’un nouveau chapitre prometteur!\n\n​ - - - - - - - -\n\nQuelques infos clés...\n\n\n\tCe programme est..."
      }
    ],
