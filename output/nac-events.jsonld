    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/42275#2026-12-02T19:30:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/42275/charles_dickens__large.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://nac-cna.ca/venue/fourth-stage#Place"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://nac-cna.ca/genid/c5924ebd8ba4ab45"
      }
    ],
