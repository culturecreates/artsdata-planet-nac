    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The National Arts Centre collaborates with artists and arts organizations across Canada to help create a national stage for the performing arts, and acts as a catalyst for performance, creation and learning across the country. A home for Canada’s most creative artists, the NAC strives to be artistically adventurous in each of its programming streams."
      }
