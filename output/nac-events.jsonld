  {
    "@id": "https://nac-cna.ca/en/series/journeys-through-storytelling-26-27",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/series/journeys-through-storytelling-26-27"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Journeys Through Storytelling |  NAC Indigenous Theatre series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/40813/it_series_header_journeys-through-storytelling__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Stories hold memory and shape identity. In The Diviners, a young woman searches for her Métis roots. Pakuneu follows three lives marked by incarceration and intergenerational harm. The Comeback centres on a couple learning how family histories surface through parenthood. Each work asks how storytelling helps us understand the past and live with it in the present."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/series/journeys-through-storytelling-26-27"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/series/bold-and-unique-experiences-26-27",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/series/bold-and-unique-experiences-26-27"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Bold and Unique Experiences |  NAC Indigenous Theatre series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/40812/z-it_package_header_cyo_26-27-b__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Three productions. Three very different encounters. This series highlights the range of contemporary Indigenous theatre, from Beckett reimagined in Inuktitut in Waiting for Godot, to the dance-driven programs of Matriarchs Uprising, to the music-fuelled storytelling of Beautiful Scars. Together, they show how Indigenous artists work across forms, languages, and practices to create theatre that challenges and surprises."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/series/bold-and-unique-experiences-26-27"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/series/tales-of-kinship-26-27",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/series/tales-of-kinship-26-27"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Tales of Kinship  |  NAC Indigenous Theatre series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/40811/it_series_header_tales-of-kinship__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Family ties shape who we are, for better and worse. This series brings together three works that centre on inheritance, identity, and belonging. The Comeback follows a Métis writer navigating family tensions as they become a parent. Beautiful Scars traces Tom Wilson's search for truth after a family secret surfaces. In The Diviners, Pique Gunn looks to the past to understand where she comes from."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/series/tales-of-kinship-26-27"
      }
    ]
  },
