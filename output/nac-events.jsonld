      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NACO Mentorship: Talks and Masterclasses | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/38081/naco_mentorship_2023_-_panel_-_jessica-linnebach__meta.jpeg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In June 2022, the NAC Orchestra launched its Mentorship Program with the tag line “Play it Forward”. This annual program bridges the gap between completing formal orchestral studies and landing a position in a professional orchestra. For audition circuit artists who are finishing up their studies, and musicians who have recently joined a professional orchestra, the NACO Mentorship Program is an opportunity to meet and play with one of North America’s leading orchestras. Participants hone their orchestral skills through one-on-one mentorship with the NACO musicians and build their career network with the talented NAC Orchestra administrative team.\n\nThis collection of videos gives a sense of the relationships the NAC Orchestra has with worldwide artists, and the conversations they are having together. Watch a masterclass with a world-renowned guest artist or listen to women in orchestral leadership speak about their careers and challenges."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/series/naco-mentorship-talks-masterclasses"
      }
    ]
  },
