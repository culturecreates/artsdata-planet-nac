    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "À la carte : Théâtre français"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/40789/tf_cyo_header_26_27-e__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous êtes conviés à vivre des expériences partagées à travers des œuvres qui nous reflètent, nous bousculent et nous habitent. Le Théâtre français comme espace public vivant pour ralentir et se laisser traverser par des formes audacieuses portées par des voix fortes et singulières. Choisissez ce qui vous interpelle et soyez des nôtres."
      }
    ],
