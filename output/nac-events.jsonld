    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Buffalo Bone Trade"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From a downtown bench, one man channels the loss of culture and self-determination into a message of hope and resilience. The ancestral memory of the mighty buffalo that used to roam, offered to empower us to look beyond the railyard.&nbsp; Location:&nbsp;1st Avenue / 21st Street, Saskatoon, Saskatchewan Credits: Written by Shawn Cuthand, interpreted from a Memory from John Cuthand&nbsp;&nbsp; Sound Production by Matthew Ladoucer&nbsp; GORDON TOOTOOSIS NIKANIWIN THEATRE&nbsp;(Saskatoon) Ed Mendez, General Manager &nbsp; Jennifer Dawn Bishop,&nbsp; Artistic Director &nbsp; Cory Dallas Standing,&nbsp;Marketing Coordinator &nbsp; Darlene Okemaysim-Sicotte, Assistant Admin&nbsp; Cheyanne Lemaigre, COV Coordinator&nbsp; Elizabeth Ahenakew, Cultural Knowledge Keeper&nbsp; Lois Hardy, Finance&nbsp; Consulting (Indigenous Cities), Heather Cant&nbsp; &nbsp; Indigenous Cities: The stories here. Experience stories from the cities you thought you knew &ndash; Montreal, Vancouver, Saskatoon, and Ottawa. Indigenous Cities presents memories from Indigenous community members based in cities across Canada; memories that have been interpreted by Indigenous artists to create a unique audio storytelling experience.&nbsp; Learn more:&nbsp;Indigenous Cities Saskatoon&nbsp;"
      }
    ]
  },
