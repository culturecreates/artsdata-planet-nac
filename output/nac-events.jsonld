    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bashir Lazhar The charismatic professor returns to the stage"
      },
      {
        "@language": "fr",
        "@value": "Bashir Lazhar Le retour à la scène du charismatique professeur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "First staged in 2007, this powerful play by Evelyne de la Chenelière still resonates with audiences today, prompting us to challenge our value system and educational system. Directed by Marie Brassard, Mani Soleymanlou brings his own personal background to the iconic role of the teacher from abroad, offering us a compelling lesson in humanity."
      },
      {
        "@language": "fr",
        "@value": "Ce percutant texte signé Evelyne de la Chenelière et créé en 2007 continue de résonner dans l’espace collectif, interrogeant notre système de valeurs et d’éducation. Sous la direction de Marie Brassard, Mani Soleymanlou revisite avec son propre bagage identitaire l’iconique professeur venu d’ailleurs pour nous offrir une vibrante leçon d’humanité."
      }
    ]
  },
