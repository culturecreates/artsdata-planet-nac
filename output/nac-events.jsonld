    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "L'Orestie | National Creation Fund"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-creationfund.s3.amazonaws.com/41377/lorestie_creationfund_header-c__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Oresteia, a seminal work in the Western tragic canon, interrogates the tensions of our modern world. Aeschylus’s triptych of plays centres on a major transition, from a cycle of revenge to the creation of collective justice, all the more resonant today as the world seeks out a new democratic order.\n\nThis human fresco will be brought to life by 32 performers, including three musicians. The musical talents of veteran artists and recent theatre school grads alike produce a vibrant..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
