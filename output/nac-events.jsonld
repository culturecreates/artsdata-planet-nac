      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tournée au Nouveau-Brunswick et en Nouvelle-Écosse | Série Orchestre du CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/40606/dscf3346-curtis-perry-crop_header-e__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La centième tournée de l’Orchestre du CNA : un moment historique réunissant Jeremy Dutcher, la Cinquième symphonie de Beethoven et de puissantes voix autochtones."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
