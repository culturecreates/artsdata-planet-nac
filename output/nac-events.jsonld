    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41728#2026-12-08T20:00:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41728/the_tenors_-_black_background__large.jpeg"
      }
    ],
    "http://schema.org/organizer": [
