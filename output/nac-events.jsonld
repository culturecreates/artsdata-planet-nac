    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/video/art-after-division-expressions-shaped-by-the-1947-partition"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Après la division, l’art : quand la partition de 1947 influence l’expression artistique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La directrice artistique du Th&eacute;&acirc;tre anglais du CNA, Nina Lee Aquino, s&rsquo;entretient avec la dramaturge et interpr&egrave;te Anusree Roy et l&rsquo;artiste visuelle Tanya Momi. Dans cette conversation, les deux artistes se joignent &agrave; Nina pour r&eacute;fl&eacute;chir &agrave; l&rsquo;influence qu&rsquo;ont eue sur leur expression cr&eacute;ative les r&eacute;cits familiaux sur la partition de l&rsquo;Inde et du Pakistan en 1947 &ndash; Anusree Roy pour sa pi&egrave;ce acclam&eacute;e Trident Moon et Tanya Momi pour sa s&eacute;rie de percutants tableaux qui donnent vie aux histoires qu&rsquo;on lui a l&eacute;gu&eacute;es."
      }
    ]
  },
