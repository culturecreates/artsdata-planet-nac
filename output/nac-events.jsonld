      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41229#2027-02-20T19:30:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41229/rounded_corner_design__large.png"
      }
    ],
    "http://schema.org/organizer": [
      {
