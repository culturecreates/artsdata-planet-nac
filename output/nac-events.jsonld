      {
        "@id": "https://nac-cna.ca/en/video/le-projecteur-jacques-surette-quatrieme-salle"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "“Monsieur Beau Soleil” by Jacques Surette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Jacques Surette&rsquo;s music blends warm, heartfelt folk with touches of country, alt&#8209;rock, and the unmistakable spirit of Acadian culture. Singing primarily in French&mdash;with occasional English tracks that reflect his bilingual life&mdash;he crafts simple, touching songs that transport listeners straight to the landscapes and stories of his native Yarmouth, Nova Scotia."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/5d49eb04091c8c6a",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/40895/2026-03-17-projecteur-jocelyn__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-16T15:59:00-04:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/le-projecteur-jocelyne-baribeau-quatrieme-salle"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "“Right là” by Jocelyne Baribeau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "A proud Manitoban, Jocelyne Baribeau is a prominent figure on the Canadian folk and roots scene. As a singer&ndash;songwriter, she tells the stories of rural Francophone communities in a tender, lucid, and humorous way. From her 2009 debut with Madame Diva, a project for young audiences in Francophone communities in Western Canada, to her solo and collaborative projects, notably the duo Beaus&eacute;jour, Jocelyne&rsquo;s artistic career is deeply rooted in her home territory. She won the Francophone Artist of the Year award at the 2016 Western Canadian Music Awards and has been nominated for recognition at the Canadian Folk Music Awards, the Trille Or, and the GAMIQ (Gala alternatif de la musique ind&eacute;pendante du Qu&eacute;bec).&nbsp; Her most recent album, Portraits, has received critical acclaim and airplay. The songs &ldquo;Portrait de famille,&rdquo; &ldquo;Bottes de cowboy,&rdquo; and &ldquo;La blonde d&rsquo;Elvis&rdquo; made it into the Top 10 on Stingray Franco Country, and the album has been nominated for recognition at the Western Canadian Music Awards and the Gala Country. In live performance, she has opened for Roch Voisine, Isabelle Boulay, and Patrick Norman, and has toured across Western and Eastern Canada, appearing at events such as Coup de c&oelig;ur francophone, ROSEQ, Festival du Bois, and Festival Western de St-Tite. Jocelyne Baribeau gives voice to the silences of the prairies, to memories passed down, and to the roots we choose not to forget.&nbsp; Her new album, 200 Acres, her first vinyl record, comprises eight songs, also featured in a show put together with the wonderful team at the NAC."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/2b35507950c310d0",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/40678/1-fables-davidwong__dcw0960-arw-edit__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
