      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Chef Chris Commandant talks with National Arts Centre House Manager Michael Gauthier about his dedication to preserve Indigenous culinary traditions and teachings.\n\nChef Commandant is currently the Sous Chef at 1 Elgin restaurant and was our Resident Chef from September to November 2024."
      }
    ],
