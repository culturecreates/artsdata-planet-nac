      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Dream, connect, create | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/39684/creation_sans_titre__meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "How do some of Canada’s most exciting artists dream? How does artistic creation impact how Canadians see the world? How can the risks that artists take inspire us in our own lives?\n\nThese are just some of the questions brought to life in this series of interviews with Canadian artists who have received support from the National Arts Centre’s National Creation Fund. The interviewees, all working in different performing arts disciplines and communities, talk about artistic creation and the importance of investing in it. They each share how the Fund’s investment gave them the means to dream big, take risks and turn their boldest ideas into reality.\n\nThe Fund has invested in over 100 major creations since it was founded. Its support contributes to the vibrancy of Canadian culture, rallying artists and audiences around bold creations that inspire and engage with their quality and artistic innovation on national and international stages. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/series/national-creation-fund-fond-national-de-creation"
      }
    ]
  },
