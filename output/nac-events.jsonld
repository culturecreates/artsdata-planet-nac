    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La Salle Canada, plus grand espace privé du CNA, bénéficie d’une vue imprenable sur le canal Rideau, avec un foyer attenant et un accès à l’extérieur. Elle peut également être divisée en trois salles : Pacifique, Atlantique et Arctique."
      }
    ],
