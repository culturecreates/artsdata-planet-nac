    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "2025 International Acoustic Music Award winner, 2026 Kerrville New Folk Finalist and Canadian Folk Music Award nominee Robert Thomas is one of Canada’s finest lyricists and collaborative songwriters. He has crafted songs for legends like Kenny Rogers, Bonnie Raitt, Joe Cocker, and the (Dixie) Chicks among others. After 30 years behind the scenes in music publishing, Thomas is now touring his compelling catalogue of new and older compositions. These are songs we can all connect with - memorable radio sing..."
      }
