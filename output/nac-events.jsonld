    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ottawa Jazz Orchestra La langue de chez nous"
      },
      {
        "@language": "fr",
        "@value": "Orchestre de Jazz d'Ottawa La langue de chez nous"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us for a fresh spin on beloved classic chansons from France and Quebec. Jazz vocalist Diane Nalini will interpret songs made famous by Yves Duteil, Félix Leclerc, Juliette Gréco, Georges Brassens and more. Accompanying her for this musical adventure through the twentieth century will be David Renaud on saxophone and clarinet, Mark Ferguson on piano and trombone, and Adrian Cho on double bass. An intimate, joyful evening not to be missed!"
      },
      {
        "@language": "fr",
        "@value": "Rejoignez-nous pour redécouvrir, sous un jour nouveau, des grands classiques de la chanson française et québécoise. La chanteuse de jazz Diane Nalini interprétera des pièces rendues célèbres par Yves Duteil, Félix Leclerc, Juliette Gréco, Georges Brassens et bien d'autres. Pour cette aventure musicale à travers le XXe siècle, elle sera accompagnée de David Renaud au saxophone et à la clarinette, de Mark Ferguson au piano et au trombone, ainsi que d'Adrian Cho à la contrebasse. Une soirée intime et joyeuse à ne pas manquer!"
      }
    ]
  },
