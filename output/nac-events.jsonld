      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/42164/toddler_tuesdays_1__event_1440__large.jpg"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
