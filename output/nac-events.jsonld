  {
    "@id": "https://nac-cna.ca/fr/video/series/uaque",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/video/series/uaque"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "La création de UAQUE | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/37250/vlcsnap-2024-08-27-10h45m42s848__meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une nouvelle commande conjointe de Danse CNA et de l’Orchestre du CNA ouvre avec éclat le festival SPHÈRE 2024. UAQUE, de la chorégraphe et artiste multidisciplinaire colombo-canadienne Andrea Peña, propose un amalgame unique de danse, de musique et d’arts visuels. UAQUE, qui signifie « proche, voisin, ami » en muisca, langue autochtone de la terre natale de l’artiste, la Colombie, entraînera le public dans un périple contemplatif et immersif. UAQUE, qui signifie « proche, voisin, ami » en muisca, langue autochtone de la terre natale de l’artiste, la Colombie, entraînera le public dans un périple contemplatif et immersif.  \n\nDans le cadre de cette série vidéo, Andrea parle du processus de création et des thèmes abordés dans cette pièce qui invite les publics à réfléchir à un lieu de communion entre l'humanité et la planète. \n\nPhoto: Thjorsá River #2, Southern Region, Iceland (2012), Edward Burtynsky"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/video/series/uaque"
      }
    ]
  },
