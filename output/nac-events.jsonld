  {
    "@id": "https://nac-cna.ca/fr/venue/fourth-stage/rent",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/venue/fourth-stage/rent"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/763/fourthstage_desktop_cover2__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec ses longues fenêtres au niveau de la rue et ses places assises de style cabaret, la Quatrième Salle est un lieu de découverte et un espace communautaire. Elle offre un espace convivial de 150 places et un équipement son et lumière de premier plan. Chaque année y sont présentées des centaines de concerts d’artistes émergents et d’événements communautaires.\n\nLes sièges à la Quatrième Salle ne sont pas réservés. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
