    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "DOGMA | National Creation Fund"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-creationfund.s3.amazonaws.com/41867/web_header_dogma-f__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "DOGMA began with a question we couldn't stop returning to: How do beliefs take hold? And when the structures we trust begin to fracture, what remains? We're also asking something about circus itself. What happens when physical risk isn't there to impress, but to embody uncertainty, yearning, or transformation?\n\nThe work is being created collectively by the six founding members of People Watching alongside an expanded group of collaborators in scenography, lighting, sound, and..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
