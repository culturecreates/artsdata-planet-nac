    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Jann Arden Christmas Concert | with the NAC Orchestra |  Sat, Dec 5, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42026/jann_web-b__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "CELEBRATING SONGS FROM THE PLATINUM-CERTIFIED ALBUM A JANN ARDEN CHRISTMAS\n\nAward-winning Canadian singer-songwriter Jann Arden invites audiences into the warmth and wonder of the season with Jann Arden and Her Holiday Orchestra. The newly announced holiday tour brings Arden’s voice, spirit and humour to an evening of Christmas music, hits and fan favourites with her holiday orchestra.\n\nArden returns to the stage with the warmth and generosity audiences cherish. Building on the success of last year’s platinum-certified album, A Jann Arden Christmas,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
