      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/orchestra/learn"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NAC Orchestra\n \n \n \n \n  | Learn and Engage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/assets/img/season2020/meta/orchestra_meta_image_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "“2019 celebrates the 50th Anniversary of the NAC Orchestra with quintessential classical repertoire, world-renowned (guest) artists and family-friendly pops and children’s concerts. The last half-century has been full of special moments and artistic highlights, and we look forward to continuing this celebration of classical repertoire with you in our milestone 2019-2020 season.”"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/orchestra/learn"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/canada150tour/prairies",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/canada150tour/prairies"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Prairie Provinces  | NAC Orchestra Canada 150 tour"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_prairies_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "From October 19 –28, the National Arts Centre Orchestra will continue its Canada 150 Tour, beginning in Winnipeg, then travelling to Saskatoon, Calgary and Edmonton. The tour will celebrate the 150th anniversary of Confederation through music, by engaging with audiences, young audiences and young artists.\n\nThis is the first tour led by the NAC Orchestra’s highly acclaimed Music Director, Alexander Shelley, and will feature the Calgary-based pianist, Jan Lisiecki and NAC Orchestra violinist Jessica Linnebach."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/canada150tour/prairies"
      }
    ]
  },
  {
