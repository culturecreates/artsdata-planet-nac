    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Toni Morrison Songs & Mendelssohn’s “Scottish” Symphony feat. Vuvu Mpofu, Roderick Cox, and the NAC Orchestra"
      },
      {
        "@language": "fr",
        "@value": "Toni Morrison en musique et la Symphonie « Écossaise » de Mendelssohn avec Vuvu Mpofu, Roderick Cox et l’Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Be whisked away to Scotland in a musical postcard depicting the country’s enchanted landscape, while powerful settings of Toni Morrison’s poetry mix elements of jazz and spirituals."
      },
      {
        "@language": "fr",
        "@value": "Transportez-vous en Écosse avec une carte postale musicale dépeignant les paysages enchanteurs de la région, et laissez-vous émouvoir par la puissante mise en musique de poèmes de Toni Morrison, avec une touche de jazz et de spirituals."
      }
    ]
