    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Orchestre de Jazz d'Ottawa  | La langue de chez nous |  24-25 mar 2027|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41712/la_langue_de_chez_nous__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Rejoignez-nous pour redécouvrir, sous un jour nouveau, des grands classiques de la chanson française et québécoise. La chanteuse de jazz Diane Nalini interprétera des pièces rendues célèbres par Yves Duteil, Félix Leclerc, Juliette Gréco, Georges Brassens et bien d'autres. Pour cette aventure musicale à travers le XXe siècle, elle sera accompagnée de David Renaud au saxophone et à la clarinette, de Mark Ferguson au piano et au trombone, ainsi que d'Adrian Cho à la contrebasse. Une soirée intime et joyeuse..."
      }
    ],
