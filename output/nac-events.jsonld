    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au micro de Michael Gauthier, gestionnaire des salles du CNA, le chef Chris Commandant nous parle de sa volont&eacute; de pr&eacute;server les traditions et les enseignements culinaires autochtones et de son travail au restaurant 1 Elgin en qualit&eacute; de sous-chef. Le chef Commandant a &eacute;t&eacute; chef r&eacute;sident au CNA de septembre &agrave; novembre 2024.&nbsp;&nbsp;"
      }
