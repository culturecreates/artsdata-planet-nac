      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Programme des artistes invités en danse, une initiative conjointe du Conseil des arts du Canada et du Centre national des Arts, soutient l’épanouissement créatif et l’avancement de chorégraphes canadiens choisis, en leur procurant des résidences sous forme d’expériences immersives adaptées à leurs besoins."
      }
    ],
