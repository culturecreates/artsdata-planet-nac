    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/39753/nac_web_chefs_cook_pickerel___large.png"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-09-18T16:52:00-04:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/perfect-pickerel-every-time"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Perfect pickerel every time | Easy and delicious recipe "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Whether you just got back from the lake or picked up a fillet from your local market, this recipe brings out the natural, mild flavour of this amazing freshwater fish. It will be crispy to&nbsp; perfection with just a few simple ingredients.&nbsp; &nbsp; Ingredients 6 leeks&nbsp; 500ml 35% cream&nbsp; 1 lemon juiced&nbsp; 2lb clarified butter&nbsp; 1 cup chicken stock or vegetable&nbsp; 2 pickerel&nbsp; 6 fingerling Hasselback potatoes&nbsp; Instructions&nbsp; \tCook leek in cream until super soft and cream is very reduced and thick. Season gently with lemon.&nbsp; \tHeat up Hasselback potato. Should be nice and crispy on the outside.&nbsp;&nbsp; \tSeason pickerel. Sear pickerel in pan. Flip, baste in butter until cooked through. Finish with lemon juice.&nbsp; \tUsing large ring mold, place leeks on plate. The cream should be thick enough that the leeks aren&rsquo;t too liquid.&nbsp; \tPlace pickerel on top of leeks.&nbsp; \tPlace potato beside pickerel.&nbsp; \tGarnish with crispy leeks.&nbsp;"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/5b3cad79c552956c",
