      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mois du patrimoine asiatique | Série"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/38738/export-2__tablet-small.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En mai, pour le Mois du patrimoine asiatique, nous célébrons l’élan, la résilience et la vitalité créatrice des artistes et des communautés asiatiques – une occasion tout indiquée pour reconnaître l’influence durable de leurs identités, de leurs histoires et de leurs imaginaires sur nos scènes, nos espaces publics et la vie culturelle du pays.\n\nAvec Les courants, Chun Hua Catherine Dong fait de la Lanterne Kipnes un espace éclatant de vie. Entre motifs textiles chinois et imagerie marine, l’œuvre donne forme..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
