    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In 1983, American playwright Arthur Miller travelled to China to direct a production of his classic play, Death of a Salesman. Working with the Beijing People's Art Theatre, Miller and his collaborators struggled to bridge the gap between languages, cultures and national identities with local audiences having been long shut off from the West. Salesman in China retells this daring act of cultural cross-pollination on stage. "
      }
