    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "In Conversation with Derek McCormack and Micah Lexier: Art, Text, and Collaboration | presented by the Ottawa Public Library |  Wed, Nov 25, 2026, 7:00 pm | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42350/ic_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Curious about how the art and literary worlds can connect in creative pursuits? Join Derek McCormack and Micah Lexier for an informal art talk at the National Arts Centre, hosted by the Ottawa Public Library. Settle in for a lively chat between friends who think outside the box, as they share insights into joint projects like City of Letters (2024), I Am The Coin (2010), and a series of clever multiples that serve as visual/linguistic gags. They’ll also take turns..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
