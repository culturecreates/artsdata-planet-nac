        "@language": "fr-ca",
        "@value": "Lanterne Kipnes"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.nac-cna.ca/img/lantern/meta/lantern_meta_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La Lanterne Kipnes est le bijou du Projet de renouvellement architectural du CNA. Surplombant majestueusement la nouvelle entrée principale du CNA, la tour vitrée utilise des écrans transparents à DEL à la fine pointe de la technologie pour afficher les récits des artistes canadiens d’une façon innovante et éclatante."
      }
    ],
