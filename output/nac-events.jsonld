      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Atlantic Provinces  | NAC Orchestra Canada 150 tour"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_atlantic_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "From April 25 to May 7, the National Arts Centre Orchestra began its Canada 150 Tour in the Atlantic provinces, beginning in St. John’s, then travelling to Moncton, Charlottetown, Eskasoni, Saint John and Halifax. The tour celebrates the 150th anniversary of Confederation through music, by engaging with audiences, young audiences and young artists. \n\nThis is the first tour led by the NAC Orchestra’s highly acclaimed Music Director, Alexander Shelley, and will feature the internationally renowned Canadian violinist James Ehnes, a  GRAMMY® Award and 10-time JUNO Award winner."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
