        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/venue/studio/rent"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/620/studio__hero_xlarge-2__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Studio Azrieli a été conçu comme une salle de style boîte noire, ce qui permet une expérience théâtrale plus versatile. Cette salle intime de 300 places est configurable à 100 %, offrant un maximum de flexibilité aux concepteurs. Le Studio Azrieli accueille une vaste gamme de spectacles, allant du théâtre contemporain aux concerts populaires à la danse audacieuse. Les sièges au Studio ne sont pas réservés."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/venue/studio/rent"
      }
    ]
