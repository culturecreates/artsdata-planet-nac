    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40836/web_resize__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ivan Boivin-Flamand revient sur le devant de la scène avec un tout nouveau microalbum, Nitehi, et un spectacle inédit. Accompagné de ses musiciens, le poète-compositeur-interprète à l’instinct affûté et virtuose de la guitare électrique promet une soirée musicale captivante. Habitué des plateaux télévisés et des tournées au Québec, Ivan Boivin-Flamand propose avec Nitehi – « mon cœur » en atikamekw, sa langue natale – un spectacle de chansons minutieusement composées qui lui collent à la peau. Avec sa voix aérienne..."
      }
    ],
