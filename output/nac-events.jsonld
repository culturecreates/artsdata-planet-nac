    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Rankin Family  |   mer 24 mar 2027, 19 h 30|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42519/cooked-photography-rankinfamily-oct-retouched-sept-2026-9__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les racines\n\nLa famille Rankin est originaire de Mabou, une petite collectivité côtière nichée dans les hautes terres de l’île du Cap-Breton, en Nouvelle-Écosse — un endroit où la musique s’intègre à la vie quotidienne aussi naturellement que les marées. Ayant grandi dans une famille de douze enfants, les Rankin jouaient pour leurs voisins lors de ceilidhs locaux, de mariages et de soirées dansantes dès les années 1970. La musique n’a jamais fait partie de leurs projets de carrière. C’était simplement..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
