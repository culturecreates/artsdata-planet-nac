      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41893#2027-04-02T20:00:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41893/3__large.jpg"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://nac-cna.ca/genid/41d5db2caca664f0"
      }
    ],
    "http://schema.org/location": [
      {
