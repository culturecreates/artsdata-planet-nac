        "@value": "Existe-t-il des abonnements de groupe ou des abonnements pour étudiants pour les spectacles produits par le CNA?"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/bc90461ba87ebcf5",
    "@type": [
      "http://schema.org/Question"
    ],
    "http://schema.org/acceptedAnswer": [
