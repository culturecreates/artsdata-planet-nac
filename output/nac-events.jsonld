        "@id": "https://nac-cna.ca/en/event/41649#2027-03-18T19:30:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41649/rounded_corner_design__large.png"
      }
    ],
    "http://schema.org/organizer": [
