    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/indigenous-led-audio-description-panel"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Indigenous-led audio description panel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "How can audio description be made more culturally relevant for Indigenous communities?&nbsp; This online panel brings together artists and practitioners from Canada and New Zealand to share their perspectives on Indigenous-led audio description. After an introduction to audio description, panelists highlight promising initiatives and explore new approaches to making the arts more accessible.&nbsp; Panelists:&nbsp; Rebecca Singh (Superior Description Services)&nbsp; Victoria De La Ronde&nbsp; Yolanda Bonnell (Animikii Creations / manidoons collective)&nbsp; Alanah-Jay Harris (Audio Described Aotearoa)&nbsp; Janis Mayers&nbsp; Did you know that we offer ASL interpretation for many of our events? Learn more about our commitment to inclusive programming."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/1d1be7e714e6d477",
    "@type": [
