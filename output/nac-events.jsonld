    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DJ Kookum"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "#ReconcileThis est un mouvement qui mobilise et donne la place aux voix autochtones dans les r&eacute;seaux sociaux tout en c&eacute;l&eacute;brant la culture via des histoires num&eacute;riques, la chanson et la danse. DJ Kookum utilise la musique pour exprimer et affirmer son identit&eacute; autochtone en fusionnant les genres, de la musique de danse &eacute;lectronique au hip-hop. @djkookum"
      }
    ]
  },
