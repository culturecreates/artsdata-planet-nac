        "@language": "en-ca",
        "@value": "Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/620/studio__hero_xlarge-2__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Azrieli Studio was engineered as a black box space, allowing for a more versatile theatrical experience. The intimate 300-seat venue is 100% configurable to complement the utmost flexibility for designers. A wide variety of performances are presented in the Azrieli Studio, from contemporary theatre to adventurous dance performances to popular concerts. The Azrieli Studio is always general admission."
      }
    ],
