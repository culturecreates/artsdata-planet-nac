      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NAC Orchestra\n \n \n \n \n  |  Events"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/orchestra/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Feel the undeniable energy and power of live music with the NAC Orchestra! The 2026-2027 lineup brings powerful performances that stir the soul—iconic classics, bold new works, Pops favourites, blockbuster movies in concert, and family-friendly experiences. Feel the thrill of live music and create lasting memories with your NAC Orchestra."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
