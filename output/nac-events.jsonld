    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Stravinsky Stories | Canada’s Royal Winnipeg Ballet | Oct 29 - 31, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40371/stravinsky_stories_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "With the NAC Orchestra\n\nThe Fairy’s Kiss by Alexei Ratmansky - 47 min \nIntermission - 20 minutes\nFirebird by Houston Thomas - 48 min\n\nFrom Folklore to Fantasy\n\nFor Christopher Stowell’s first programmed season as RWB’s new artistic director, he brings us this glorious ode to Stravinsky, the quintessential ballet composer of the 20th century.  \n\nIn this special evening, Stravinsky’s compositions will be brought to life on stage in two one-act ballets: The Fairy’s Kiss, composed in 1928 for Les Ballets de Madame Ida Rubinstein and Firebird, composed in..."
      }
    ],
