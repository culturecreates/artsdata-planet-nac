    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/619/theatre-2013-003a-2__hero_xlarge__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Babs Asper Theatre is the NAC’s second largest performance space, and the main venue for the NAC’s premier theatrical productions and contemporary dance performances.  The stage is adaptable – it can configure to a proscenium or thrust stage. The design of the Theatre’s technical system makes it an ideal setting for all types of music concerts – from intimate chamber ensembles to jazz, rock and pop."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
