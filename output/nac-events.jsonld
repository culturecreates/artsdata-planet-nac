    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Charles Dickens performs A Christmas Carol  | Par John D. Huston |   mer  2 déc 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42275/charles_dickens__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ce mois de décembre, redécouvrez la magie des Noëls d’antan.\n\n« Un spectacle solo saisissant… entre les mains d’un maître conteur. » National Post\n\nDécouvrez A CHRISTMAS CAROL tel que son auteur l’a raconté pour la première fois.\n\n« J’ai adoré ce spectacle et j’encourage tout le monde à aller le voir. » Ottawa Sun\n\nLa célèbre reconstitution par John D. Huston de la performance magistrale de Charles Dickens dans A CHRISTMAS CAROL revient le 2 décembre dans l’intimité tamisée par la lueur des..."
      }
    ],
