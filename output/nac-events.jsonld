    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Good Lovelies 20th Anniversary Christmas Concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Canadian vocal harmony trio Good Lovelies’ much-loved Christmas Tour returns this December as they celebrate their 20th anniversary as a band! This show features holiday classics, winter favourites as well as the band’s original music that audiences have come to love over their two-decade career. Caroline Brooks, Kerri Ough and Susan Passmore are Juno Award-winning songwriters and multi-instrumentalists known for their rich harmonies and nostalgic sound. Blending folk-roots, old-time swing, bluegrass, pop and soul, their music is a perfect fit for the season. They’ll be joined on stage by their longtime friends and collaborators, Robbie Grunwald on keys, Steve Zsirai on upright bass, and Mark Mariash on drums. We hope you’ll come join in the festivities!"
      }
    ]
  },
