    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Hildá Länsman & Tuomas Norvio |  Sat, Nov 21, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42250/hilda_lansman__tuomas_norvio_pic__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The duo Hildá Länsman & Tuomas Norvio invite you to join their ongoing exploration between the ancient Sámi vocal tradition of luohti (joik) and modern electronic soundscapes.  \n\nHildá Länsman is a singer, joiker, and musician from Ohcejohka, the northernmost Finnish part of the Sápmi region. She grew up in a family of reindeer herders and joikers, and her work is dedicated to highlighting and developing the Sámi culture. \n\nTuomas Norvio, a Finnish sound designer, composer and producer, weaves his intricate electronic soundscapes,..."
      }
    ],
