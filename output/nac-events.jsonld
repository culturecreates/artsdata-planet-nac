    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-videos.s3.amazonaws.com/37764/yt_thumbnail_-_vancouver__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In Vancouver, Kelsey Wavey led a project centered around their journey of reclaiming and sharing their gift of song. Give It Up / Give It Back reflects on Wavey’s early experiences with the residential school apology and their first protest at age 15. The video combines personal reflection with a powerful song about land, renewal, and the role of art in decolonization and cultural reclamation."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
