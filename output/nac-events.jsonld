      {
        "@language": "en-ca",
        "@value": "NACO Mentorship program | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/32282/naco-mentorship-06-10-22-rite-of-spring_credit_curtis-perry_dscf8735__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In June 2022, the NAC Orchestra launched its Mentorship Program with the tag line “Play it Forward”. This annual program bridges the gap between completing formal orchestral studies and landing a position in a professional orchestra. For audition circuit artists who are finishing up their studies, and musicians who have recently joined a professional orchestra, the NACO Mentorship Program is an opportunity to meet and play with one of North America’s leading orchestras. Participants hone their orchestral skills through one-on-one mentorship with the NACO musicians and build their career network with the talented NAC Orchestra administrative team.\n\nHear what some of the participants had to say about the Orchestra, the mentorship, and the amazing opportunities."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
