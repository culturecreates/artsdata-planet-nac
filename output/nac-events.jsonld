        "@language": "en-ca",
        "@value": "The Cabaret of Death | Performed by the Ballet Mexicain du Montreal |  Fri, Oct 30, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
