    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Jireh Gospel Choir  |   sam 20 mar 2027, 19 h 30|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
