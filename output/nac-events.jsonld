    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Art after division: Expressions shaped by the 1947 Partition"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&nbsp;NAC English Theatre Artistic Director Nina Lee Aquino speaks with playwright and performer Anusree Roy and visual artist Tanya Momi. In this conversation, the two artists join Nina to reflect on how hearing their families&rsquo; stories about the 1947 Partition of India and Pakistan has shaped their creative expression&mdash;Anusree Roy through her acclaimed play Trident Moon, and Tanya Momi through a powerful series of paintings that bring inherited narratives to life."
      }
    ]
  },
