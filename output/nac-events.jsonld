      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In Edmonton, Barry Bilinski and Todd Houseman worked with youth from Treaty 6, Joshua Carter-Killback, Kingston Ward-Bouvier, and Eden Mayes, to create a video collage focused on the future of Indigenous nations. Guided by the wisdom of Elders, the youth shared their visions of a thriving cultural future. The resulting video is a powerful expression of hope, creativity, and a forward-looking vision, rooted in cultural teachings and traditions."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
