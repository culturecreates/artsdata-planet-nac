    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "#ReconcileThis: Visits of joy and mischief "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Since 2021, #ReconcileThis has invited Indigenous artists to share their voices and perspectives through digital storytelling. Led by NAC Indigenous Theatre in collaboration with Meta, the project is a space where reconciliation is carried through art, where communities are uplifted, and where Indigenous stories live online.&nbsp; This new phase, Braiding Generations: Visits of Joy and Mischief, is led by Red River Michif and Jewish theatre artist Philip Geller. Inspired by Trickster teachings, the project highlights the laughter, teasing, and playful resilience that connect communities across generations.&nbsp; Starting in October, new works will be released weekly on our Facebook and Instagram pages. These short films, created by Indigenous video artists, grow out of intimate conversations with Fire Tenders and their families&mdash;stories that carry joy, humour, grief, and resilience.&nbsp;"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/69690a733208cc0a",
