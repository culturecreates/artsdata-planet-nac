    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/28033/jenelle-duval_kellie-walsh_web_no-text__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Retrouvez les musiciennes de St. John’s Jenelle Duval, de l’ensemble autochtone Eastern Owl, et Kellie Walsh, de Shallaway Youth Choir et Lady Cove Women’s Choir, pour une conversation approfondie sur le processus de collaboration.\n\n\nEastern Owl est un groupe primé unique composé de femmes qui combinent la musique de tambour des Premières Nations et le folk contemporain afin de créer leur propre son novateur.\n\nShallaway et Lady Cove sont deux ensembles acclamés dans le milieu de la musique chorale au Canada qui combinent une virtuosité incroyable à un engagement communautaire percutant."
      }
    ],
