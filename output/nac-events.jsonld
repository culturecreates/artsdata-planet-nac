      {
        "@language": "fr-ca",
        "@value": "Paskong Pinoy sa Ottawa  | Un Noël philippin à Ottawa |   sam 12 déc 2026, 09 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
