    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tournée Européenne du 50e anniversaire de l'orchestre du CNA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.nac-cna.ca/img/eurotour/eurotour_meta_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Sous la conduite d'Alexander Shelley, l'exceptionnel Orchestre du CNA ouvre de nouvelles voies à l'expérience du concert, en salle et au-delà. Créations audacieuses, relectures inattendues des classiques et échanges marquants avec les communautés — l'Orchestre franchit l'espace entre nous en racontant notre humanité commune."
      }
    ],
