      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41228#2027-02-17T20:00:00-05:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41228/web_resize_(1)__large.png"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://nac-cna.ca/genid/41d5db2caca664f0"
      }
    ],
    "http://schema.org/location": [
      {
