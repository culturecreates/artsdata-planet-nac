    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Storgårds, Beethoven & Tetzlaff | With the NAC Orchestra | Jan 20 - 21, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40422/9169_nac_naco_26_27_batch1_11__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know...\n\n\n\tMusic Director John Storgårds leads a night that journeys between bold heroism and brooding interior drama.\n\tStep into the emotional world of Elgar’s Violin Concerto, tender, searching, and powerfully human, in a performance by Christian Tetzlaff.\n\n\nAlthough Edward Elgar made his career as a composer, his first love was the violin, the instrument he studied for years as a child. In his only concerto for solo violin and orchestra, the English composer lovingly pays tribute to the instrument..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
