    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Théâtre français du CNA\n \n  | Apprendre et partager"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/assets/img/season2020/meta/theatrefrancais_meta_image_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "«  Les propositions artistiques que nous sommes si fiers de vous présenter sont tout à fait éclatées dans les formes et les styles. Elles reflètent sans prétention les préoccupations de notre société et expriment, depuis des horizons bien différents, la beauté et l’espoir. Elles sont une main tendue vers une société plus juste, plus humaine. »"
      }
    ],
