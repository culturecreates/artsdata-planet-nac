    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Robert Thomas and the Sessionmen, avec invitée spéciale Pat Moore  | Chansons et récits de voyage d'un des meilleurs auteurs-compositeurs canadiens |   mar 10 nov 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42185/full_band_from_stage_r__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Lauréat de l'International Acoustic Music Award 2025, finaliste du concours Kerrville New Folk 2026 et nommé aux Canadian Folk Music Awards, Robert Thomas compte parmi les meilleurs paroliers et auteurs-compositeurs collaboratifs du Canada. Il a écrit des chansons pour des légendes telles que Kenny Rogers, Bonnie Raitt, Joe Cocker et les (Dixie) Chicks, entre autres. Après trente ans passés dans l'ombre de l'édition musicale, Thomas part aujourd'hui en tournée pour présenter un répertoire captivant mêlant nouvelles compositions et titres plus..."
      }
    ],
