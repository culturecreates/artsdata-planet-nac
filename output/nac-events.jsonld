    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "#ReconcileThis Regina"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&Agrave; Regina, Skyler Anderson a travaill&eacute; avec des jeunes du territoire du Trait&eacute; no 4, Jaycee Anderson et Kiana Toto, pour cr&eacute;er une &oelig;uvre captivante qui aborde les d&eacute;fis de vivre dans un monde colonial. Les jeunes ont tent&eacute; de comprendre ce qui s&eacute;pare leur monde de celui de leurs anc&ecirc;tres en ayant recours aux c&eacute;r&eacute;monies et &agrave; l&rsquo;expression culturelle pour se construire une identit&eacute; dans la soci&eacute;t&eacute; d&rsquo;aujourd&rsquo;hui. Leur travail met en lumi&egrave;re l&rsquo;importance de la culture, de l&rsquo;identit&eacute; et de la tradition dans le monde moderne."
      }
    ]
  },
