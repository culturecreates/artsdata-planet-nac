    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "FORBIDDEN | Aditi Mangaldas Dance Company | Mar 11 - 12, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40360/forbidden-223__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Reclamation of Desire \n\nConsidered a maverick in India and around the world, Aditi Mangaldas is a leading dancer and choreographer in the classical Indian dance form of Kathak. Celebrated for the richness and intricacy of her technique, she is known to fiercely inhabit the stage with her presence.\n\nIn her solo FORBIDDEN, Mangaldas explores how desire, agency, and the body collide with societal taboos, using contemporary Kathak to confront what women are taught to silence or suppress. What results is a three-part..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
