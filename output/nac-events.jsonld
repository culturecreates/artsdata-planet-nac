    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41580/rounded_corner_design_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jean-Michel Blais s’apprête à écrire une épopée.\n\nmirador, le quatrième album du pianiste et compositeur montréalais, tourne son regard vers un univers vaste et merveilleux, délaissant une certaine retenue minimaliste au profit d’un maximalisme lumineux et généreux. Une odyssée portée par des chœurs, des cordes et de la musique andine, allant des grottes espagnoles aux pinèdes estoniennes, mais trouvant refuge à Nicolet, au Québec, là où Jean-Michel a imaginé ces aventures.\n\nAprès avoir cumulé plus de 400 millions d’écoutes et offert les..."
      }
    ],
