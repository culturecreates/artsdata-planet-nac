    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Diviners Based on the novel by Margaret Laurence. Text by Vern Thiessen with Yvette Nolan"
      },
      {
        "@language": "fr",
        "@value": "The Diviners D’après le roman de Margaret Laurence. Texte de Vern Thiessen avec Yvette Nolan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Vern Thiessen and Yvette Nolan’s powerful version of Margaret Laurence’s 1974 classic uses breathtaking theatricality, songs and dance to helps us imagine what a common future shaped by reconciliation could look like, if we choose to embrace it."
      },
      {
        "@language": "fr",
        "@value": "Cette puissante adaptation par Vern Thiessen et Yvette Nolan du roman classique de Margaret Laurence, paru en 1974, use d’une théâtralité époustouflante intégrant danse et chansons pour nous aider à imaginer à quoi ressemblerait un avenir commun sous le signe de la réconciliation, si nous choisissions cette voie."
      }
    ]
  },
