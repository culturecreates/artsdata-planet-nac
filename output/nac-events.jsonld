      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "À propos du Centre national des Arts"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.nac-cna.ca/img/about/about_meta_image_fr.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le Centre national des Arts collabore avec des artistes et des organisations artistiques partout au Canada afin de créer une vibrante scène nationale dans le domaine des arts du spectacle, et agit comme catalyseur de la diffusion, de la création et de la transmission des savoirs d’un bout à l’autre du pays.Carrefour des plus grands talents créateurs canadiens, le CNA privilégie les choix audacieux dans chacun de ses volets de programmation."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
