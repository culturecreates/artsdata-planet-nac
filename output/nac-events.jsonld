    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The King James Bible Play  | Texte de Charlotte Corbeil-Coleman |  11-21 nov 2026|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40376/bible_stage_final7_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une production du Festival de Stratford\n\nÀ quel saint se vouer quand les opinions divergent sur un texte sacré?\n\nMais que fait donc cet ananas dans l’Angleterre de 1609? Les apparences sont parfois trompeuses chez ce comité d’érudits religieux qui tente de traduire la Bible pour le roi Jacques Ier. Tout ce beau monde doit jongler avec les luttes d’ego, les attentes royales et (léger anachronisme) la nature de la solitude masculine. On peut s’attendre à tout lorsque les intruses les plus..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
