    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Cambodian Rock Band | By Lauren Yee featuring songs by Dengue Fever | Apr 21 - May 1, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40375/crb_beach_scene_fin_copy__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "An NAC English Theatre Production\nOriginally produced by the Arts Club Theatre Company, Vancouver \n\nThey sing the songs history couldn’t erase. \n\nA fictional band. Real Dengue Fever songs. And a father and daughter grappling with a horrific past. Part concert, part historical reckoning, Lauren Yee’s Cambodian Rock Band wades through the waters of family, survival, and the complex nature of trauma. Effortlessly moving between 1970s Cambodia and 2008, the play follows Chum, a genocide survivor who returns to Cambodia for the first time..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
