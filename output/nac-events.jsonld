      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Cycle | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/26847/republic_of_inclusion___morning_session_5-11_screenshot__meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "The Cycle est une trilogie d’initiatives de recherche de deux ans développée par la directrice artistique associée Sarah Garton Stanley en partenariat avec des artistes et des leaders de tout le pays. Chacun de ces cycles d’investigation en profondeur a pour objet de réunir des praticiens autour de grands thèmes, et d’adresser les préoccupations de notre société contemporaine d’un point de vue théâtral.\n\nNos champs d’intervention : \n\n\n\tles changements climatiques (2019-2020)\n\tles artistes sourds, handicapés ou vivant avec une maladie mentale et l’inclusion (2016-2017) \n\tle spectacle autochtone (2014-2015)"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/video/series/the-cycle"
      }
    ]
  },
