      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/42163#2026-10-06T10:00:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/42163/toddler_tuesdays_1__event_1440__large.jpg"
      }
    ],
    "http://schema.org/isAccessibleForFree": [
