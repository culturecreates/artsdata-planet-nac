      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Fierté au CNA | Série"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/36430/pride-2026-stephany-victorine---header_v2__tablet-small.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à nous au Centre national des Arts pour célébrer la Fierté dans la région de la capitale nationale en août, à l’occasion de l’anniversaire de la première manifestation 2ELGBTQI+ au Canada.\n\nSur la Lanterne Kipnes, Zoli Zour de l’artiste non binaire Stephany Victorine célèbre la joie et la visibilité queer, la non-binarité et la danse colorée de la communauté. Et le 30 août, des membres du personnel du CNA prendront part au défilé de la Fierté dans les rues d’Ottawa..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
