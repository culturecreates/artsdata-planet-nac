    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this video, Andrew Brady (Principal Bassoon, Saint Paul Chamber Orchestra and Los Angeles Chamber Orchestra) works with Darren Hicks (Principal Bassoon, National Arts Centre Orchestra) on developing resonance to project sound efficiently in orchestral playing—without forcing or fatigue. Drawing from vocal techniques and overtone singing, Andrew demonstrates how small changes in tongue position, vowel shape, and resonance focus can dramatically increase clarity, projection, and color..."
      }
