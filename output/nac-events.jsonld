      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/40640"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Deepstaria | Company Wayne McGregor | Apr 7 - 9, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40640/deepstaria_london_deepstaria_2024deepstaria__ravi_deepres__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Shimmering beneath the surface\n\nOn an ink black stage pierced with shafts of lights, nine ethereal dancers push their bodies to extremes in a work of pure dance. Hyper-extended limbs, buckling torsos and complex shifts in speed and pattern create a sculptural physicality. Performed to an AI-driven soundscape that recomposes itself each night, Deepstaria is a total sensory experience.\n\nLondon-based choreographer Sir Wayne McGregor CBE is at the vanguard of the intersection of science and dance, renowned for his fusion of high-velocity physicality..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
