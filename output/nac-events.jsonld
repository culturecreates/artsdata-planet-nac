    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After appearances at Massey Hall and the Montreal International Jazz Festival, Ben Dunnill brings his unmistakable voice, musicianship and magnetic stage presence to the NAC."
      },
      {
        "@language": "fr",
        "@value": "Après être passé par le Massey Hall et le Festival international de jazz de Montréal, Ben Dunnill arrive au CNA avec sa voix unique, sa virtuosité et une présence scénique qui ne laisse personne indifférent."
      }
    ]
