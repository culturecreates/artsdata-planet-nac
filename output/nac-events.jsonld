    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41786/rounded_corner_design_(2)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Auteur-compositeur canadien, Zachary Lucky est reconnu pour son style intemporel à la croisée de la musique folk, country et roots qui lui a valu de multiples mises en nomination. Originaire des Prairies de la Saskatchewan, il crée des chansons imprégnées de lieux, de souvenirs et de la douce résilience du quotidien. Avec sa chaleureuse voix de baryton et ses paroles évocatrices, il est souvent comparé à Gordon Lightfoot et Kris Kristofferson, mais c’est son authenticité et son dévouement qui lui..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
