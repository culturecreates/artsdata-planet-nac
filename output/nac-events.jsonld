      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/42097"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Tommy Emmanuel, CGP avec en invitée spéciale Molly Tuttle  | Tournée Living in the Light |   sam 20 mar 2027, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42097/tommyemmanuel-ottawa-imageonly-3840x2160-credit-to-luiciano-viti__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Salué par l’émission World Cafe de NPR comme « l’un des meilleurs guitaristes acoustiques au monde », Tommy Emmanuel a fait ses premiers pas sur scène à l’âge de six ans, alors qu’il sillonne l’Australie avec le groupe familial. À l’adolescence, il s’impose comme accompagnateur et musicien de studio très convoité. La vingtaine à peine entamée, il joue déjà sur des chansons à succès et monte sur scène avec des groupes comme Air Supply et Men at Work. Fortement inspiré par son idole Chet Atkins,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
