      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NAC Dance"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/dance/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "NAC Dance is here! · The NAC Dance season celebrates the body in movement as a source of vitality and renewal, revealing the very essence of our relationship to the world and the inner power of motion.\n\nCanadian and international choreographic voices bring us works that are sensitive and daring, where movement unfolds like a breath; an open space for listening and transformation. From street dance to kathak, from styles and forms rooted in Indigenous and Cuban traditions to contemporary ballet — our season reveals the richness of cultures and their many ways of affirming and celebrating life."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/dance"
      }
    ]
  },
