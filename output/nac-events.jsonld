    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mois du patrimoine latino-américain | Série"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/42025/lahm-2026---header_v2-no-step_purple__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En octobre, le Canada célèbre le Mois du patrimoine latino-américain. C’est l’occasion de braquer les projecteurs sur l’apport incontournable des communautés latino-américaines et latino-canadiennes à notre société. Au Centre national des Arts, la culture latine est à l’honneur en octobre et toute l’année.\n\nSur la Lanterne Kipnes, Again and Again [Encore et encore] d’Angie Quintanilla Coates revisite les motifs de carreaux mexicains et l’art populaire pour aborder le thème de la répétition comme unique forme de permanence. Une œuvre qui nous..."
      }
    ],
