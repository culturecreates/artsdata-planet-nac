      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Masters in the Hall | Celtic Music for Christmastime |  Tue, Dec 15, 2026, 7:30 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42152/screenshot_2026-09-18_152547__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "North American Irish Fiddle Champion Kyle Burghout joins forces with flute/whistle player Justin Thériault, and Celtic harpist Susan Toman. These three amazing artists will be at the NAC performing a collection of traditional and contemporary Celtic music from Ireland, Scotland, and Canada. The concert will feature music specially selected for the holiday season, with accompanying anecdotes about the history of the tunes and stories from the trio’s travels. This is a rare opportunity for audiences to hear three of Ottawa’s..."
      }
    ],
