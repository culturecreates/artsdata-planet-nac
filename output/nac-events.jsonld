      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "BIG BANG!<br/>The Ambassadors’ Scoop | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/34824/bbseries-dscf8872-avec-accentuation-bruit__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "How would you describe your art? If there were a fire, would you save your instrument or your pet? What do you consider the most beautiful sound in the world?\n\nAs you’ve probably guessed, the kids are in charge! Young people ages 10 to 14 become reporters for a series of offbeat video vignettes. Microphone in hand and curiosity well sharpened, these young people set off to meet a host of artists and interview them live from the effervescent BIG BANG Festival.\n\nFlute player in a major orchestra, sound tinkerer, wild and crazy all-round musician… The interviews are conducted by some amazing young people. Press “Play” now to explore the world of music from an angle that’s as delightful as it is playful!\n\nBilingual ● For all ages ● Free "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
