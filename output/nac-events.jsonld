    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/creation-rever-avec-virginie-brunelle"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Dream with Virginie Brunelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&ldquo;Having the time to create lets you take risks, and that&rsquo;s what creation is all about.&rdquo; Virginie Brunelle, Choreographer, Fables In this interview, choreographer Virginie Brunelle discusses Fables and how utopia and feminism fed into her creation. She also shares how the support provided by the National Arts Centre&rsquo;s National Creation Fund gave her the opportunity to create a large-scale performance.&nbsp; Fables is one of more than 100 works supported by the Fund. It was performed at the NAC during the 2024&ndash;2025 season, as well as on stages worldwide, including at the Lugano Dance Project festival.&nbsp; The Fund empowers Canadian artists to embrace creative risks, explore new forms and make their most ambitious dreams a reality, resulting in innovative performances lauded by audiences across Canada and abroad.&nbsp;"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/d2a980abdaa78df3",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://naccnaca-videos.s3.amazonaws.com/40600/2026-john-storgards-dscf6437_curtis_perry__large.jpg"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-02-09T10:02:00-05:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/25-26-naco-john-storgards-talkback-interview-paul-wells"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "John Storgårds: The accidental conductor"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "John Storg&aring;rds became one of the world&rsquo;s leading conductors almost by accident. He still travels everywhere with his violin. And his favourite composer is the one who trusts musicians enough not to tell them exactly what to do. Last fall, as John Storg&aring;rds returned to the National Arts Centre for his first concerts since being announced as Music Director Designate, journalist Paul Wells sat down with the Finnish maestro for a revealing conversation that went far beyond the usual &ldquo;tell us about your vision&rdquo; platitudes. What emerged was a portrait of an artist whose path to the podium was anything but conventional&mdash;and whose approach to music-making is refreshingly honest, deeply collaborative, and occasionally laugh-out-loud surprising.&nbsp;"
      }
    ]
  },
