      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Spectacles avec interprétation en ASL et en LSQ | Série"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/37150/asl-lsq_series_header__tablet-small.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’offre de spectacles du CNA avec interprétation en ASL (langue des signes américaine) et en LSQ (langue des signes québécoise) rend les arts accessibles aux personnes sourdes, devenues sourdes ou malentendantes. L’interprétation est faite par des spécialistes qui se tiennent près de la scène pour permettre au public de suivre à la fois l’interprétation et l’action. Ces spectacles ont été choisis en fonction des besoins de notre public et s’inscrivent dans notre volonté de mieux servir la communauté. "
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
