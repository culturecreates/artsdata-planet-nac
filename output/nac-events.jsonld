    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/40413#2026-10-22T20:00:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/40413/9169_nac_2627_pops_illustration_3840x2160_starwars__large.jpg"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://nac-cna.ca/genid/67ecf7af65f16792"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://nac-cna.ca/venue/southam-hall#Place"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://nac-cna.ca/genid/44dc49a318c4a88c"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://nac-cna.ca/genid/1487dcb6a9275cf4"
      },
      {
        "@id": "https://nac-cna.ca/genid/0bdcd4661a6031b0"
      },
      {
        "@id": "https://nac-cna.ca/genid/464ede1fc2c77edb"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40413"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@language": "en",
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@language": "en",
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "STAR WARS and beyond The music of John Williams"
      },
      {
        "@language": "fr",
        "@value": "STAR WARS et au-delà La musique de John Williams"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Feel the power of the Force in John Williams’s legendary music from the Star Wars saga! Since the release of the first Star Wars film in 1977, the Rebel Alliance’s quest to defeat Darth Vader’s Imperial Forces has taken the world by storm, inspiring audiences with tales of intergalactic heroism, jaw-dropping special effects, and John Williams’s epic orchestral scores. Now’s your chance to experience five decades of movie magic as conductor Damon Gupton leads the NAC Orchestra in musical selections from nine Star Wars films. Prepare to be blown away by the brassy fanfares of the franchise’s iconic theme, swoon at the exquisite harmonies of Luke and Leia’s theme, and buckle up as the volcanic “Duel of the Fates” fills Southam Hall with cinematic suspense!"
      },
      {
        "@language": "fr",
        "@value": "Ressentez la puissance de la Force grâce aux airs légendaires composés par John Williams pour la saga Star Wars! Dès la sortie du premier Star Wars en 1977, la lutte de l’Alliance rebelle contre les troupes impériales de Darth Vader fait sensation auprès du public avec ses histoires d’héroïsme intergalactique, ses effets spéciaux époustouflants, et, surtout, la trame sonore épique de John Williams. Ne ratez pas la chance de revivre cinq décennies de magie cinématographique avec le chef d’orchestre Damon Gupton qui dirige l’Orchestre du CNA dans une sélection d’airs tirés de neuf films de l’univers Star Wars. Préparez-vous à être soufflés par les fanfares de cuivre emblématiques de la franchise; laissez-vous émouvoir par les harmonies sublimes du thème de Luke et Leia, et accrochez-vous bien pour l’incandescent « Duel of the Fates », qui fera régner le suspense à la Salle Southam!"
      }
    ]
  },
