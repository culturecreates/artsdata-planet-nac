    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "k.d. lang: has always been | A stagewear exhibition | Sep 18 - Oct 4, 2026 | Southam Hall Mezzanine Foyer"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42108/kd-lang_ingenue_art-12__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "To accompany the k.d. lang: has always been tribute event, the NAC Archives is proud to present an exhibition of curated stagewear from k.d. lang's early career highlights, generously loaned by the National Music Centre (NMC). \n\nk.d. lang is not only celebrated for her vocal and artistic excellence, but also her commitment to creative personal expression in all aspects of her life and performance.\n\nThe stagewear presented in this exhibition show the androgynous and imaginative personal style k.d. lang has become famous..."
      }
    ],
