    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mozart, Ravel et Aphrodite Patoulidou  | Avec l'Orchestre du CNA |  31mar- 1 avr 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40416/9169_nac_naco_26_27_batch1_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\n\n\tMéditation lyrique sur l’amour et l’appartenance, symphonie d’ombres et de lumières : ces œuvres mélancoliques et nostalgiques vous apporteront calme et sérénité.\n\tLa dramatique Symphonie no 40 de Mozart a beau être imprégnée d’anxiété et d’intensité, elle finit sur une note de joie et d’extase.\n\tLa créativité d’Aphrodite Patoulidou n’a pas de limites : en plus de ses prestations sur scène, la soprano est également une peintre accomplie, et elle a déjà chanté dans le groupe de métal Igorrr.\n\n\nLe public était..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
