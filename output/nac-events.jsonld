    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Jean-Jacques van Vlasselaer présente l'Orchestre du CNA | NAC Podcasts"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/boiteamusiquecna.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "J.J. Van Vlasselaer a été critique musical auprès du Journal « Le Matin » en Belgique de 1962 à 1968, ensuite auprès de « Le Droit » à Ottawa, de façon ininterrompue depuis 1972. Il parle régulièrement à Radio-Canada et CBC depuis 1973. À la fois par intérêt personnel et professionnel, il a suivi l’existence de l’Orchestre du CNA depuis le premier concert de celui-ci, le 7 octobre 1969. Saison après saison, directeur musical après directeur musical, participant même à certaines tournées, il a pu mesurer l’évolution et l’aventure musicale de l’Orchestre du CNA. Pour ce quarantième anniversaire de l’Orchestre du Centre national des Arts il a préparé six unités couvrant l’évolution de l’orchestre à travers les chefs d’orchestre qui ont marqué ses interprétations, sa programmation, bref : son destin."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/podcasts/show/boite-a-musique"
      }
    ]
  },
