      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/28672/map-susan-aglukark__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this video series, Inuk music icon Susan Aglukark explores her roots and expresses her newfound understanding of her ancestors and her own identity through visual art, poetry, and music.\n\n Susan Aglukark, O.C. grew up in Arviat, Nunavut. In addition to her celebrated career as a musician, she is also an in-demand speaker and facilitator, the founder of the Arctic Rose Foundation, and an advisor on the Collateral Damage Project."
      }
    ],
