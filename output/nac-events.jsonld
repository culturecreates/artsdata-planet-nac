  {
    "@id": "https://nac-cna.ca/fr/video/series/theatre-physics-symposium",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/video/series/theatre-physics-symposium"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Symposium Théâtre et physique | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/29898/entangled-talk_nac_2021_symposium_amber_4089x2160__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Les présentations d’automne du Théâtre anglais venaient mettre la table pour le symposium Théâtre et physique. Mettant en vedette les pièces Copenhagen, Frequencies et Entangled, inspirées de la physique quantique, le symposium offraient également aux spectateurs du CNA une série de conversations parallèles suscitées par les pièces, qui culminaient par une enquête de cinq jours menée par les plus grandes figures pensantes de la physique moderne, ayant comme but de repousser les frontières physiques et psychologiques. La série était animée par Nahlah Ayed, de l’émission Ideas de la CBC.\n\nCe symposium cherchait à établir des liens entre les aspects les plus fascinants et les plus intangibles de la physique et de la psyché humaine, et à les situer à l’intersection de l’esprit et de la matière – le trou noir du cœur humain."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
