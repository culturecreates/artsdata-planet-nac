    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sarah Podemski"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "#ReconcileThis est un mouvement qui mobilise et donne la place aux voix autochtones dans les r&eacute;seaux sociaux tout en c&eacute;l&eacute;brant la culture via des histoires num&eacute;riques, la chanson et la danse. Sarah Podemski confectionne des capteurs de r&ecirc;ves et puise sa force dans une communaut&eacute; d&rsquo;artistes autochtones qui se r&eacute;approprient les traditions et font entendre leurs voix. Sarah Podemski est une artiste pluridisciplinaire anishinaabe et ashk&eacute;naze. Depuis ses d&eacute;buts &agrave; 11 ans dans la s&eacute;rie t&eacute;l&eacute;vis&eacute;e allemande Blue Hawk jusqu&rsquo;&agrave; son r&ocirc;le prim&eacute; dans Mekko, film de Sterlin Harjo s&eacute;lectionn&eacute; au TIFF, la Torontoise cherche &agrave; se r&eacute;approprier les r&eacute;cits autochtones, le 7e art ayant toujours pr&eacute;sent&eacute; un portait d&eacute;form&eacute; des Autochtones. Instagram: @sarahpodemski"
      }
    ]
  },
