    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ambassadeurs - Big Bang Festival"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://cdn.nac-cna.ca/img/bigbang/2026/meta/bigbang_meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Son nom le dit : Big Bang est un festival qui décoiffe ! Avec l'orchestre au grand complet en concert, de drôles de machines à sons à découvrir, un trio de musiciens prêts à jazzer avec des jeunes sur scène, une fanfare fringante, et bien d'autres surprises encore, c'est tout le CNA qui vibrera sous l’effet d’une énergie renversante. Passez nous voir pour une explosion de couleurs et de sons en plein cœur de l'hiver."
      }
    ],
