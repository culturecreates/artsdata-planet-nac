      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Who’s watching when I close my eyes  | National Creation Fund"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-creationfund.s3.amazonaws.com/41643/header_2_qui_regarde_quand_je_ferme_les_yeux__hero_large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Who’s watching when I close my eyes is a reflection on the invisible forces that shape both our inner worlds and our collective actions. What unconscious forces are at play? Why do I, despite longing for freedom, keep doing the same thing and endlessly repeat the same patterns? And why do we as a society, despite our desire to evolve, find ourselves repeating past mistakes and re-enacting the same human dramas?  \n\nWho’s in charge? What drives our..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
