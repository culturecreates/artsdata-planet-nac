  {
    "@id": "https://nac-cna.ca/en/video/series/indigenous-theatres-days-of-truth-and-reconciliation-2021",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/video/series/indigenous-theatres-days-of-truth-and-reconciliation-2021"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Days of Truth and Reconciliation | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/29751/tnr_event2_beyond_land_v2__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Indigenous Theatre at the NAC is proud to present a collection of virtual offerings for people of all ages to observe Orange Shirt Day and the first ever National Day for Truth and Reconciliation. These offerings highlight the strength and resilience of Indigenous cultures. They aim to educate both students and the general public about the effects of colonialism and the repercussions of residential schools on Indigenous peoples. \n\nIndigenous Theatre’s week of Truth and Reconciliation is a time to tell our stories.\n\n\n“Our programming is an opportunity to educate and share the truths of Indigenous peoples with the rest of the country because, without truth there can be no reconciliation. These activities help us reclaim the things that residential schools tried to erase. The Day for Truth and Reconciliation is also a time to celebrate, to tell our stories and share the beauty and vibrancy of our communities. Our hope is that these educational offerings will shed light on how folx outside of the Indigenous community can support us and walk with us moving forward.”\nKevin Loring, Artistic Director of NAC Indigenous Theatre"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
