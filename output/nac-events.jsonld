    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/32133/igniting-creativity-inclusive-arts-2022__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This series will inspire artists and educators to ignite learning and creativity through the arts! \n\nThrough webinars and video resources showcasing national and international leaders in Teachers Artistry and arts education, participants will learn practical skills and new ways of engaging with diverse communities. The series will address challenges within the field of arts learning while highlighting exciting and innovative opportunities for Teaching Artists, Educators, and those interested in engaging in this work.\n\nTarget audience\n\nTeaching Artists, Artist Educators and Community Artists;\n\nStudents enrolled in arts Bachelor and graduate programs who may be interested in the field; and\n\nAdministrators who employ Teaching Artists looking for professional development resources."
      }
    ],
