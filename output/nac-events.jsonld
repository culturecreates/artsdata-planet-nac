    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NAC English Theatre\n \n \n  | Learn and Engage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/assets/img/season2020/meta/englishtheatre_meta_image_en.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "“In the past few years there has been a seismic shift in the way Canadians see our world and the way our theatre makers imagine the stories and perspectives within it. The debates happening around Canadian dinner tables are being reflected on Canadian stages, illuminated by intelligence, mischief and wit.”"
      }
    ],
