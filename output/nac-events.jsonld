    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Dancing Disability Pride | Celebrate International Day of Persons with Disabilities with us! |  Thu, Dec 3, 2026, 12:00 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42477/propellerdance_spasticus_andrewbalfour_4__large.jpg"
