    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Entretien avec Derek McCormack et Micah Lexier : art, texte et collaboration   | présenté par la Bibliothèque publique d’Ottawa |   mer 25 nov 2026, 19 h 00|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42350/ic_cropped__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous aimeriez savoir comment les mondes de l’art et de la littérature se rejoignent dans la création? Soyez des nôtres avec Derek McCormack et Micah Lexier pour une discussion décontractée sur l’art au Centre national des Arts, organisée par la Bibliothèque publique d’Ottawa. Préparez-vous à une conversation animée entre deux amis qui sortent des sentiers battus et qui échangeront leurs réflexions sur des projets communs, tels que City of Letters (2024), I Am The Coin (2010) et une série d’œuvres multiples astucieuses..."
      }
    ],
