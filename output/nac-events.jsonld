    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L’Orchestre du CNA\n \n \n \n \n  |  Events"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-assets.s3.amazonaws.com/season/2026-2027/meta/orchestra/26-27_meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ressentez toute l’énergie et la puissance de la musique avec l’Orchestre du CNA ! La programmation 2026-2027 vous réserve des concerts électrisants éveillent les émotions: des classiques intemporels, des créations audacieuses, des soirées Pops incontournables, des films à grand succès en cinéconcert et des expériences inoubliables en famille. Faites l’expérience de l'Orchestre du CNA en personne et repartez la tête pleine de souvenirs sensationnels."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/orchestra/events/all"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/fr/orchestra/learn",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/orchestra/learn"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L’Orchestre du CNA\n \n \n \n \n  | Apprendre et partager"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/assets/img/season2020/meta/orchestra_meta_image_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "« En 2019, nous célébrons les 50 ans de l’Orchestre du CNA à grand renfort de classiques indétrônables, d’artistes invités de renommée mondiale, de concerts pop familiaux et de spectacles pour enfants. À l’image de ce demi-siècle, qui fut rempli de moments inoubliables et de temps forts artistiques, notre saison-événement 2019–2020 sera une autre belle occasion de donner vie au merveilleux répertoire classique en votre compagnie. »"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/orchestra/learn"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/fr/canada150tour/prairies",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/canada150tour/prairies"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Provinces des Prairies  | Tournée Canada 150 de l’Orchestre du cna Canada 150"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_prairies_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Du 19 au 28 octobre, l’Orchestre du Centre national des Arts poursuit sa Tournée Canada 150 avec des concerts à Winnipeg, Saskatoon, Calgary et Edmonton. La Tournée, qui s’inscrit dans le cadre des célébrations du 150e anniversaire de la Confédération, s’adresse aux mélomanes de tous âges et aux jeunes artistes.\n\nIl s’agit de la première tournée de l’Orchestre du CNA sous la conduite de son populaire directeur musical, Alexander Shelley. Elle mettra en vedette le pianiste canadien renommé Jan Lisiecki et la violoniste de l'orchestre du CNA Jessica Linnebach."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/canada150tour/prairies"
      }
    ]
  },
