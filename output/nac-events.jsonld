    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Programme de mentorat de l’OCNA | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/32282/naco-mentorship-06-10-22-rite-of-spring_credit_curtis-perry_dscf8735__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’Orchestre du CNA lançait en juin 2022 son Programme de mentorat avec le slogan « À vous de jouer ». Cette initiative annuelle fait le pont entre la fin des études en musique orchestrale et l’obtention d’un poste au sein d’un orchestre professionnel. Pour les artistes sur le circuit des auditions et les instrumentistes en début de carrière, le Programme de mentorat de l’OCNA est une belle occasion de faire connaissance et de jouer avec les membres d’un des plus grands orchestres en Amérique du Nord. Chaque personne participant au programme peut aiguiser ses compétences grâce à du mentorat personnalisé avec les membres de l’Orchestre du CNA et étendre son réseau professionnel auprès de la talentueuse équipe administrative de l’ensemble.\n\nÉcoutez les rétroactions des personnes participantes au sujet de l’Orchestre, du mentorat et des opportunités extraordinaires."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
