      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/fr/video/tomson-highway-on-rose-beauty-and-the-future-of-indigenous-storytelling"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tomson Highway sur Rose, la beauté et l’avenir des récits autochtones"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Figure majeure de la dramaturgie canadienne, Tomson Highway revient en compagnie de Kevin Loring, directeur artistique du Th&eacute;&acirc;tre autochtone du CNA, sur Rose, troisi&egrave;me et dernier volet de son c&eacute;l&egrave;bre cycle amorc&eacute; avec The Rez Sisters et Dry Lips Oughta Move to Kapuskasing. Il parle de ce qui a guid&eacute; l&rsquo;ensemble de son &oelig;uvre et de l&rsquo;avenir qu&rsquo;il entrevoit pour les r&eacute;cits autochtones.&nbsp; Officier de l&rsquo;Ordre du Canada et titulaire de 11 doctorats honorifiques, Tomson Highway m&egrave;ne une carri&egrave;re internationale de dramaturge, romancier, pianiste et auteur-compositeur."
      }
    ]
  },
