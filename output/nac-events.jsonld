    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Mani reçoit Jérémie Niel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "From time to time during the French Theatre season, Artistic Director Mani Soleymanlou invites a guest artist to chat with him in front of a live audience. These &ldquo;Grandes rencontres conviviales&rdquo; are an opportunity to hear artists express themselves and share their thoughts freely. The sessions are recorded live and released as podcasts&nbsp;to complement French Theatre&rsquo;s programming. On February 27, 2025, Mani Soleymanlou sat down with director J&eacute;r&eacute;mie Niel, founder of the theatre company P&eacute;trus, before the premiere of&nbsp;Au c&oelig;ur de la rose (G&eacute;n&eacute;alogie d&rsquo;une tristesse), a poetic play written by one of Quebec&rsquo;s most celebrated cinema artists, Pierre Perrault."
      }
    ]
  },
