      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "#ReconcileThis Timmins"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "&Agrave; Timmins, Mike Metawabin a collabor&eacute; avec Simon Amb&uuml;hl et Dr. Manuel Menrath pour cr&eacute;er une magnifique exp&eacute;rience audiovisuelle. Son po&egrave;me, Hounds of St. Anne&rsquo;s, a &eacute;t&eacute; mis en musique pour d&eacute;peindre les s&eacute;quelles profondes laiss&eacute;es par les pensionnats autochtones. Intitul&eacute; Songs of the Land, ce projet collaboratif transatlantique m&ecirc;le po&eacute;sie, musique et narration visuelle pour gu&eacute;rir les traumatismes culturels."
      }
    ]
  },
