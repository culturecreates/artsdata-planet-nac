    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/video/series/sphere-arctic-imagination"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "SPHERE: Arctic Imagination | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/31973/sphere-card-arctic-imagination__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Arctic Imagination is a multi-year, interdisciplinary transatlantic collaboration between cultural institutions, libraries, and museums that sheds light on the transformation of the Arctic as a powerful symbol, an inspirational landscape, and a geopolitical factor. In 2017-2018, national libraries in Nuuk, Copenhagen, Stockholm, and Oslo, together with the New York Public Library, combined their creativity, experience, and archives to create a joint platform for discussing one of today’s most pressing issues: the melting ice in the Arctic region and the impact of climate change on human civilization.\n\nCo-hosted by the Royal Danish Library and the NAC Orchestra as part of SPHERE, the second edition of this ambitious international collaboration is a not-to-be-missed speaker series focusing on the implications of climate change and a warming North for geopolitics and human civilization as we know it.\n\nPresented as part of the NAC Orchestra’s SPHERE Festival in September 2022."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/series/sphere-arctic-imagination"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/video/series/canada-jazzahead",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
