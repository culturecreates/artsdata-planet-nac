      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "http://naccnaca-meta.s3.amazonaws.com/canada150tour/meta_image_western_fr.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Du 30 octobre au 3 novembre, l’Orchestre du Centre national des Arts poursuit sa Tournée Canada 150 avec des concerts à Victoria et Vancouver. La Tournée, qui s’inscrit dans le cadre des célébrations du 150e anniversaire de la Confédération, s’adresse aux mélomanes de tous âges et aux jeunes artistes.\n\nIl s’agit de la première tournée de l’Orchestre du CNA sous la conduite de son populaire directeur musical, Alexander Shelley. Elle mettra en vedette le pianiste canadien renommé Jan Lisiecki."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
