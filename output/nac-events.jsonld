      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Le Projecteur spotlights artists from Canada's Francophone community"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Under the leadership of Xavier Forget, a producer with the NAC&rsquo;s Popular and Variety Music department, Le Projecteur offers Francophone artists a unique support system: mentoring, professional rehearsal spaces, and comprehensive guidance to help them hone their craft with confidence."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/63920641d09111e5",
