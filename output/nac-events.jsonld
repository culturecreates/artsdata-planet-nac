      {
        "@language": "fr",
        "@value": "Vous &ecirc;tes convi&eacute;s &agrave; vivre des exp&eacute;riences partag&eacute;es &agrave; travers des &oelig;uvres qui nous refl&egrave;tent, nous bousculent et nous habitent. Le Th&eacute;&acirc;tre fran&ccedil;ais comme espace public vivant pour ralentir et se laisser traverser par des formes audacieuses port&eacute;es par des voix fortes et singuli&egrave;res. Choisissez ce qui vous interpelle et soyez des n&ocirc;tres."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
