    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Projecteur fait rayonner les artistes de la francophonie canadienne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous l&rsquo;&eacute;gide de Xavier&#8239;Forget, producteur au sein de Musique populaire et vari&eacute;t&eacute;s du CNA, Le Projecteur offre aux artistes francophones d&rsquo;ici un encadrement unique&#8239;: mentorat, espaces de r&eacute;p&eacute;titions professionnels et accompagnement complet pour perfectionner leur art avec assurance."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/e7341ffae0439469",
