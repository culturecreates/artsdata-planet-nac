    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The name says it all: the Big Bang Festival will blow your socks off! The full NAC Orchestra will be performing, accompanied on stage by all kinds of weird sound machines, three virtuoso jazz musicians in an interactive and youthful take on Miles Davis, a dynamic marching band, and all kinds of other surprises. All of this energy at the NAC will put some much-needed colour into the winter doldrums."
      }
