    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Autel du jour des Morts  | Présenté par l’ambassade du Mexique au Canada, en collaboration avec UNAM-Canadá et la Modern American School de Mexico |  30oct- 2 nov 2026|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42241/1_altar__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "El español sigue al texto francés\n\nLe Centre national des Arts célèbre le jour des Morts pour la première fois avec un autel traditionnel présenté par l’ambassade du Mexique au Canada, en collaboration avec UNAM-Canadá et la Modern American School de Mexico.\n\nÉrigé en hommage aux proches disparus, cet autel offre une occasion unique de découvrir l’une des traditions culturelles les plus emblématiques du Mexique. Riche en couleurs, en symboles et en significations, il témoigne d’une tradition qui célèbre la mémoire, la..."
      }
    ],
