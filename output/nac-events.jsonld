      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Versus | National Creation Fund"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-creationfund.s3.amazonaws.com/41110/versus_face_only_2000x1000__hero_large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Versus is a lovingly biting theatrical whirlwind examining contemporary daily life, as experienced by our birthday boy Gerald. Today, everything feels off. Everything is just too much. So maybe you could help him with breakfast? Give life advice to his kids? Can someone else walk his dog? Help him get out of his birthday party?\n\nAs Gerald moves through his day, he’s getting help from, and checking in with the audience constantly: how are you living right? Is this how I do it? It matters..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
