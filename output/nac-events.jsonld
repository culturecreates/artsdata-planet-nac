    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "The Diviners  | D’après le roman de Margaret Laurence. Texte de Vern Thiessen avec Yvette Nolan |  12-23 jan 2027|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40380/the_diviners_dhou-1237__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une coproduction du Théâtre autochtone du CNA et du Théâtre anglais du CNA \nProduction originale du Festival de Stratford  \n\nCertaines vérités ne font surface qu’avec une plongée dans le passé.  \n\nLorsqu’après une dispute, l’écrivaine Morag Gunn voit Pique, sa fille de 18 ans, partir en claquant la porte pour se mettre à la recherche de ses racines métisses, elle replonge dans ses souvenirs d’enfance et s’interroge sur le village où elle a grandi. Dans cette adaptation qui alterne habilement entre passé et présent..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
