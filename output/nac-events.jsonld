    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/it-rosanna-deerchild-kevin-loring-interview"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Rosanna Deerchild turns family trauma into powerful Indigenous theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Award-winning Cree writer, broadcaster, and poet Rosanna Deerchild has spent her life sharing Indigenous stories. As the daughter of a residential school survivor, she&rsquo;s witnessed firsthand how trauma ripples through families&mdash;and how truth-telling can break those cycles.&nbsp; Rosanna talks about her acclaimed play The Secret to Good Tea, how humour and storytelling help deal with pain and support healing, and why Indigenous voices are essential to Canada&rsquo;s path toward reconciliation. Learn more about The Secret to Good Tea in the program notes and resources."
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/genid/2cd7834565e487b2",
    "@type": [
