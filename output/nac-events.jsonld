      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vos musiciens populaires favoris partagent la scène avec l’Orchestre du CNA. Profitez de cette chance unique de voir vos artistes canadiens préférés en concert avec l’orchestre de calibre mondial du CNA. Les riches arrangements orchestraux et le paysage sonore multidimensionnel font des Sessions une expérience musicale à nulle autre pareille!"
      }
    ],
