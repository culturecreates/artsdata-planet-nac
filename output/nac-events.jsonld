    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate Disability Pride with us!\n\nThe National Arts Centre celebrates the International Day of Persons with Disabilities with a punky, chaotic, colourful flash mob created and performed by Propeller Dance!\n\nFeaturing Propeller Dance Company dancers, education program dancers, and musicians, this raw, rollicking takeover brings Ian Dury’s rebellious anthem Spasticus Autisticus to life, choreographed by Elizabeth Winkelaar.\n\nAnd we’re not stopping at the final beat! The performance explodes into a dance party, and everyone in the audience is invited to join the fun.\n\nCome..."
      }
    ],
