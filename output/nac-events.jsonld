    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Leaving Home | By David French | Mar 19 - 27, 2027 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40377/andrew_musselman_and_lou_campbell_barry_mccluskey__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A Matchstick Theatre Production\n\nLike father. Not like sons.\n\nMeet the Mercers, a Newfoundland immigrant family living in 1950s Toronto who are struggling to redefine themselves and find common ground. On the eve of 17-year-old Bill’s shotgun wedding, tensions erupt between parents Jacob and Mary and their two sons, Ben and Bill. Ben finds himself railing against his father’s harsh expectations and cruel treatment while searching for his own sense of self and identity. Will the pressure boil over or can this..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
