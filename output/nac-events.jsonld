      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Named after the National Art Centre’s founding general director, G. Hamilton Southam, it is the largest and most majestic of our four performance halls. Home to the NAC Orchestra, it’s an ideal venue to support large-scale productions for a variety of performances and events, including Broadway musicals, ballet, opera, concerts, comedy, ceremonies and films."
      }
    ],
