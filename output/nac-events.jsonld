      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "SLAM et création littéraire : textes en 3D avec YAO | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/29520/map-yao-3-sauter__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans cette série en quatre parties, YAO partage des façons créatives de stimuler l’imagination, éliminer les obstacles et vaincre l’anxiété de la page blanche, tout en façonnant et structurant son travail. Ces techniques peuvent être utilisées par quiconque s’intéresse à l’écriture, et s’appliquent à plusieurs genres (fiction, théâtre, poésie, scénarios de film, essais, et autres genres non romanesques).  \n\nYAO est un interprète primé qui anime des ateliers pour élèves et artistes professionnels depuis plus d’une dizaine d’années. Il a reçu le Prix des artistes éducateurs de la Fondation des arts de l’Ontario en 2018. "
      }
    ],
