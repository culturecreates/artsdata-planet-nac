    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Irish Descendants Tribute to Stan Rogers"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Irish Descendants’ tribute to Stan Rogers is a heartfelt celebration of one of Canada’s most enduring songwriters. Rooted in deep respect and a shared musical lineage, the album honours Rogers’ powerful storytelling and the timeless themes of sea, land, and community that resonate so strongly in Newfoundland and Labrador. With rich arrangements, warm harmonies, and performances by Rowan Sherlock, Jeff Kinsman, Madeline Carter, and Con O’Brien, the project carries Rogers’ legacy forward for new listeners while offering longtime fans a fresh, lovingly crafted interpretation. This performance and album stand as both a thank‑you and a continuation—keeping these iconic songs alive, connected, and sung with pride."
      }
    ]
  },
