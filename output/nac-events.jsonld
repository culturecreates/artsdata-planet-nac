    ],
    "http://schema.org/url": [
      {
        "@id": "https://nac-cna.ca/en/event/41694#2026-10-20T20:00:00-04:00"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://naccnaca-eventimages.s3.amazonaws.com/41694/rounded_corner_design__large.png"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://nac-cna.ca/genid/41d5db2caca664f0"
      }
    ],
    "http://schema.org/location": [
