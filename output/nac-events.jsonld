    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Bach: The Brandenburg Concertos | with James Ehnes | Mar 17 - 18, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40389/9169_nac_naco_26_27_batch1_10__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know ...\n\n\n\tMusic that has long inspired joy, awe, and wonder, J. S. Bach’s Brandenburg Concertos transform the NAC Orchestra musicians into a rotating cast of soloists.\n\tCanadian violinist James Ehnes, a Southam Hall favourite, performs double duty on this program—leading the orchestra and performing as a soloist!\n\n\nIn 1721, Johann Sebastian Bach compiled six of his favourite “concertos for several instruments” and mailed them to the Margrave of Brandenburg in the hopes of receiving a job at the..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
