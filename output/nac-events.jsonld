    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "BIG BANG! Cartes postales musicales  | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/28094/musicalpostcards_event_1440x810__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Livraison spéciale\n\nLes cartes postales musicales sont là pour rester! Développées lors de l’édition numérique du festival en 2021, elles vous transportent à nouveau d'un bout à l’autre du pays.\n\nOù que vous soyez, il vous suffit d’appuyer sur “play” pour aller à la rencontre de musiciens et de musiciennes le temps d’une vignette musicale concoctée juste pour vous. \n\nEt voilà, c’est parti pour un voyage tout en douceur...\n\n \n\nMultilingue ● Pour tous ● Gratuit"
      }
    ],
