    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/in-conversation-with-the-new-artistic-director-of-the-royal-winnipeg-ballet"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ballet as a language: A chat with Christopher Stowell"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "NAC Dance Executive Producer Caroline Ohrt had the pleasure of sitting down with a major force in the ballet world: Christopher Stowell, the newly appointed Artistic Director of Canada&rsquo;s Royal Winnipeg Ballet. In this conversation, Christopher shares insights&nbsp;into his artistic vision for the RWB and the creative path that has defined his career. Christopher&rsquo;s journey through dance is nothing short of remarkable. From his celebrated years as a Principal Dancer with the San Francisco Ballet to his influential leadership roles at Oregon Ballet Theatre and the National Ballet of Canada, he has spent decades shaping the art form across North America and beyond. His work as a choreographer and artistic leader reflects a deep passion for both classical traditions and contemporary innovation, bringing fresh perspectives to every stage he touches."
      }
    ]
  },
  {
