    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "L’imagination de l’avant : Contact, inspiration et apprentissage | Série vidéo"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/28525/invoking-the-imagination-soundscapes-thumb__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Samantha Whelan Kotkas partage des stratégies éprouvées et des idées pour un apprentissage collaboratif axé sur les arts. Ces idées de renforcement communautaire appuient le développement d’un lien personnel avec les arts chez les gens de tous les âges.\n\nSamantha Whelan Kotkas est une interprète et artiste enseignante établie à Calgary, en Alberta. Comme musicienne et conteuse, elle a un don pour jumeler musique et récit afin de créer des expériences magiques et mémorables.\n\nEn savoir plus : Programme Vive la musique"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
