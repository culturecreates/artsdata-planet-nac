    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Ottawa Jazz Orchestra Grit N’ Groove"
      },
      {
        "@language": "fr",
        "@value": "Orchestre de Jazz d'Ottawa Grit N’ Groove"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Ottawa Jazz Orchestra, featuring vocalist Diane Nalini, serves up an electrifying evening with fresh, heavy-hitting jazz and funk arrangements of classic rock and pop anthems you know and love. From the deep, gritty grooves of Stevie Wonder and Tower of Power to mind-blowing, horn-heavy reinventions of rock icons like Guns N' Roses, Peter Gabriel, and Metallica, get ready for a bold and brassy night of music to help shake off the winter chill."
      },
      {
        "@language": "fr",
        "@value": "L'Orchestre de Jazz d'Ottawa, avec la chanteuse Diane Nalini, vous propose une soirée électrisante avec des arrangements jazz et funk percutants et originaux de grands classiques rock et pop. Des rythmes profonds et puissants de Stevie Wonder et Tower of Power aux réinterprétations cuivrées époustouflantes d'icônes du rock comme Guns N' Roses, Peter Gabriel et Metallica, préparez-vous à une soirée musicale audacieuse et cuivrée, idéale pour chasser le froid hivernal."
      }
    ]
  },
