    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "WAR On The Catwalk"
      },
      {
        "@language": "fr",
        "@value": "WAR On The Catwalk"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Murray & Peter Present the return of WAR On The Catwalk hosted by Alyssa Edwards! Get ready for your favorite queens performing live on stage. We’ve got Myki Meeks, Jane Don’t, Darlene Mitchell, Juicy Love Dion, Silky Ganache, Discord Addams and Aurora Matrix. The Meet & Greet starts at 6pm. Please note that the M&G is an add-on ticket. The show starts at 8pm. There will be a 20-minute intermission."
      },
      {
        "@language": "fr",
        "@value": "Murray & Peter vous présentent le retour de WAR On The Catwalk, animé par Alyssa Edwards! Préparez-vous à voir vos reines préférées se produire en direct sur scène. Au programme : Myki Meeks, Jane Don’t, Darlene Mitchell, Juicy Love Dion, Silky Ganache, Discord Addams et Aurora Matrix. La séance de rencontre avec les artistes commence à 18 h. Veuillez noter que cette séance nécessite l’achat d’un billet supplémentaire. Le spectacle commence à 20 h. Il y aura un entracte de 20 minutes."
      }
    ]
