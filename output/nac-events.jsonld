    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Le Projecteur: Resident Artist Mélissa Ouimet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Musicians rarely have the luxury to fine tune their performances prior to a tour. Instead, they often figure it out on the road. The NAC Projecteur program is an artistic residency that aims to empower artists to refine their craft to help navigate the music industry with confidence. Franco-Ontarian singer-songwriter M&eacute;lissa Ouimet speaks about the luxury of participating in the NAC Projecteur program.&nbsp;"
      }
    ]
  },
  {
