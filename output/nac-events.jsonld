    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Pianist Marc-André Hamelin is widely associated with expanding the piano repertoire, regularly performing works by composers such as Alkan and Medtner alongside major works. He has received multiple international recording awards and is also an active composer. His recital programs often pair landmark repertoire with rediscovered pieces. The result is a program built on range and rarity, not just familiarity. A piano evening shaped by the depth of the repertoire."
      }
    ],
