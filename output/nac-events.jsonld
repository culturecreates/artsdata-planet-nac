    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccna-venues.s3.amazonaws.com/22/nac-southam-hall-hero__hero_large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Nommée en l’honneur du premier directeur général du CNA, G. Hamilton Southam, cette salle de spectacles est la plus vaste et la plus prestigieuse du Centre. En plus d’accueillir l’Orchestre du CNA, c’est un lieu d’exception pour toute une gamme de spectacles et d’événements à grand déploiement, tels comédies musicales de Broadway, ballets, opéras, concerts, spectacles d’humour, galas, cérémonies et films."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
