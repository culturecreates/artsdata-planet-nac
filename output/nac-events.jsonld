    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kleztory"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "With a dazzling stage presence, Kleztory combines the emotion and warmth of klezmer music with a feverish energy that transports audiences into a musical trance. From Europe to Asia and the Americas, the group offers a unique sonic experience and concerts that leave a lasting impression. Kleztory is an explosive meeting of cultures (Russian, Québécois, Canadian), backgrounds (academic and self-taught), and musical influences (classical, jazz, blues, folk). Driven by a deep passion for klezmer, these virtuoso musicians breathe new life into this spirited and deeply moving music. Their respect for tradition—paired with bold creativity—shines through original arrangements and never-before-released compositions. Brilliant, energetic, emotional: Kleztory simply must be experienced live."
      }
    ]
  },
