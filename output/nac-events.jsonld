    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-videos.s3.amazonaws.com/37762/yt_thumbnail_-_timmins__meta.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In Timmins, Mike Metawabin collaborated with Simon Ambühl and Dr. Manuel Menrath to create a powerful audiovisual experience. His poem, “Hounds of St. Anne’s,” was paired with music to reflect on the deep impact of residential schools. The project evolved into Songs of the Land, a transatlantic collaboration blending poetry, music, and visual storytelling to address cultural trauma and healing."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
