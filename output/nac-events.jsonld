    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Explorez une saison de danse où chaque geste ouvre un monde d’imaginaire, de vitalité et d’émotion.\n\nNous vous convions à explorer des œuvres ambitieuses, qui nous habitent individuellement et collectivement."
      }
