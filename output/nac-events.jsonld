        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/series/national-indigenous-history-month"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mois national de l’histoire autochtone | Série"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-packages.s3.amazonaws.com/28829/nac_ck_prores_lantern_(0-03-43-19)__tablet-small.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En juin comme toute l’année, nous célébrons les communautés, les cultures et les perspectives des Premières Nations, des Inuits et des Métis.\n\nÀ l’occasion du Mois national de l’histoire autochtone, les artistes autochtones sont à l’honneur dans une programmation vibrante réunissant spectacles, ateliers participatifs, activités gratuites inspirées des pow-wow et l’incontournable Marché estival d’artisanat autochtone.\n\nSur la Lanterne Kipnes, naedè; migration, un court métrage d’animation en 3D de l’artiste déné Casey Koyczan, fait dialoguer esthétique futuriste et récit traditionnel pour imaginer de..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ],
