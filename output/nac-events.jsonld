      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Creating UAQUE | Video series"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-series.s3.amazonaws.com/37250/vlcsnap-2024-08-27-10h45m42s848__meta.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "SPHERE 2024 opens in a spectacular fashion with a brand-new piece co-commissioned by NAC Dance and the NAC Orchestra. UAQUE—choreographed by multidisciplinary artist Andrea Peña, uniquely fuses dance, music and visual art. Meaning “kin, relative, neighbour, friend” in the Indigenous Muisca language from Peña’s native Colombia, UAQUE will take audiences on a contemplative and immersive journey through dance. The piece sets ten performers against a backdrop of stirring photographs by renowned Canadian artist Edward Burtynsky and orchestral selections by the NAC Orchestra led by Alexander Shelley, alternating with works by electronic music producer and composer Eƨƨe Ran. \n\nIn this video series, Andrea speaks about the creative process and themes found in this piece which invites audiences to reflect on a place of communion between humanity and the earth. \n\nPhoto credit: Thjorsá River #2, Southern Region, Iceland (2012) by Edward Burtynsky"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/video/series/uaque"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/video/series/grand-acts-of-theatre",
    "http://ogp.me/ns/fb#app_id": [
