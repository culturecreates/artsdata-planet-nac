    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Charles Dickens performs A Christmas Carol | By John D. Huston |  Wed, Dec 2, 2026, 7:30 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42275/charles_dickens__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "This December, rediscover the magic of Christmas Past.\n\n“Powerful one-man theatre…in the hands of a master storyteller.” National Post\n\nExperience A CHRISTMAS CAROL as its author first told it.\n\n“I loved this show & urge all to see it” Ottawa Sun\n\nJohn D. Huston’s celebrated re-enactment of Charles Dickens’ tour-de-force performance of A CHRISTMAS CAROL returns December 2nd to the candle lit intimacy of the Fourth Stage. A venue it sold out annually from 2002 - 2015. Now in its 35th season Huston performs..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
