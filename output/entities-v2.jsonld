  {
    "@id": "https://nac-cna.ca/en/event/40380#2027-01-13T19:30:00-05:00",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Diviners: Based on the novel by Margaret Laurence. Text by Vern Thiessen with Yvette Nolan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Vern Thiessen and Yvette Nolan&rsquo;s powerful version of Margaret Laurence&rsquo;s 1974 classic uses breathtaking theatricality, songs and dance to helps us imagine what a common future shaped by reconciliation could look like, if we choose to embrace it.&nbsp; &nbsp;"
      }
    ],
