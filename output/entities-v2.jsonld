      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join House of PainT as they kick off their 2026 festival with Ottawa’s largest and most competitive poetry slam, the OG500. This intense head-to-head competition hosts some of the city’s most talented poets facing off in a three-round competition for a grand prize of $500.\n\nNo props, no musical accompaniment, no costumes. Just pure poetry! The event is judged by the audience for a few rounds and then goes to a guest judge.\n\nJoin us this year as we collaborate with the NAC..."
      }
    ],
