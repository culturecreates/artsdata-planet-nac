      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/40380"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Diviners | Based on the novel by Margaret Laurence. Text by Vern Thiessen with Yvette Nolan | Jan 12 - 23, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40380/the_diviners_dhou-1237__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "An NAC Indigenous Theatre/NAC English Theatre Co-production\nOriginally produced by the Stratford Festival \n\nSome truths surface only when you dive into the past. \n\nWhen, after a fight with her mother, 18-year-old Pique storms out of the house in search of her Métis roots, Morag Gunn is left to write the novel that will unearth childhood memories and the truth about the town where she grew up. Flowing seamlessly between past and present, this adaptation exhumes and intertwines the stories of Pique’s ancestors— both the Red River Métis and the Highland Scots. By weaving together personal memory with collective history, the play looks at how communities carry both trauma and resilience..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40380"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/event/40380#2027-01-12T19:30:00-05:00",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Diviners: Based on the novel by Margaret Laurence. Text by Vern Thiessen with Yvette Nolan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Vern Thiessen and Yvette Nolan&rsquo;s powerful version of Margaret Laurence&rsquo;s 1974 classic uses breathtaking theatricality, songs and dance to helps us imagine what a common future shaped by reconciliation could look like, if we choose to embrace it.&nbsp; &nbsp;"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Theatre"
      },
      {
        "@language": "en",
        "@value": "Drama"
      },
      {
        "@language": "en",
        "@value": "Storytelling"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://nac-cna.ca/genid/35b3c95c7c3d9c9f"
      },
      {
        "@id": "https://nac-cna.ca/genid/3963147eb97fa56a"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://nac-cna.ca/venue/theatre#Place-2027-01-12T19:30:00-05:00"
      }
