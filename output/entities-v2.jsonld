    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Storgårds & Hewitt | With the NAC Orchestra | Jan 27 - 28, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40402/9169_nac_naco_26_27_batch1_9__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know ...\n\n\n\tExplore the romance and passion of Robert Schumann’s Piano Concerto, one of the composer’s many musical love letters to his wife, Clara.\n\tSuperstar pianist Angela Hewitt returns home to Ottawa to deliver an intimate, heartfelt performance of Schumann’s concerto.\n\tDon’t miss a rare chance to hear Canadian composer Jean Coulthard’s First Symphony, a work of gripping drama that hasn’t been performed in full in 75 years!\n\n\nWhen Robert Schumann married the celebrated pianist-composer Clara Wieck, he had only..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40402"
      }
    ]
  },
