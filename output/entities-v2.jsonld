    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Comeback | By Trish Cooper and Sam Vint | Nov 26 - Dec 5, 2026 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40386/the-comeback-concept-final_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A co-production with The Citadel Theatre (Edmonton)\n\nA love story. With baggage.\n\nThe Comeback, written by real-life married couple Trish Cooper and Sam Vint, is a funny, honest, and nuanced look at what happens when families from different backgrounds collide. The play follows Adam, a Métis writer navigating identity and family history, and his settler wife, Jesse. When Adam and Jesse's surprise pregnancy brings their Métis and settler families closer together, long-buried tensions bubble to the surface.\n\nNot quite fact, not quite fiction,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://nac-cna.ca/en/event/40386"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/en/event/40386#2026-11-26T19:30:00-05:00",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Comeback: By Trish Cooper and Sam Vint"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "When Adam and Jesse&rsquo;s surprise pregnancy brings their M&eacute;tis and settler families closer together, long-buried tensions bubble to the surface. The Comeback, written by real-life married couple Trish Cooper and Sam Vint, is a funny and deeply personal look at what happens when families from different backgrounds collide. Join Adam and Jesse as they learn how to communicate, set boundaries, and enjoy chaotic family gatherings.&nbsp;"
      }
    ],
