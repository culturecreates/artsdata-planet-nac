      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ottawa Jazz Orchestra | Heatwave Hits | May 29, 2027  | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41713/heatwave_hits__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Welcome the arrival of warmer weather with a vibrant, feel-good celebration with the Ottawa Jazz Orchestra. This joyous concert, featuring vocalist Diane Nalini, takes the ultimate warm-weather pop and R&B hits and flips them into fresh, swinging, and deeply funky big band arrangements. Featuring sun-drenched reinventions of classics by artists such as Earth, Wind & Fire, Michael Jackson, Chicago, and Chaka Khan, this breezy, toe-tapping program is the perfect soundtrack for a spring evening. Come ready to groove as the..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
