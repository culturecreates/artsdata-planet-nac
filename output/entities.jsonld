    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Hilary Hahn, Storgårds et Tchaïkovsky  | Avec l'Orchestre du CNA |  26-27 mai 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40424/9169_nac_naco_26_27_batch1_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\n\n\tLa dernière symphonie de Tchaïkovsky est-elle une célébration de la vie ou un pressentiment de la mort prématurée du compositeur? Notre directeur musical John Storgårds dirige l’Orchestre du CNA dans l’une des œuvres les plus mystérieuses de l’histoire.\n\tLa célèbre violoniste Hilary Hahn effectue un retour très attendu à la Salle Southam pour une première mondiale captivante.\n\tDécouvrez l’univers sonore évocateur de Barbara Assiginaak, inspiré des perspectives anishinaabées sur l’écoute, la mémoire et la connexion.\n\tPréparez-vous à ressentir un calme absolu..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
