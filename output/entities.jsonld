    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Their Master's Voice | with John Malkovich |  Sat, Oct 10, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40091/their-master-s-voice-omc-marco-borrelli-31__large.jpg"
