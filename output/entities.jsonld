      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Tout &ccedil;a: A woman’s whole life in a single breath"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The incomparable British playwright Alistair McDowall manages to condense an entire human lifetime, with all its subtleties and myriad vibrant colours, into just over an hour of breathtaking theatre. An extraordinary encounter between a beautifully crafted script and an actor at the height of her art: the luminous &Eacute;velyne Rompr&eacute;."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Francophone"
      },
      {
        "@value": "Theatre"
      }
    ],
