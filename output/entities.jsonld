    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mozart, Ravel et Aphrodite Patoulidou  | Avec l'Orchestre du CNA |  31mar- 1 avr 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
