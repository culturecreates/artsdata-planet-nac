      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Célébrer Gilles Vigneault - Au cœur du pays | with Lou-Adriane Cassidy, Louis-Jean Cormier, Patrice Michaud, Ariane Moffatt, Ariane Roy and more  |  Sat, Jun 5, 2027, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42057/gilles_web__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Featuring artists Lou-Adriane Cassidy, Patrice Michaud, Ariane Moffatt, Ariane Roy, and more, under the musical direction of Louis-Jean Cormier, this spectacular show celebrates the richness of Gilles Vigneault’s work and its influence on his contemporaries. It’s a unique opportunity for audiences of all generations to discover or rediscover some of his most beautiful songs in a whole new light. This project is inspired by clear evidence: that Vigneault’s words continue to resonate, transcending styles and eras, and finding in each performer..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
