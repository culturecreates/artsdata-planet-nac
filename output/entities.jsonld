      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/40406"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Bach Cantatas | with Labadie & La Chapelle de Québec | Apr 14 - 15, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40406/naco_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know ...\n\n\n\tJ. S. Bach’s cantatas were composed for church services, but they’re more like opera scenes in the range of powerful emotions they convey—from love and desire to suffering and hope.\n\tThe singers of La Chapelle de Québec perform Bach’s music with a mesmerizing beauty, as if “you were hearing each individual voice reverberate through the seamless harmony” (The New York Times).\n\n\nJohann Sebastian Bach may not have composed any operas, but as you’ll hear in a captivating selection..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
