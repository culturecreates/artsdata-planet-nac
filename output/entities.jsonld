    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Rise Ashen et Iron Cabaret  |   sam 26 sep 2026, 21 h 00|  Place Peter A. Herrndorf"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42150/iron_cabaret__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Pour une seule soirée, Nuit Blanche Ottawa transforme la capitale en parcours nocturne d’art, de lumière et de découvertes.  Explorez le marché By, le centre-ville et les lieux emblématiques d’Ottawa à travers une expérience urbaine unique, ouverte, festive et accessible.\n\nVenez vivre la Nuit Blanche au CNA lors d’une soirée électrisante mêlant musique, mouvements et spectacle. Dansez toute la nuit au rythme des beats house de DJ Rise Ashen, tandis qu’Iron Cabaret captivera le public avec des numéros de danse à-gogo..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
