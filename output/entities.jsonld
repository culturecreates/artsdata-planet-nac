    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Act Out! A Whacking Battle | Pride Edition |  Fri, Aug 21, 2026, 9:00 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41875/act_out__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for Ottawa's first edition of Act Out, a free dance battle, party, and celebration of 2SLGBTQI+ creativity centred on street dance known as whacking/waacking. \n\nExhilarating exchanges, fabulous outfits, gender savagery, dramatic posing, music, storytelling... we are pulling out all the magic and you won't want to miss it.\n\nGuests are welcome to join as spectators or enter into the battle as participants. The dress code is PRIDE, so we invite attendees to have fun with your outfits and express yourself however you..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
