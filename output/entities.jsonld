    "http://schema.org/name": [
      {
        "@value": "BON Chat: Between Two Worlds A free pre-show conversation exploring migration, identity, and belonging (in French)"
      },
      {
        "@value": "BON Chat: Entre deux mondes Une causerie d’avant-spectacle gratuite sur la migration, l’identité et l’appartenance"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Before the performance of Neige sur Abidjan, join us for a special BON Chat that brings together community voices for an engaging conversation inspired by the themes of the play."
      },
      {
        "@value": "Avant la représentation de Neige sur Abidjan, joignez-vous à nous pour une causerie spéciale rassemblant des voix de la communauté pour une discussion passionnante inspirée par les thèmes de la pièce."
      }
    ],
