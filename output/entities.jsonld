  {
    "@id": "https://nac-cna.ca/en/event/42022",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/42022"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Odāwā Tomorrow: Odāwā Wàbang | Sep 24 - 27, 2026 | Kipnes Lantern"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42022/ottawa-200_jay-odjick-lantern_dsc00773_cr_david-leclerc-2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Created by artist and writer Jay Odjick (Kitigan Zibi Anishinaabeg), Odāwā Tomorrow: Odāwā Wàbang transforms the National Arts Centre Kipnes Lantern with an original animation exploring Indigenous futures rooted in renewal and reciprocity.  Presented after sunset, the projection illuminates the Lantern through Odjick's distinctive storytelling.\n\nBeginning with Turtle Island, the work looks toward the generations to come, rooted in enduring relationships between land and people while imagining pathways of regeneration and growth. Inspired by the Woodland school of art and the..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
