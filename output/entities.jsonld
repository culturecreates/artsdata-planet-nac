  {
    "@id": "https://nac-cna.ca/event/40850#2026-10-09T19:30:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/StorytellingPerformance"
      }
    ],
    "http://schema.org/eventStatus": [
