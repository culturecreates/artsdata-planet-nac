      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-03T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-03T22:00:00-04:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Logan Staats"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Hailing from Six Nations of the Grand River, and fresh from his triumphant performance at the Los Angeles Kia Forum in front of 18,000 screaming fans for Life is a Carnival: A Musical Celebration of Robbie Robertson, Mohawk artist Logan Staats continues to prove his performance and songwriting ability. Recent highlights include a Juno Award nomination for his album A Light in the Attic, receiving the TD SOCAN Indigenous Songwriter Award, earning a Native American Music Award win in the U.S., and charting #7 on the iTunes Rock Chart for his single “Deadman”. Logan first rose to national prominence when he won CTV’s The Launch and released his debut single, “The Lucky Ones”, which peaked at #1 in Canada. As a land defender, a cultural tastemaker, and a sought-after collaborator, he has performed and created with artists such as Allison Russel, Terra Lightfoot and Serena Ryder. He has brought his raw and electrifying performances across Canada, and around the world, with dates in the U.S., Europe and South America, and acted as support for Mumford & Sons, Eric Clapton and Steve Earle. The NAC would like to acknowledge the generous support of John and Pina Sicard."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Indigenous arts"
      },
      {
        "@value": "Music"
      },
      {
        "@value": "Rock"
      },
      {
        "@value": "Roots music"
      },
      {
        "@value": "Folk"
      }
    ],
