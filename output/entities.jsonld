    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know...  The NAC Orchestra kicks off its 2026–2027 season with a bang as Japanese pianist Makoto Ozone performs Rachmaninoff's devilish Rhapsody on a Theme of Paganini! Medieval paintings come to life in..."
      }
