    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Bashir Lazhar | The charismatic professor returns to the stage | Feb 25 - 27, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40432/tfcna2627_bashir_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A sensation when it premiered in 2007, this multi-voiced monologue by Evelyne de la Chenelière still resonates with audiences today, prompting us to question our value system and educational system. Directed by Marie Brassard, Mani Soleymanlou brings his own personal background to the iconic role of the teacher from abroad, offering us a compelling lesson in humanity.\n\nA man of Algerian descent, a survivor of personal and political tragedy, steps in at the last minute to replace a sixth-grade teacher who..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
