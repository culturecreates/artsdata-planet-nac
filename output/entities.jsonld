      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Célébrer Gilles Vigneault - Au cœur du pays  | avec Lou-Adriane Cassidy, Louis-Jean Cormier, Patrice Michaud, Ariane Moffatt, Ariane Roy et plusieurs autres |   sam  5 jun 2027, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42057/gilles_web__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Regroupant les artistes Lou-Adriane Cassidy, Patrice Michaud, Ariane Moffatt, Ariane Roy et plusieurs autres, sous la direction de Louis-Jean Cormier, ce grand spectacle est une célébration de la richesse et de l'influence de l'œuvre de Gilles Vigneault auprès de ses contemporains. Une occasion unique de faire découvrir ou redécouvrir à toutes les générations certaines de ses plus belles chansons dans des habits neufs. Un projet né d'une évidence : celle que les mots de Vigneault continuent de résonner, de traverser les styles et les époques, et..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
