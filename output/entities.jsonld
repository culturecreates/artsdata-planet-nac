      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Waiting for Godot - Inuktitut By Samuel Beckett"
      },
      {
        "@value": "Waiting for Godot - Inuktitut De Samuel Beckett"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Join Vladimir and Estragon as they wait endlessly for Godot, passing the time in Inuktitut—the most widely spoken language of the North. Through banter, bickering, and quiet companionship, they navigate the absurdity and agony of waiting in a world that offers few answers."
      },
      {
        "@value": "Rejoignez Vladimir et Estragon dans leur éternelle attente de Godot, où le temps s’égrène en inuktitut, la langue la plus parlée du Nord. Entre badinages, chamailleries et silences complices, ils affrontent ensemble l’absurdité et l’agonie de l’attente dans un monde avare de réponses."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Indigenous arts"
      },
      {
        "@value": "Theatre"
      },
