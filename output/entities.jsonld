      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shakura S'Aida |  Sat, Feb 6, 2027, 8:00 pm | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41639/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Shakura S’Aida is an acclaimed Americana roots-soul singer/songwriter and recurring actor on Schitt’s Creek whose dynamic performances have captivated audiences in 31 countries. Brooklyn-born, Swiss-raised, and based in Toronto, she is a three-time Juno Award nominee celebrated for her powerful, soul-stirring voice and magnetic stage presence. Summerfolk Festival calls her “engaging, vivacious and exciting,” while collaborators praise her artistry and spirit. \n\nHer latest single, “Keep It Movin’,” the follow-up to her Juno-nominated, Canadian Folk Music Award-winning Hold On to Love, channels..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
