    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Fils manqués?  | Virtuoso clowning unveiled | May 6 - 8, 2027 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40433/tfcna2627_filsmanque_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Can an actor who has lost his father ever be anything other than a clown? To answer this question, a masterful clown duo performs a cyclical tale of injustice. Their personal quests to find their absent fathers intertwine in an agile tragicomic pas de deux that walks the fine line between tears of laughter and sorrow.\n\nFor several years now, René Bazinet and David-Alexandre Després have been displaying their red noses on some of the world’s leading circus stages. Now they’re..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
