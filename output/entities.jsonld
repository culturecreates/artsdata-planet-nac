    "http://schema.org/name": [
      {
        "@value": "Music for a Sunday Afternoon: Spring Edition with members of the NAC Orchestra"
      },
      {
        "@value": "Musique pour un dimanche après-midi : Édition de printemps avec des membres de l’Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Sink into some seriously relaxing weekend vibes as NAC Orchestra musicians perform intimate music of soaring romance and operatic lyricism."
      },
      {
        "@value": "Passez un week-end des plus relaxants avec ce concert intime riche en envolées romantiques et en lyrisme opératique mettant en vedette des musiciennes et musiciens de l’Orchestre du CNA."
      }
    ],
