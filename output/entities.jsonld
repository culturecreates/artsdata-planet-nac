    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "MÁM  | Teaċ Daṁsa │Michael Keegan-Dolan |  25-26 sep 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40372/mam_-_dublin_theatre_festival_2019_-_ros_kavanagh_4__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Célébrations et traditions\n\nLes créations du chorégraphe irlandais Michael Keegan-Dolan se distinguent par une sensibilité profonde et un puissant sentiment de communion. Alliant subtilement émotion et humour, ses pièces de danse-théâtre abordent des thèmes universels tels que l’amour et l’identité.\n\nImprégné d’une énergie collective en pleine effervescence, MÁM réunit sur scène le virtuose du concertina traditionnel irlandais Cormac Begley, cinq musiciens contemporains, ainsi qu’un ensemble de 12 interprètes de Teaċ Daṁsa. Dans ce spectacle, la musique envoûte et les danseuses et danseurs..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
