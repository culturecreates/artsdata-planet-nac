  {
    "@id": "https://nac-cna.ca/en/event/41712",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/41712"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ottawa Jazz Orchestra | La langue de chez nous | Mar 24 - 25, 2027 | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41712/la_langue_de_chez_nous__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us for a fresh spin on beloved classic chansons from France and Quebec. Jazz vocalist Diane Nalini will interpret songs made famous by Yves Duteil, Félix Leclerc, Juliette Gréco, Georges Brassens and more. Accompanying her for this musical adventure through the twentieth century will be David Renaud on saxophone and clarinet, Mark Ferguson on piano and trombone, and Adrian Cho on double bass. An intimate, joyful evening not to be missed!"
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
