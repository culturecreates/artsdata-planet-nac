      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-16T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-16T22:00:00-04:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Sarah Hagen Goldberg Variations"
      },
      {
        "@value": "Sarah Hagen Variations Goldberg"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Sarah Hagen brings this classic programme featuring Bach’s formidable Goldberg Variations as part of the celebration of the recent release of her recording of the masterwork. Cherished by many, the Goldberg Variations are emblematic of keyboard virtuosity, rich expression, and hardcore classical interpretation. Sarah will offer a short introduction to this marvellous and intense piece before playing the full work."
      },
      {
        "@value": "Sarah Hagen s’empare des incontournables Variations Goldberg de Bach dans un programme-événement marquant la récente parution de son enregistrement de cette œuvre mythique. Monument du répertoire classique, les Variations Goldberg demeurent un sommet de virtuosité et d’intensité musicale. Sarah Hagen en présentera une courte mise en contexte avant de plonger dans l’œuvre complète."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Music"
      },
      {
        "@value": "Piano"
      },
      {
        "@value": "Musique"
      }
    ],
