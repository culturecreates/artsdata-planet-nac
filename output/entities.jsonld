  {
    "@id": "https://nac-cna.ca/event/42197#2026-10-07T20:30:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/eventStatus": [
      {
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-07T20:30:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-07T22:30:00-04:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "LIGHTBAHN x RASC Ottawa: Guided night sky observation"
      },
      {
        "@value": "LIGHTBAHN × section d’Ottawa de la Société royale d’astronomie du Canada : Observation guidée du ciel nocturne"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Join us outside on the National Arts Centre terrace to experience Natural Nights Ottawa through a free introductory night sky observation led by astronomers from RASC Ottawa. Weather and sky conditions permitting, participants will have the opportunity to observe Saturn through a telescope while learning how astronomers interpret the night sky from an urban environment. Please note: If conditions are not optimal on Oct. 7, the ‘raincheque’ event will take place on Thursday, Oct. 8."
      },
      {
        "@value": "Joignez-vous à nous sur la terrasse du Centre national des Arts pour découvrir la nuit naturelle d’Ottawa grâce à une séance d’initiation gratuite à l’observation du ciel nocturne animée par des astronomes de la section d’Ottawa de la Société royale d’astronomie du Canada. Si les conditions météorologiques et l’état du ciel le permettent, les participants auront l’occasion d’observer Saturne à l’aide d’un télescope et découvriront comment les astronomes interprètent le ciel nocturne dans un environnement urbain. Remarque : En cas de pluie, l’activité aura lieu le jeudi 8 octobre si les conditions ne sont pas optimales le 7 octobre."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Canadian"
      },
      {
        "@value": "Lecture"
      },
      {
        "@value": "Canadien"
      }
    ],
