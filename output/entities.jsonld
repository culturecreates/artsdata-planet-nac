      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40433"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Fils manqués?   | Révélation de deux virtuoses du clown |   6- 8 mai 2027|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40433/tfcna2627_filsmanque_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Est-ce qu’un acteur orphelin de père peut devenir autre chose qu’un clown? Afin de répondre à la question, un magistral duo de clowns joue en boucle le conte d’une injustice. Leurs quêtes personnelles pour retrouver un père absent s’entremêlent dans un agile pas de deux tragicomique, sur la ligne ténue entre les larmes de rire et de chagrin. \n\nDepuis plusieurs années, René Bazinet et David-Alexandre Després trimballent leur nez rouge sur les plus importantes scènes circassiennes de ce monde. Les revoici..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
