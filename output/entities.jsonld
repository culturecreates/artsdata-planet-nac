    "http://schema.org/name": [
      {
        "@value": "Schumann, Goldscheider, Mercer & Bancroft Returns"
      },
      {
        "@value": "Schumann, Goldscheider, Mercer et le retour de Bancroft"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Nature’s beauty and power take centre stage, from tranquil visions of the Rhein River to a dramatic depiction of a shipwreck along Canada’s Atlantic coast."
      },
      {
        "@value": "La beauté et la puissance de la nature prennent le devant de la scène, des visions paisibles du Rhin à l’évocation dramatique d’un naufrage sur la côte Est du Canada."
      }
    ],
