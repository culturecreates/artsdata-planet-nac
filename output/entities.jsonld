    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ben Dunnill |  Fri, Nov 6, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41996/ben_dunnill_hero_shot_high_rez_cropped_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "With a gravel and silk voice, effortless charisma and a repertoire that seems to know no limits, Canadian singer songwriter and multi instrumentalist Ben Dunnill brings old school soul into the present.\n\nDunnill has built a huge online following by doing something unexpected: taking songs you know and completely reinventing them. His soulful, cinematic jazz transformations of hits like 50 Cent’s “Many Men” and Coolio’s “Gangsta’s Paradise” have helped generate more than 200 million views and earned praise from Michael Bublé..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
