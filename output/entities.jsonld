      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shelley Conducts Mahler | With the NAC Orchestra | Jun 17 - 18, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40418/9169_nac_naco_26_27_batch4_1_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know...\n\n\n\tWitness one of the most moving, life-affirming symphonies of all time: Mahler’s Third Symphony, an expansive hymn to the divine love that unites nature and humankind.\n\tMahler’s friend, the conductor Bruno Walter, described the symphony as “the sound of heartfelt and exalted feelings … for what language can utter heavenly love more powerfully than music itself?”\n\n\nPrepare yourself for a bold, breathtaking journey through our natural world in Gustav Mahler’s Third Symphony. A work of immense scope in..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
