        "@value": "2027-04-28T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-28T21:00:00-04:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "When the Bleeding Stops Lovísa Ósk Gunnarsdóttir"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "In this critically acclaimed performance work, Icelandic dancer and choreographer Lovísa Ósk Gunnarsdóttir uplifts and overhauls the conversation around menopause in all its complexity. Sparked by a personal journey of recovery and discovery, her work ultimately affirms the liberating power of dance."
      },
      {
        "@value": "Puisant dans son cheminement personnel de guérison et de découverte, Lovísa Ósk Gunnarsdóttir propose une écriture chorégraphique qui célèbre le pouvoir émancipateur de la danse. Dans cette création saluée par la critique, l’interprète et chorégraphe islandaise élève et renouvelle la conversation autour de la ménopause dans toute sa complexité."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Dance"
      },
      {
        "@value": "Contemporary"
      },
      {
        "@value": "Danse"
      },
      {
        "@value": "Contemporaine"
      }
    ],
