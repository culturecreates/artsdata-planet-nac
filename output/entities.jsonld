    "http://schema.org/name": [
      {
        "@value": "Hilary Hahn, Storgårds & Tchaikovsky With the NAC Orchestra"
      },
      {
        "@value": "Hilary Hahn, Storgårds et Tchaïkovsky Avec l'Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Experience the melancholy melodies and thunderous dances of Tchaikovsky’s mysterious final symphony, and Hilary Hahn returns to Southam Hall for a captivating world premiere."
      },
      {
        "@value": "Admirez les mélodies mélancoliques et les danses tonitruantes de la mystérieuse dernière symphonie de Tchaïkovsky, et assistez au retour d’Hilary Hahn à la Salle Southam dans une première mondiale captivante."
      }
    ],
