      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Caribbean Nights  | with the NAC Orchestra | Feb 25 - 27, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40709/caribbean_nights_hero_c._curtis_perry__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Following the success of Reggae Roots and Steelpan Symphony, Caribbean Nights invites audiences to return for another evening honouring the rich musical traditions of the Caribbean. From rhythmic innovation to cultural storytelling, this celebration centres the artistry, influence, and enduring legacy of Caribbean music.\n\nCaribbean-Canadian conductor Daniel Bartholomew-Poyser is back to celebrate two of the Caribbean’s beloved musical traditions: reggae and calypso. Jamaican-born Halifax-based singer Jah’Mila—hailed as reggae-roots royalty—and renowned Canadian vocalist Kimya Hypolite join forces with the NAC Orchestra for..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
