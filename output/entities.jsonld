    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "WolfGANG Sessions #30 with John Storgårds | A Wild Night of Chamber Music |  Sat, Jan 23, 2027, 9:00 pm | Club SAW"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40428/9169_nac_naco26-27_wolfgang26-27_illustrations_30__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "WolfGANG Sessions at Club SAW is a night of music that is sure to entertain. Grab your adventurous friends and take them out for a wild night of chamber music with your favourite musicians from the NAC Orchestra."
      }
    ],
