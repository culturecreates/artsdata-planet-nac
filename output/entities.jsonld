    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de perlage: boucles d'oreilles en forme de fraise   | avec Kaylee Smoke  |   mar 29 sep 2026, 17 h 30|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41877/beaded_strawberry_earrings_-_event_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Initiez-vous aux techniques du perlage en relief tout en vous plongeant dans l’histoire et la symbolique de la fraise dans la tradition kanien’kehá:ka (mohawk). Au cœur des enseignements haudenosaunee, elle est un symbole de liens, de guérison, de gratitude et de renouveau."
      }
    ],
