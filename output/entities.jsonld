    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "summersets  |   sam 10 oct 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41583/sum_hires1_cayllancassavia__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "summersets est le nouveau projet de l’auteur-compositeur-interprète finaliste aux prix JUNO et Polaris Kalle Mattson, et de son collaborateur de longue date Andrew Sowka. Rappelant le talent de conteur de John Prine et la douceur intemporelle de Simon and Garfunkel, small town story, le premier album du duo produit par Jim Bryson (Kathleen Edwards, The Weakerthans), a été finaliste aux Prix de la musique folk de l’Ontario en 2024 et aux Prix de musique folk canadienne l’année suivante. Son deuxième..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
