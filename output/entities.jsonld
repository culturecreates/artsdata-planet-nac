    "http://schema.org/name": [
      {
        "@value": "Music for a Sunday Afternoon: Fall Edition with John Storgårds and members of the NAC Orchestra"
      },
      {
        "@value": "Musique pour un dimanche après-midi : Édition d’automne Avec John Storgårds et des membres de l’Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Sink into some seriously relaxing weekend vibes as NAC Orchestra musicians perform works for string orchestra spanning three centuries."
      },
      {
        "@value": "Passez un week-end des plus relaxants avec les musiciennes et musiciens de l’Orchestre du CNA, qui plongeront dans trois siècles de musique pour cordes."
      }
    ],
