    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Golden Girls | The Laughs Continue |  Fri, Aug 7, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40537/gg_background__event_1024__large.jpg"
