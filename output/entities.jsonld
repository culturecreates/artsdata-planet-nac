  {
    "@id": "https://nac-cna.ca/en/event/41580",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/41580"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Jean-Michel Blais | mirador |  Fri, Mar 5, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41580/rounded_corner_design_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Jean-Michel Blais was ready to make an epic.\n\nmirador, the pianist-composer's fourth album, finds the Montrealer turning his gaze onto a wondrous world—exchanging contemporary minimalism for a light and generous maximalism. It's an odyssey that spans choirs, strings and the music of the Andes, from Spanish caves to Estonian forests and all the way back to the basement in Nicolet, Québec, where Blais first imagined adventures.\n\nAfter 375 million streams and the biggest concerts of his life, the origins of mirador were..."
      }
