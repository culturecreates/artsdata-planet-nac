  {
    "@id": "https://nac-cna.ca/event/41876#2026-09-28T18:00:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/WorkshopEvent"
      }
    ],
    "http://schema.org/eventStatus": [
      {
