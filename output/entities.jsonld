      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-29T21:00:00-05:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Tout ça A woman’s whole life in a single breath"
      },
      {
        "@value": "Tout ça Une vie entière de femme en un seul souffle"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The incomparable British playwright Alistair McDowall manages to condense an entire human lifetime, with all its subtleties and myriad vibrant colours, into just over an hour of breathtaking theatre. An extraordinary encounter between a beautifully crafted script and an actor at the height of her art: the luminous Évelyne Rompré."
      },
      {
        "@value": "L’inimitable dramaturge britannique Alistair McDowall parvient à condenser toute une vie humaine, ses nuances et sa palette d’innombrables couleurs vibrantes, dans une petite heure de théâtre à couper le souffle. Une rencontre exceptionnelle entre un texte orfèvre et une actrice au sommet de son art, l’incandescente Évelyne Rompré."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Francophone"
      },
      {
        "@value": "Theatre"
      },
      {
        "@value": "Théâtre"
      }
