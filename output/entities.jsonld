      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "When the Bleeding Stops | Lovísa Ósk Gunnarsdóttir  | Apr 28 - 29, 2027 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40369/photo_owen_fiene-32_copy_2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "An Utterly joyful paradigm shift\n\nIn this critically acclaimed performance work, Icelandic dancer and choreographer Lovísa Ósk Gunnarsdóttir uplifts and overhauls the conversation around menopause in all its complexity. Sparked by a personal journey of recovery and discovery, her work ultimately affirms the liberating power of dance.\n\nFunny, honest and delightfully engaging, When the Bleeding Stops invites the audience into a collective space using monologue and movement. Through exchange and engagement with local women leading up to the performance, the work reveals..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
