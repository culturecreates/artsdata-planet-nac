      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Songs of Love and Collapse | DLD / Frédérick Gravel | May 12 - 13, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40364/vladimvilain_frederickgravel_alexiamartel-2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate the Complicated\n\nIf you’ve never experienced a performance by Montreal’s Frédérick Gravel, be prepared to lose your bearings. Fusing raw, physical virtuosity with various artistic genres, and music performed by a live band – with Gravel himself on guitar - his works are refreshingly unpretentious, and dance to the riff of their own strum. The audience is invited into an outlandish happening, one where dance is demystified, where paradox and contrast turn the performance upside down.\n\nFor Gravel, the stage offers..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
