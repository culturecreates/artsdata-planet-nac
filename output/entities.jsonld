      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Marc-André Hamelin en récital  | Série Grands Interprètes |   mar 23 fév 2027, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40675/9169_nac_naco_26_27_batch1_14__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le pianiste Marc-André Hamelin est reconnu pour élargir le répertoire pianistique en présentant notamment Alkan, Medtner et d’autres œuvres rarement jouées, aux côtés de grands classiques. Lauréat de nombreux prix discographiques, il est aussi compositeur. Ses récitals associent souvent œuvres majeures et redécouvertes. Le programme met de l’avant l’étendue et la diversité du répertoire. Une soirée axée sur la profondeur musicale."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
