      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Chansons d'amour et d'effondrement  | DLD / Frédérick Gravel |  12-13 mai 2027|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40364/vladimvilain_frederickgravel_alexiamartel-2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La beauté de la complexité\n\nSi vous n’avez jamais assisté à une performance du Montréalais Frédérick Gravel, attendez-vous à perdre vos repères. Alliant une virtuosité physique brute à divers genres artistiques, et à une musique interprétée par un groupe en direct – Gravel lui-même à la guitare, – ses œuvres se distinguent par une sincérité désarmante et vibrent au rythme de leur propre pulsation. Le public est invité à un événement insolite, où la danse est démystifiée, où le paradoxe et..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
