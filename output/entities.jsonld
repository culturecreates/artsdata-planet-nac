      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42001/2425_naco_-_event_page_graphics_template__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Experience the NAC Orchestra live and close to home.\n\nLed by conductor Léa Moisan-Perrier, the National Arts Centre Orchestra fills the stage for a concert designed to be enjoyed by all.\n\nFrom the music of Mozart and Haydn to Leonard Cohen’s Hallelujah and Golden from Netflix’s KPop Demon Hunters, expect familiar moments, new discoveries, and the sound of a full orchestra performing live in front of you.\n\nNever been to an orchestra concert before? Here’s your invitation."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
