      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Les Petites Filles modernes (titre provisoire) | Fantastical tale with hypnotic imagery, directed by Joël Pommerat | May 27 - 29, 2027 | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40438/tfcna2627_petitesfilles_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this new work, Joël Pommerat deploys his distinctive theatrical style to delve into the hidden mysteries of childhood. Two young girls meet and decide to defy adult authority in order to protect their friendship, armed only with their unbreakable bond. A spellbinding fantasy, far removed from a moral lesson.\n\nFaced with the rules and restrictions of the real world and adults who want to separate them, the two heroines stand up to the enigmatic forces of childhood. Their bond is..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
