    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Deepstaria  | Company Wayne McGregor |   7- 8 avr 2027|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40640/deepstaria_london_deepstaria_2024deepstaria__ravi_deepres__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Lueur sous la surface\n\nSur une scène plongée dans l’obscurité absolue, des éclats de lumière révèlent neuf interprètes; des présences mouvantes qui repoussent les limites du corps dans une danse à la fois contemplative et hypnotique. Membres hyper étendus, torses qui se dérobent et variations de rythme et de formes donnent une impression de sculpture en mouvement. Chaque représentation voit naître un paysage sonore façonné par l’intelligence artificielle, transformant Deepstaria en une expérience sensorielle d’une intensité rare.\n\nLe chorégraphe avant-gardiste londonien Sir..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
