      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Noé Lira |  Fri, Apr 9, 2027, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41721/rounded_corner_design_(2)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "El español sigue al texto en inglés\n\nOceanica is the companion concert–performance to Noé Lira’s upcoming bilingual (French/Spanish) cinematic pop album (produced by Jean Massicotte). Noé offers an immersive experience in which voice, movement, and light come together to create a rich and evocative show. Driven by a confident fusion of styles, Oceanica becomes a vibrant meeting place, connecting languages and cultures in a direct, sensitive, and unifying human dialogue. Building on the poetics of water and territory, the work explores resilience and..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
