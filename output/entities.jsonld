        "@value": "https://nac-cna.ca/en/event/40441"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Neige sur Abidjan | Autofiction between here and Africa | Oct 8 - 10, 2026 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40441/tfcna2627_neige_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this touching and intimate work of autofiction, Iannicko N’Doua takes us on a coming-of-age journey across years and continents, guided by a griot with a thousand faces, played by the charismatic Hamadoun Kassogué. Initially, the playwright and performer believes he is merely searching for his father, but he discovers a whole country where part of his family and heritage are flourishing.\n\nMore than 20 years after his father left Montréal to return to his homeland, a young theatre student sets..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
