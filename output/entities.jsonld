    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/41877"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Strawberry Earring Workshop  | with Kaylee Smoke |  Tue, Sep 29, 2026, 5:30 pm | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41877/beaded_strawberry_earrings_-_event_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Throughout the workshop, participants will be guided through the techniques used to create raised beadwork while learning about the cultural significance of the strawberry from a Kanien’kehá (Mohawk) perspective. The strawberry holds an important place within Haudenosaunee teachings, representing connection, healing, gratitude, and the renewal of life."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ],
