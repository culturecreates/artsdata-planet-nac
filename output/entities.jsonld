    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-19T18:00:00-05:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Ottawa Jazz Orchestra Nutcracker Double"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Ring in the holiday season with the Ottawa Jazz Orchestra and a festive, swinging celebration of Tchaikovsky’s beloved winter masterpiece. This unique concert offers a fascinating dual-perspective on the iconic ballet, featuring two legendary big band interpretations performed back-to-back. Experience the cool, brassy, West Coast jazz brilliance of Shorty Rogers' celebrated arrangement, perfectly contrasted with the warm, nostalgic, and unmistakable swing of the Glenn Miller Orchestra’s version. To complete this joyful evening, the orchestra will round out the program with a delightful selection of classic Christmas tunes originally made famous by Glenn Miller. It is a perfect, toe-tapping holiday treat that marries the magic of the Nutcracker with the golden age of jazz!"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Music"
      },
      {
        "@value": "Jazz"
      },
      {
        "@value": "Canadian"
      }
