    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Storgårds, Beethoven et Dvořák  | et les débuts d’Élisabeth Pion |   4- 5 nov 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40423/metaadtemplate_8_(1)__event_1024__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\n\n\tCe programme est le premier de John Storgårds à titre de directeur musical de l’Orchestre du CNA!\n\tAvec une méditation musicale sur l’univers et une symphonie riche en douces mélodies, ce programme promet bien des moments de beauté et de calme.\n\tBeethoven a écrit qu’il composait pour exprimer ce que contenait son cœur; un sentiment qu’illustre bien cette œuvre tendre et émouvante pour piano et orchestre.\n\n\nInspirez profondément et décompressez grâce au lyrisme contemplatif du Concerto pour piano no 4 de Beethoven. De..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
