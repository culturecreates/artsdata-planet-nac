    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-06-10T22:00:00-04:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Matriarchs Uprising the eggstravaganza + WHAKAHĀ"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Matriarchs Uprising festival, curated by Olivia C. Davies, is a powerful gathering of Indigenous women whose practices evolve contemporary Indigenous dance and storytelling while honouring the artists who came before them. Through performances, conversations, and shared practice, the festival creates a space where past, present, and future meet with care, intention, and artistry."
      },
      {
        "@value": "Orchestré par Olivia C. Davies, Matriarchs Uprising rassemble fièrement des femmes autochtones qui font bouger les codes de la danse et du récit autochtones contemporains, tout en portant haut l’héritage des artistes qui les ont précédées. Entre prestations, échanges et pratiques collectives, le festival devient un lieu où passé, présent et futur se rencontrent dans la bienveillance, la détermination et la créativité."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Indigenous arts"
      },
      {
        "@value": "Dance"
      },
      {
