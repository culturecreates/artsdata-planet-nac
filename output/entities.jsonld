    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "For one night only, Nuit Blanche Ottawa transforms the capital into a vibrant nighttime experience of art, light and discovery. From the ByWard Market to downtown streets and iconic landmarks, explore the city through a new lens.\n\nExperience Nuit Blanche at the NAC with an electrifying night of music, movement, and spectacle. Dance the night away to the soulful house beats of DJ Rise Ashen, while Iron Cabaret captivates audiences with dynamic GoGo dance performances, soaring aerial artistry, and awe-inspiring acrobatics.\n\nPresented..."
      }
    ],
