    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Évangéline - The Musical | North America's greatest love story | Aug 5 - 7, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42037/evangeline_cna_2426x1365_sanstexte__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "After captivating more than 60,000 audience members since its premiere, Évangéline continues to enjoy resounding success. Starring Maude Cyr-Deschênes, Olivier Dion, Matthieu Lévesque, Nathalie Simard, Océane Kitura Bohémier-Tootoo and Laurent Lucas, Évangéline is a sweeping historical musical infused with a modern sensibility—a cinematic take on an epic story rooted in Indigenous territory in Nova Scotia.\n\nIn 1755, the Acadians were expelled from their homes. Time has not fully healed the wounds. In this epic tale of legendary lovers, revolutionaries Évangéline and..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
