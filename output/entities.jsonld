    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bashir Lazhar: The charismatic professor returns to the stage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "First staged in 2007, this powerful play by Evelyne de la Cheneli&egrave;re still resonates with audiences today, prompting us to challenge our value system and educational system. Directed by Marie Brassard, Mani Soleymanlou brings his own personal background to the iconic role of the teacher from abroad, offering us a compelling lesson in humanity."
      }
    ],
