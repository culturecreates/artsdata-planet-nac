  {
    "@id": "https://nac-cna.ca/event/40384#2026-09-10T19:30:00-04:00",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheatrePerformance"
    ],
    "http://schema.org/eventStatus": [
