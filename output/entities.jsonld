  {
    "@id": "https://nac-cna.ca/event/40384#2026-09-19T14:00:00-04:00",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/eventStatus": [
