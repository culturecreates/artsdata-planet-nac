      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40440"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Mommy, le retour   | Satire musicale gore, rap et politique |  25-26 sep 2026|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40440/tfcna2627_mommy_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Elle était bel et bien morte dans un CHSLD, mais elle revient à la vie pour se venger! Mère traditionnelle ou momie réactionnaire? Mommy, cet épouvantail à idéaux, inventé par le savant fou du théâtre, Olivier Choinière, ressuscite en prêtresse d’une cérémonie chantée et rappée par des zombies néofascistes, joués par de redoutables interprètes hypervitaminés.\n\nUn DJ messianique surplombe un décor aux allures de bazar bling-bling. Un duo de narrateurs sortis d’un conte de fées trash et une cohorte de morts-vivants escortent..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
