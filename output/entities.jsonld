    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Andrés Vial Percussion Ensemble  |   ven 19 fév 2027, 20 h 00|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41642/andres_vial_(andi_state)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "L’ensemble de percussions Andrés Vial réunit des instrumentistes de Montréal aux racines multiples – Argentine, Chili, Burkina Faso, République démocratique du Congo, Canada et États-Unis – autour d’une exploration des liens profonds entre le jazz et les musiques latines et africaines.  \n\nAux côtés d’Andrés Vial au piano, on retrouve Mamadou Koita (balafon, tama), Michael Davidson (vibraphone, marimba), Elli Miller Maboungou (tambours ngoma), Tommy Crane (batterie) et Ira Coleman (contrebasse). \n\nEn 2023, Andrés Vial et plusieurs membres du groupe collaborent avec le légendaire batteur, vibraphoniste et..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
