        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40375"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cambodian Rock Band  | De Lauren Yee, avec les chansons de Dengue Fever |  21avr- 1 mai 2027|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40375/crb_beach_scene_fin_copy__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Production originale de la compagnie Arts Club Theatre de Vancouver\n\nQue résonnent les chansons qui ont survécu à l’histoire. \n\nUn groupe fictif. De vraies chansons de Dengue Fever. Et un père et sa fille aux prises avec un passé horrible. À mi-chemin entre le concert et le règlement de comptes historique, la pièce de Lauren Yee s’aventure en eaux troubles, abordant les thèmes de la famille, de la survie et de la nature complexe des traumatismes. Alternant habilement entre le Cambodge des années..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
