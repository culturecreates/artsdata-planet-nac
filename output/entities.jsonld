    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Pink Martini |  Fri, Mar 19, 2027, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41650/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Featuring an irresistible mix of timeless songs from all corners of the world, Pink Martini’s mission of multicultural musical connection continues to charm audiences of all ages after more than three decades of bringing its genre- and border-defying musical adventure to fans on six continents. With the inimitable Storm Large commanding the stage on lead vocals, Pink Martini’s mélange of classic big band pop and Hollywood glamour is always in fashion. Don’t miss the nonstop global party from our “little..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
