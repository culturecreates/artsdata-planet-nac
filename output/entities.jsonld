      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Haydn: The Creation | with John Storgårds | May 20 - 21, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40401/9169_nac_naco_26_27_batch1_8__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know:\n\n\n\tWhat did the birth of the universe sound like? Joseph Haydn offers his take in The Creation—an astonishing work of pure musical imagination.\n\tIf you’re craving an evening of epic music and a stage filled with Canada’s finest singers and instrumentalists, this program is for you!\n\n\nWitness the birth of the universe in all of its majesty and mystery in Joseph Haydn’s The Creation. Weaving a collection of texts from the Book of Genesis, the Book of Psalms,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
