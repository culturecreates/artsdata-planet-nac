    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ray Chen en récital  | Série Grands Interprètes |   dim 18 oct 2026, 20 h 00|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40677/9169_nac_naco_26_27_batch2_3__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\n\n\tLe violoniste Ray Chen (« l’incarnation parfaite du cool » selon le Sydney Morning Herald) est de retour à la Salle Southam dans un programme aussi apaisant qu’exaltant couvrant 200 ans d’histoire.\n\tMême si vous ne l’avez jamais vu en concert, vous reconnaîtrez peut-être le musicien : il a fait une apparition dans la populaire série télévisée Mozart in the Jungle, a été mannequin pour Giorgio Armani et a posé pour le magazine Vogue.\n\n\nQu’il se produise sur les plus..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
