    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Danza Contempor&aacute;nea de Cuba is internationally recognized for its electrifying repertoire, and its high-powered dancers that bring it to life. This evening&rsquo;s program beautifully epitomizes the company&rsquo;s range and versatility. Turn up the heat!"
      }
