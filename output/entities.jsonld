    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "BON Chat: Entre deux mondes | A free pre-show conversation exploring migration, identity, and belonging |  Sat, Oct 10, 2026, 6:00 pm | Salon"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41928/bon(2026-01-16)-831__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Before the performance of Neige sur Abidjan, join us for a special BON Chat that brings together community voices for an engaging conversation inspired by the themes of the play. Facilitated by Mani Soleymanlou, Artistic Director of French Theatre, and featuring community voices, this gathering creates space for meaningful dialogue inspired by the play and the experiences of those who have built new lives in Canada. \n\nThrough personal stories and shared experiences, our speakers will explore what it means to build a new life, navigate different..."
      }
    ],
