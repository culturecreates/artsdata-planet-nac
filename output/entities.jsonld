    "http://schema.org/name": [
      {
        "@value": "Shelley Conducts Mahler With the NAC Orchestra"
      },
      {
        "@value": "Shelley dirige Mahler Avec l'Orchestre du CNA"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Witness one of the most life-affirming orchestral works of all time: Mahler’s Third Symphony, an expansive hymn to the divine love that unites nature and humankind."
      },
      {
        "@value": "Laissez-vous transporter par l’une des œuvres orchestrales les plus optimistes de tous les temps : la Troisième symphonie de Mahler, un hymne monumental à l’amour divin qui unit l’homme et la nature."
      }
    ],
    "http://schema.org/keywords": [
