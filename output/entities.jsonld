      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Veillée de danse et musique trad   | Avec La Déferlance et Yaëlle Azoulay  |   ven 25 sep 2026, 21 h 30|  Foyer du canal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41759/20221231-veillee-avant-veille-vma_1088_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Danse CNA vous convie à un party trad dans le foyer du Canal afin de prolonger l’expérience du spectacle MÁM du chorégraphe irlandais Michael Keegan-Dolan (Teaċ Daṁsa). Au son de la musique traditionnelle québécoise jouée en direct par le groupe La Déferlance, la calleuse de renom Yaëlle Azoulay vous guidera par sa voix afin de vous initier aux pas de base de la danse traditionnelle. Que vous soyez déjà adepte, ou que ce soit une toute première fois, tout le..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
