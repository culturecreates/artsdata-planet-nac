    "http://schema.org/description": [
      {
        "@value": "Moments of profound calm and beauty await in music spanning 200 years of imagination—from a musical meditation on the universe to a symphony overflowing with tranquil melodies."
      },
      {
        "@value": "Des moments de calme profond et de grande beauté vous attendent avec ces œuvres qui couvrent 200 ans d’imagination, d’une méditation musicale sur l’univers à une symphonie riche en douces mélodies."
      }
