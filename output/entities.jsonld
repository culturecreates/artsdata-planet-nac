      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Matriarchs Uprising | the eggstravaganza + WHAKAHĀ  | Jun 10 - 11, 2027 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40374/matriachs-uprising-final_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A Celebration of Matriarchy \n\nthe eggstravaganza  \nby Sophie Dow and Kathleen Nisbet \n\nWhakahā\nby Louise Pōtiki Bryant and Paddy Free\n\nMatriarchs Uprising, curated by Olivia C. Davies, is a festival that brings together Indigenous women who are shaping the future of contemporary Indigenous dance and storytelling. Through performances, conversations, and shared practice, the festival creates a space where past, present, and future meet with care, intention, and artistry.\n\nAudiences are invited to experience works honouring a variety of cultural practices while embracing new creative forms. Each..."
      }
    ],
