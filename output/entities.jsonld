    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Toronto Comedy All Stars | Celebrating 12 years of sold out shows |  Sat, Jan 16, 2027, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41917/toronto_comedy_all_stars_4th_stage_1440x810__event_1024__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "*This show has sold out for 11 seasons in a row so purchasing advanced tickets is highly recommended*\n\nBoasting dozens of appearances on TV, radio and comedy festivals worldwide (and one working laptop between them), Toronto’s best standup comedians bring their A game to Ottawa for an unforgettable evening of comedy.\n\nCelebrate our 12th season at the NAC with killer comedians seen on Crave, CBC, SiriusXM, AppleTV+ & more. Grab some drinks and have a laugh while we lurch from one apocalypse..."
      }
    ],
