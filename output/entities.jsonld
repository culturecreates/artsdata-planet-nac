    ],
    "http://schema.org/name": [
      {
        "@value": "Post-show Dance Party Traditional music and dance with La Déferlance and Yaëlle Azoulay"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Danse CNA vous convie à un party trad dans le foyer du Canal afin de prolonger l’expérience du spectacle MÁM du chorégraphe irlandais Michael Keegan-Dolan (Teaċ Daṁsa). Au son de la musique traditionnelle québécoise jouée en direct par le groupe La Déferlance, la calleuse de renom Yaëlle Azoulay vous guidera par sa voix afin de vous initier aux pas de base de la danse traditionnelle."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Dance"
      }
    ],
