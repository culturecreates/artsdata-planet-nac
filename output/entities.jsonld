    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Bobby Bazini | Seul au Cinéma |  Sat, Feb 20, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41229/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Since his very first career interview 15 years ago, following the release of I Wonder, Bobby Bazini has often been asked the same question: why doesn't he sing in French? Journalists ask it during interviews, and fans bring it up after shows or when they approach him on the street. The desire was there, of course, but for years, he postponed the project — unsure of how to approach it, doubting himself, wondering whether he was capable and whether his..."
      }
    ],
