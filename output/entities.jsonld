    "http://schema.org/name": [
      {
        "@value": "Ravel, Chopin & Kevin Chen Piano, Ballet, and Beyond"
      },
      {
        "@value": "Ravel, Chopin et Kevin Chen Piano, ballet et horizons nouveaux"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Reconnect with your inner child as Ravel conjures the fantasy and nostalgia of your favourite fairy tales, and the music of Chopin traces an intense emotional journey of the heart."
      },
      {
        "@value": "Retrouvez votre cœur d’enfant avec les airs fantaisistes et nostalgiques de Ravel, inspirés de vos contes de fées favoris, et plongez dans l’intense fresque sentimentale de Chopin."
      }
