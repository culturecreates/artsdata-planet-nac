    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les Sessions WolfGANG #31  | Une folle soirée de musique de chambre |   sam 17 avr 2027, 21 h 00|  Club SAW"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
