    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Indigenous Art Mini-Market  |  Fri, Sep 11, 2026, 6:30 pm | Fountain Lobby"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42032/bs_mini-market_event_image__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us on Friday September 11 from 6:30pm-9:00pm in the Fountain Lobby as we host Indigenous artists and artisans for the Indigenous Art Mini-Market at the National Arts Centre. Open to the public, join in on the community spirit by supporting artists, seeing friends and connecting with arts and culture.\n\nIf you are coming to see Beautiful Scars that evening, take some time pre-show or during intermission to do some shopping. Connecting with themes from the show, we are hosting Kanien'keháka..."
      }
    ],
