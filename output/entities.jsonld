    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/41809"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Causerie d'avant-spectacle: Soirée Stravinsky  | Avec Christopher Stowell et Ming Luke |   jeu 29 oct 2026, 19 h 00"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41809/pre-show_chat_(2)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Joignez-vous à nous pour une causerie avec le directeur artistique du Royal Winnipeg Ballet, Christopher Stowell, et le directeur musical, Ming Luke, le jeudi 29 octobre à 19 h. Animée en anglais par Caroline Ohrt, productrice générale de Danse CNA, cette discussion précédera la représentation de Soirée Stravinsky, un hommage touchant à Stravinsky, figure majeure du XXᵉ siècle."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
