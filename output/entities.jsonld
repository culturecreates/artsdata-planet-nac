  {
    "@id": "https://nac-cna.ca/event/40370#2026-11-13T19:30:00-05:00",
    "@type": [
      "http://schema.org/Event",
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/eventStatus": [
