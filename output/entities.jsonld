      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Mozart, Ravel & Aphrodite Patoulidou | With the NAC Orchestra | Mar 31 - Apr 1, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40416/9169_nac_naco_26_27_batch1_1__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know ...\n\n\n\tFrom a lyrical meditation on love and belonging to a symphony of shadow and light, these works of melancholy and nostalgia will leave you feeling grounded and calm.\n\tMozart’s dramatic Symphony No. 40 channels anxiety and intensity—and still finds its way to a finale of ecstatic joy.\n\tSoprano Aphrodite Patoulidou’s creativity knows no boundaries—besides her work on the concert stage, she’s also a skilled painter and has sung with metal bands.\n\n\nAudiences were in shock after Mozart premiered..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
