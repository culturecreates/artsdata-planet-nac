    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/41298"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Cirque Éloize: iD - Evolution | Mar 4 - 6, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41298/250804_cirqueeloize_idevolution_show-124__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Originally created in 2009 in Incheon, KOR, then restaged for the Montreal Complètement Cirque Festival, iD has enjoyed tremendous success: 2,100 performances in 33 countries and 140 cities. Cirque Éloize's greatest hit, this iconic Quebec creation returns, reinvented for our times, with its iconic set and even more electrifying energy. \n\nIn iD – Evolution, the city becomes a stage and a character in itself. Acrobats defy gravity, dancers explode into striking urban movements, and every space is transformed into a playground..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
