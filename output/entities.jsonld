  {
    "@id": "https://nac-cna.ca/en/event/42197",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/42197"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "LIGHTBAHN x RASC Ottawa: Guided night sky observation |  Wed, Oct 7, 2026, 8:30 pm | Wood Terrace"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42197/rounded_corner_design_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join us outside on the National Arts Centre terrace to experience Natural Nights Ottawa through a free introductory night sky observation led by astronomers from RASC Ottawa. Weather and sky conditions permitting, participants will have the opportunity to observe Saturn through a telescope while learning how astronomers interpret the night sky from an urban environment.\n\nPlease note: If conditions are not optimal on Oct. 7, the ‘raincheque’ event will take place on Thursday, Oct. 8."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
