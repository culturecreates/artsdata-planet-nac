    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cirque Éloize : iD - Evolution  |   4- 6 mar 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
