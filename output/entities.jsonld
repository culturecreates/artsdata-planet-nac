      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-13T19:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-13T22:00:00-05:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Michael Kaeshammer My Valentine"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Celebrate Valentine’s season with an unforgettable evening of music, charm, and virtuosity as acclaimed Canadian pianist and singer Michael Kaeshammer takes the stage. A true “piano whisperer,” Kaeshammer is renowned for coaxing dazzling, kaleidoscopic sounds from the keys, blending jazz, pop, and boogie-woogie into a style that only a few can rival. With a career spanning more than two decades, Kaeshammer has released 15 albums, earned seven Juno Award nominations, and built a global reputation through performances across Canada, the United States, Europe, and China. His latest album, Turn It Up, an eclectic yet vibrant jazz-infused pop collection, earned a Western Canadian Music Award nomination and showcases the boundless energy and positivity that define his music. Known for his dynamic stage presence, quick wit, and infectious enthusiasm, Kaeshammer doesn’t just perform. He puts on a show, captivating audiences from the first note to the final encore. Now, Kaeshammer brings that signature energy to your city, lighting up this special Valentine’s concert with his trademark warmth and electrifying musicianship. Experience an evening of soulful melodies, dazzling piano, and heartfelt songs in a vibrant, feel-good celebration of Valentine’s night!"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Music"
      },
      {
        "@value": "Pop"
      },
      {
        "@value": "Jazz"
