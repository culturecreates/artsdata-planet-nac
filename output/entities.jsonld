      },
      {
        "@value": "Haydn : La Création avec John Storgårds"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Embark on a musical odyssey of cosmic proportions — where light emerges from darkness, soil and sky take shape, and humans and animals alike discover an earthly paradise."
      },
      {
        "@value": "Prenez part à une odyssée aux proportions cosmiques, où la lumière émerge des ténèbres, la terre et le ciel prennent forme et humains et animaux découvrent un paradis terrestre."
      }
    ],
