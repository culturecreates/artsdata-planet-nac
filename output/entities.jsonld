    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "An evening with Tom Wilson |  Tue, Sep 8, 2026, 6:30 pm | Peter A. Herrndorf Place"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42018/_wayne_simpson2527_(2)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Tom Wilson had already built a life as a rock musician when he learned the truth about where he came from. Beautiful Scars: Steeltown Secrets, Mohawk Skywalkers and the Road Home is the bestselling memoir behind the musical he co-created, and he tells the story the way he tells everything: songs, laughter, and no small amount of trouble.\n\nSpend an evening in his company as he reads from the memoir, performs an intimate acoustic set, and answers your questions.\n\n\nWe are also..."
      }
    ],
