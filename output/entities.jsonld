    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ottawa Latin Jazz Conference  | Rachelle Behrens, Anh Phung & Civil Lizard et Orlando Cardoso Trio |   ven 25 sep 2026, 20 h 00|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41962/oljc_2026_friday_sept_25__2026__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "La Conférence d’Ottawa sur le jazz latin revient au Centre national des Arts du 25 au 27 septembre 2026 pour célébrer la vitalité et la créativité de la diaspora multiculturelle du Canada. Présentée par Latin Hub Canada, cette troisième édition réunit concerts, ateliers, tables rondes et activités de réseautage, avec une impressionnante sélection d’artistes, dont Anh Phung, Orlando Cardoso, Rachelle Behrens, Oná Ensemble, João Lenhari, Adis Rodriguez, Joy Lapps et le pianiste lauréat d’un GRAMMY, Hilario Durán.\n\nPlacée sous le signe..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
