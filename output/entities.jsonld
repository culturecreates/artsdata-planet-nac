    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Women, Truth & Reconciliation | With Rose LeMay and Tanya Talaga |  Wed, Sep 30, 2026, 5:30 pm | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41478/event_graphic_(2426x1365)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "To foster a more intimate and meaningful conversation, one that brings our speakers and audience closer together and encourages meaningful conversation, the event will now take place in the Azrieli Studio, also located within the National Arts Centre.\n\n***************************************************************************************\n\nWhat does meaningful reconciliation actually look like – and what role do women have to play in advancing it?\n\nJoin The Honest Talk for a special panel conversation in recognition of the National Day for Truth and Reconciliation focused on what reconciliation looks like in practice,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
