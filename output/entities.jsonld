    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Makoto Ozone Plays Rachmaninoff | and Gemma New conducts Pictures at an Exhibition | Sep 16 - 17, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40407/makoto_1__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know... \n\n\n\tThe NAC Orchestra kicks off its 2026–2027 season with a bang as Japanese pianist Makoto Ozone performs Rachmaninoff's devilish Rhapsody on a Theme of Paganini!\n\tMedieval paintings come to life in Mussorgsky’s Pictures at an Exhibition. Be inspired by a stroll through a museum gallery in this striking musical depiction of 10 paintings.\n\n\nCelebrate the opening night of the NAC Orchestra's 2026–2027 season! Our musicians return from summer break to carry you away with a night of thrilling music—from diabolically..."
      }
    ],
