    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Nikamu Mamuitun II |  Wed, Feb 17, 2027, 8:00 pm | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41228/web_resize_(1)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Nikamu Mamuitun—“songs that unite us”—has been celebrating encounters and creative exchange between Indigenous and non-Indigenous artists since 2017, creating a space where music becomes a powerful vehicle for unity and sharing. Through the shared vision of Alan Côté (Festival en chanson de Petite-Vallée) and Florent Vollant, this project brings together artists from a wide range of backgrounds, alongside seasoned mentors and inspiring artistic leadership.  \n\nAfter the success of its first cohort, a new group of musicians is ready to wow audiences...."
      }
    ],
