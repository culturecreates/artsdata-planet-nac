      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/41876"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de perlage d'un chandail orange  | avec Stephanie Peltier |   lun 28 sep 2026, 18 h 00|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41876/stephanie_peltier_orange_shirt__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans cet atelier, vous apprendrez à confectionner une épinglette perlée en vue de la Journée nationale de la vérité et de la réconciliation. Voici l’occasion de mieux connaître une forme d’art autochtone ainsi que l’importance de cette journée. \n\nAtelier destiné aux néophytes comme aux personnes expérimentées de 16 ans et plus. Des connaissances de base en couture sont recommandées. Il se déroulera en anglais, mais les questions en français sont les bienvenues.   \n\nLe matériel est fourni. \n\nL’atelier sera offert à l’Atelier Shenkman..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
