    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les Petites Filles modernes (titre provisoire)  | Conte fantastique aux visions hypnotiques signé Joël Pommerat |  27-29 mai 2027|  Théâtre Babs Asper"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40438/tfcna2627_petitesfilles_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Avec sa signature théâtrale impossible à imiter, Joël Pommerat creuse dans cette nouvelle création les mystères souterrains du monde de l’enfance. Deux jeunes filles se rencontrent et choisissent, pour préserver leur lien, de braver l’autorité des adultes, avec pour seules armes leur amitié inébranlable. Un conte fantastique ensorcelant, à mille lieues d’une leçon de morale. \n\nConfrontées aux lois du monde réel et aux adultes qui voudraient les séparer, les deux héroïnes opposent les forces énigmatiques de l’enfance. Leur lien indéfectible est..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
