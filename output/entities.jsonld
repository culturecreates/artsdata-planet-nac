      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ottawa Jazz Orchestra | Grit N’ Groove | Jan 20 - 21, 2027 | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41711/grit__grooves__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Ottawa Jazz Orchestra, featuring vocalist Diane Nalini, serves up an electrifying evening with fresh, heavy-hitting jazz and funk arrangements of classic rock and pop anthems you know and love. From the deep, gritty grooves of Stevie Wonder and Tower of Power to mind-blowing, horn-heavy reinventions of rock icons like Guns N' Roses, Peter Gabriel, and Metallica, get ready for a bold and brassy night of music to help shake off the winter chill."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
