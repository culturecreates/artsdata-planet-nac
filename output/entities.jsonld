        "@value": "https://nac-cna.ca/en/event/41649"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Ennis Sisters | 30th Anniversary |  Thu, Mar 18, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41649/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Ennis Sisters are a Juno Award-winning trio hailing from St. John’s, Newfoundland & Labrador. They have been captivating audiences worldwide for over 25 years with their seamless harmonies and compelling songwriting. Flavoured by Celtic and traditional Newfoundland influences, their music offers a broad mix of original songs as well as uniquely interpreted tunes and ballads.  \n\nIn 1997, Maureen, Karen and Teresa Ennis took their first steps into the spotlight with the release of their debut album, Red is the Rose...."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
