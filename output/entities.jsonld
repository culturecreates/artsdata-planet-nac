    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40396"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Toni Morrison en musique et la Symphonie « Écossaise » de Mendelssohn  | avec Vuvu Mpofu, Roderick Cox et l’Orchestre du CNA |  14-15 oct 2026|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40396/metaadtemplate_1_(8)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jazz, spirituals, poésie, paysages embrumés et tempêtes se rencontrent dans un programme qui nous transporte entre trois univers musicaux profondément différents.\n\nQuelques infos clés...\n\n\n\tDouceur et amertume, brume et tempêtes : ce programme nous fait traverser des univers saisissants, de la poésie de Toni Morrison, portée par le jazz et les spirituals d’André Previn, jusqu’aux paysages sauvages de l’Écosse de Mendelssohn.\n\tLa soprano sud-africaine Vuvu Mpofu se joint au chef Roderick Cox pour Honey and Rue de Prévin, six poèmes de la lauréate..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/event/40396#2026-10-15T20:00:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
