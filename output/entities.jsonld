      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-20T22:00:00-05:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Yuk Yuk's 50th Anniversary Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Celebrate 50 years of raw, uncut, and legendary comedy as the Yuk Yuk’s 50th Anniversary Tour arrives at the National Arts Centre on Saturday, February 20th! Since anti-establishing themselves in 1976, Yuk Yuk's has become the undisputed backbone of Canadian standup comedy, serving as the launchpad for global entertainment icons like Jim Carrey, Norm Macdonald, Russell Peters, Howie Mandel and many more. The 50th Anniversary Tour is a celebration honors that legacy with a killer lineup of today’s emerging comedy stars. Expect an electric, high-energy atmosphere as a powerhouse lineup of Canada’s sharpest modern heavyweights takes the stage for an evening of brilliant storytelling, rapid fire one liners, and fearless, unfiltered comedy."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Canadian"
      },
      {
        "@value": "Stand-up Comedy"
      }
    ],
