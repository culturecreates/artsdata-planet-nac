      {
        "@value": "Ray Chen en récital Série Grands Interprètes"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Violinist Ray Chen—“the epitome of cool”—returns to Southam Hall to calm the mind and stir the soul with a time-travelling recital program."
      },
      {
        "@value": "Le violoniste Ray Chen « l’incarnation parfaite du cool » est de retour à la Salle Southam pour parcourir les siècles dans un récital aussi apaisant qu’exaltant."
      }
    ],
