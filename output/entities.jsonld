      {
        "@language": "fr-ca",
        "@value": "Atelier de confection de mocassins avec empeignes perlés  | avec Colleen Nolan |   6-20 oct 2026|  Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
