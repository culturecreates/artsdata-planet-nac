    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Strawberry Earring Workshop  | with Kaylee Smoke |  Tue, Sep 29, 2026, 5:30 pm | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
