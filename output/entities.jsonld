    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Revelry and Ritual The works of Irish choreographer Michael Keegan-Dolan are defined by feeling and collective connection. His exceptional dance-theatre productions skillfully integrate pathos and humour, and draw on themes of love and identity. Bringing..."
      }
    ],
