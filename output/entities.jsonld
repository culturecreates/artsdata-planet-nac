    "http://schema.org/name": [
      {
        "@value": "Beaded Orange Shirt Pin Workshop with Stephanie Peltier"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "In this workshop you will learn how to make a beaded Orange Shirt pin for National Day for Truth and Reconciliation. This workshop provides the opportunity to learn more about an Indigenous art form while learning the importance of Orange Shirt Day. Suitable for beginner beaders and experienced beaders alike, ages 16 and up. Basic sewing experience recommended. Workshop will be delivered in English but questions are welcome in French. Supplies are included. This workshop takes place at 1 Elgin St, in the National Arts Centre’s Atelier Shenkman Smith which is located across from the Box Office."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Indigenous arts"
      },
      {
        "@value": "Workshops"
      }
    ],
