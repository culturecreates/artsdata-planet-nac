    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Primary Colours  | The Feeling of Free |  Sat, Aug 8, 2026, 4:30 pm | Along the Rideau Canal"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
