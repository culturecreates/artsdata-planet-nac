  {
    "@id": "https://nac-cna.ca/en/event/41787",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "en-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
        "@value": "https://nac-cna.ca/en/event/41787"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Flore Laurentienne |  Thu, Feb 11, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41787/rounded_corner_design_(3)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Rooted in the Québec landscape and inspired by the vastness of the St. Lawrence River, Flore Laurentienne’s music— a harmonious blend of strings and analog synthesizers—takes us on a journey to the edge of the sublime, where we find ourselves both fragile and powerful, suspended between vulnerability and wonder. \n\nFlore Laurentienne draws inspiration from contrasting worlds: the melodic clarity and counterpoint of Johann Sebastian Bach; the narrative intensity and progressive audacity of King Crimson; and the electronic minimalism of Hans-Joachim Roedelius...."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
