  {
    "@id": "https://nac-cna.ca/event/41507#2026-05-01T07:00:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ExhibitionEvent"
      }
    ],
    "http://schema.org/eventStatus": [
