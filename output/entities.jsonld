      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Melodies of Krishna  | ArohaFest Diwali Dhamaka |  Sun, Oct 18, 2026, 7:30 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42082/mok_-_image_1_-_aroha_fine_arts__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "ArohaFest Diwali Dhamaka is the only fully bilingual festival showcasing the arts and culture of India in Canada, while celebrating Diwali, the vibrant festival of lights.\n\nTo conclude this year's edition of the festival, Melodies of Krishna promises an intimate evening that reveals the beauty and joy of the mythical blue deity. The dancers of Aroha Fine Arts proudly present this unique production that explores mythology, musicality, and technical prowess through the intricacies of kathak, a classical Indian dance.\n\nMay the melodies..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
