      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Shelley, Strauss & Ravel | with the NAC Orchestra | Jun 23 - 24, 2027 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40419/9169_nac_naco_26_27_batch4_2_(1)__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A few things to know ...\n\n\n\tFire up your imagination as Alexander Shelley leads a program of story-driven works, which conjure vivid scenes of explosive battles and candlelit ballrooms.\n\tJust like Star Wars and The Lord of the Rings, Richard Strauss’s Ein Heldenleben follows the journey of a hero in search of freedom and adventure.\n\n\n“I don’t see why I shouldn’t compose a symphony about myself,” Richard Strauss confessed to a friend. “I find myself quite as interesting as Napoleon!” With that battle..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
