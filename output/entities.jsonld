    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Classic Albums Live: Billy Joel | The Stranger |  Sat, Oct 3, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
