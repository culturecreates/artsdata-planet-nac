      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Jireh Gospel Choir |  Sat, Mar 20, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42029/jireh_web__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Award-winning Jireh Gospel Choir is a Montreal-based gospel ensemble led by director Carol Bernard. In 2025, the choir was the subject of the National Film Board of Canada documentary Jireh Gospel: Hearts in Chorus. With a rich blend of voices, each on their own microphone, backed by some of Montreal’s finest musicians, Jireh creates a powerful sound.\n\nFrom traditional and contemporary gospel to spirituals and hip-hop, their repertoire includes familiar gospel songs as well as original compositions, captivating audiences of all..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
