    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Ottawa Latin Jazz Conference | Rachelle Behrens, Anh Phung & Civil Lizard, and Orlando Cardoso Trio |  Fri, Sep 25, 2026, 8:00 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41962/oljc_2026_friday_sept_25__2026__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Ottawa Latin Jazz Conference returns to the National Arts Centre from September 25–27, 2026, celebrating the strength and creativity of Canada’s multicultural diaspora. Presented by Latin Hub Canada, this third edition features concerts, workshops, panels, and networking sessions with leading artists such as Anh Phung, Orlando Cardoso, Rachelle Behrens, Oná Ensemble, João Lenhari, Adis Rodriguez, Joy Lapps, and Grammy Award–winning pianist Hilario Durán.\n\nWith a special focus on Afro‑Cuban rhythmic traditions and Latin jazz education in Canada, the conference offers..."
      }
    ],
