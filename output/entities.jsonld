      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40374"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Matriarchs Uprising  | the eggstravaganza + WHAKAHĀ   |  10-11 jun 2027|  Studio Azrieli"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40374/matriachs-uprising-final_web__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une célébration du matriarcat\n\nle eggstravaganza  \nde Sophie Dow et Kathleen Nisbet \n\nWhakahā\nde Louise Pōtiki Bryant et Paddy Free\n\nOrchestré par Olivia C. Davies, Matriarchs Uprising offre une scène aux femmes autochtones pour imaginer le futur de la danse et des récits autochtones contemporains. Entre prestations, échanges et pratiques collectives, le festival devient un lieu où passé, présent et futur se rencontrent dans la bienveillance, la détermination et la créativité.\n\nLe public est invité à plonger dans des œuvres qui célèbrent la richesse des traditions..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/event/40374#2027-06-11T20:00:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/DanceEvent"
      },
      {
        "@id": "http://kg.artsdata.ca/resource/DancePerformance"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@value": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@value": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-06-11T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-06-11T22:00:00-04:00"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Matriarchs Uprising the eggstravaganza + WHAKAHĀ"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Matriarchs Uprising festival, curated by Olivia C. Davies, is a powerful gathering of Indigenous women whose practices evolve contemporary Indigenous dance and storytelling while honouring the artists who came before them. Through performances, conversations, and shared practice, the festival creates a space where past, present, and future meet with care, intention, and artistry."
      },
      {
        "@value": "Orchestré par Olivia C. Davies, Matriarchs Uprising rassemble fièrement des femmes autochtones qui font bouger les codes de la danse et du récit autochtones contemporains, tout en portant haut l’héritage des artistes qui les ont précédées. Entre prestations, échanges et pratiques collectives, le festival devient un lieu où passé, présent et futur se rencontrent dans la bienveillance, la détermination et la créativité."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Indigenous arts"
      },
