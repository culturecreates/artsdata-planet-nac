    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Les mélodies de Krishna   | ArohaFest Diwali Dhamaka |   dim 18 oct 2026, 19 h 30|  Quatrième Salle"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
