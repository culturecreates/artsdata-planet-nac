  {
    "@id": "https://nac-cna.ca/event/42158#2026-11-02T19:00:00-05:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/DanceEvent"
      },
      {
        "@id": "http://kg.artsdata.ca/resource/WorkshopEvent"
      }
    ],
