    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Beaded Orange Shirt Pin Workshop | with Stephanie Peltier |  Mon, Sep 28, 2026, 6:00 pm | Atelier Shenkman Smith"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41876/stephanie_peltier_orange_shirt__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "In this workshop you will learn how to make a beaded Orange Shirt pin for National Day for Truth and Reconciliation. This workshop provides the opportunity to learn more about an Indigenous art form while learning the importance of Orange Shirt Day. \n\nSuitable for beginner beaders and experienced beaders alike, ages 16 and up. Basic sewing experience recommended. Workshop will be delivered in English but questions are welcome in French.  \n\nSupplies are included. \n\nThis workshop takes place at 1 Elgin St, in the..."
      }
    ],
