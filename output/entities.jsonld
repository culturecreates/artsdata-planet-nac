    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Allison Russell | with AHI |  Sun, Oct 25, 2026, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41399/_mp39488_final_v1_warm2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Grammy-winning musician, poet and actor Allison Russell released her third studio album In The Hour of Chaos! The album is a fervent plea for connection in this time of alienation, isolation and dread. It’s an album that is meant to make you feel GOOD and, in these times, feeling good is a radical act. \n\n The accolades for Russell have been immense. Last year she was shortlisted for the Polaris Prize and named Billboard Women In Music Canada’s “Breakthrough Artist of the..."
      }
    ],
