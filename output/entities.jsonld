      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Michael Kaeshammer | My Valentine |  Sat, Feb 13, 2027, 7:30 pm | Babs Asper Theatre"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41641/rounded_corner_design__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate Valentine’s season with an unforgettable evening of music, charm, and virtuosity as acclaimed Canadian pianist and singer Michael Kaeshammer takes the stage. A true “piano whisperer,” Kaeshammer is renowned for coaxing dazzling, kaleidoscopic sounds from the keys, blending jazz, pop, and boogie-woogie into a style that only a few can rival. \n\nWith a career spanning more than two decades, Kaeshammer has released 15 albums, earned seven Juno Award nominations, and built a global reputation through performances across Canada, the United..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
