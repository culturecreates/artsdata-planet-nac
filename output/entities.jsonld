    "http://schema.org/name": [
      {
        "@value": "Son of a Preacherman Written and performed by Ins Choi"
      },
      {
        "@value": "Son of a Preacherman Écrit et interprété par Ins Choi"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "This deeply personal show sits at the intersection of faith and art— a whimsical, funny, and heartfelt tribute from a Canadian theatre icon to his father, his passion, and the Korean-Canadian communities."
      },
      {
        "@value": "Ce spectacle éminemment intime à la croisée de la foi et de l’art est un hommage fantaisiste, drôle et émouvant d’une figure majeure du théâtre canadien à son père, à sa passion et à la communauté coréenne canadienne."
      }
    ],
