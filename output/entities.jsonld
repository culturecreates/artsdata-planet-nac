      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "k.d. lang: has always been  | Une exposition des tenues de scène |  17sep- 5 oct 2026|  Foyer de la Mezzanine de la salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42108/kd-lang_ingenue_art-12__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "En parallèle de la soirée hommage k.d. lang: has always been, le Département des archives du CNA est fier de présenter une exposition réunissant des tenues de scène emblématiques des débuts de k.d. lang. Ces pièces ont été généreusement prêtées par le Centre national de musique.\n\nk.d. lang a marqué les esprits non seulement par sa voix exceptionnelle et son audace artistique, mais aussi par sa façon singulière d’exprimer sa personnalité et sa créativité, sur scène comme en dehors des projecteurs.\n\nLes..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
