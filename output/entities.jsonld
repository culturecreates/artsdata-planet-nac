      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "sheila&lucile | When Winter Comes, with special guest Sharlene Wallace |  Wed, Nov 25, 2026, 7:30 pm | Fourth Stage"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/41922/sheilalucilewallace__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "sheila&lucile return to the Fourth Stage for their annual Winter show, featuring the duo’s adaptations of familiar and unusual music for the season. This year’s show comes with a fabulous twist; they will be joined by special guest, harpist Sharlene Wallace.\n\n \n\nsheila&lucile perform on a variety of flutes and harps, creating a unique sound inspired by the range of colours and textures heard in and between their instruments. Well acquainted with audiences in and around Ottawa, the duo’s profile runs deep,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
