      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Notre-Dame de Paris Symphonic |  Sat, May 1, 2027, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42031/notredamedeparis_1920x1080__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "More than 25 years after captivating an entire generation, Notre-Dame de Paris returns in its full orchestral power in a symphonic adaptation by Simon Leclerc, performed by the FILMharmonique Orchestra under the direction of Francis Choinière.\n\nTaking on these iconic roles are Pierre Lapointe (Gringoire), Marc Hervieux (Quasimodo), Marie-Eve Janvier (Esmeralda), Christian Marc Gendron (Frollo), Sam Champagne (Phoebus), Josiane (Fleur-de-Lys) and Gardy Fury (Clopin).\n\nRediscover the songs that defined a generation — Belle, Le Temps des cathédrales, Vivre, Danse mon Esmeralda and..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
    ]
  },
