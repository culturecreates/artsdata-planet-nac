    "http://schema.org/description": [
      {
        "@value": "Halifax’s Matchstick Theatre presents a fresh take on a 1970s landmark Canadian family drama that skilfully reveals its modern-day relevance."
      },
      {
        "@value": "Le Matchstick Theatre de Halifax fait souffler un vent de fraîcheur sur ce drame familial incontournable des années 1970 qui se révèle on ne peut plus pertinent aujourd’hui."
      }
