  {
    "@id": "https://nac-cna.ca/fr/event/40403",
    "http://ogp.me/ns/fb#app_id": [
      {
        "@language": "fr-ca",
        "@value": "123254964370141"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://nac-cna.ca/fr/event/40403"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Dragons, ciné-concert  | avec l’Orchestre du CNA |   8-10 jui 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40403/dragon_hero__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Veuillez noter que les billets Moinsde30 sont en nombre limité pour ces représentations.\n\nPrisé autant du public que de la critique, Dragons de DreamWorks est une histoire originale et captivante combinant humour, scènes d’action enflammées et aventures épiques!\n\nHarold est un jeune Viking qui défie la tradition en devenant ami avec son ennemi mortel, un dragon féroce qu’il surnomme Krokmou. Ensemble, ces héros improbables devront lutter envers et contre tous pour sauver leurs mondes respectifs.\n\nDragons, ciné-concert combine une projection en haute définition..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
  {
    "@id": "https://nac-cna.ca/event/40403#2027-07-09T20:00:00-04:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/MusicEvent"
      }
    ],
    "http://schema.org/eventStatus": [
