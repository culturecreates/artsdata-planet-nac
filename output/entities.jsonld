    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Storgårds et Hewitt  | Avec l'Orchestre du CNA |  27-28 jan 2027|  Salle Southam"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40402/9169_nac_naco_26_27_batch1_9__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Quelques infos clés...\n\n\n\tRomantisme et passion sont à l’ordre du jour avec le Concerto pour piano de Robert Schumann, l’une des nombreuses déclarations d’amour musicales du compositeur à sa femme, Clara.\n\tLa célèbre pianiste Angela Hewitt est de retour à Ottawa, sa ville natale, pour livrer une interprétation intime et sincère du concerto de Schumann.\n\tNe manquez pas cette occasion rare d’entendre la Première symphonie de la compositrice canadienne Jean Coulthard, une œuvre dramatique et prenante qui n’a pas été jouée dans son..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "fr-ca",
        "@value": "728780803"
      }
    ]
  },
