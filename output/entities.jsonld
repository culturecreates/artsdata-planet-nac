      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Midsummer Night Dreams: Les Grands Ballets Canadiens"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An enchanted&nbsp;forest, themes of love, illusion and desire, mischief, intrigue, and a star hobgoblin &mdash; it&rsquo;s no wonder Shakespeare&rsquo;s A Midsummer Night&rsquo;s Dream has enjoyed such enduring popularity. Add a gifted choreographer and a renowned ballet company to the mix, and you have a tour de force in the making."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Dance"
      },
      {
        "@value": "Ballet with Orchestra"
      },
      {
        "@value": "Canadian"
      }
    ],
    "http://schema.org/url": [
      {
        "@value": "https://nac-cna.ca/en/event/40365#2027-02-04T20:00:00-05:00"
