    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "2par2 | Ebnflōh Dance Company | Feb 25 - 26, 2027 | Azrieli Studio"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40363/ebnfloh_alexandra_spicey_lande_2par2_working_title_01_melika_dez__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Power of Connection\n\nChoreographer Alexandra ‘Spicey’ Landé is a major player on the Québec Hip Hop dance scene whose artistic aesthetic combines a tension towards chaos and an affirmation of stillness — opposing forces that create both a pictorial quality and a restless and flowing energy that fills the stage.\n\nIn her new work 2par2, she places relationships, in all their contradictions, at the centre of her artistic explorations. Conceived as a play of dualities and polarities, the work embraces an..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
