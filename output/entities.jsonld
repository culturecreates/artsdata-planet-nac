    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "TEHOHÀHAKE – The Art of Tom Wilson | Sep 10 - 19, 2026 | Babs Asper Theatre Foyer"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/42061/exhibitimage2__large.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Acclaimed Canadian musician, author, playwriter and Order of Canada recipient Tom Wilson has been painting for over 30 years. Wilson had always painted images that came to him in childhood dreams. Strong, bold Indigenous-styled imagery often etched with words from his music and writing. At the time, his daughter called it cultural appropriation, he simply said, I paint what I feel, what I know. Little did he know that he was painting from his truth – his blood memory –..."
      }
    ],
