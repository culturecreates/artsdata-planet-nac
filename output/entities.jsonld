    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Classic Albums Live: Fleetwood Mac | Rumours |  Sat, Jan 30, 2027, 8:00 pm | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
