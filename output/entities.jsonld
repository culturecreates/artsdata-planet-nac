    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Throughout the workshop, participants will be guided through the techniques used to create raised beadwork while learning about the cultural significance of the strawberry from a Kanien’kehá (Mohawk) perspective. The strawberry holds an important place within Haudenosaunee teachings, representing connection, healing, gratitude, and the renewal of life."
      }
    ],
