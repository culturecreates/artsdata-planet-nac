      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Roderick Cox and the Scottish Symphony | With the NAC Orchestra | Oct 14 - 15, 2026 | Southam Hall"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-ca",
        "@value": "https://naccnaca-eventimages.s3.amazonaws.com/40396/metaadtemplate_1_(8)__large.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Jazz, spirituals, poetry, misty landscapes, and gathering storms come together in a program spanning three very different musical worlds.\n\nA few things to know ...\n\n\n\tHoney and rue, mist and storms: this program moves between vivid musical worlds, from Toni Morrison’s poetry and André Previn’s blend of jazz and spirituals to the wild landscapes of Mendelssohn’s Scotland.\n\tSouth African soprano Vuvu Mpofu joins conductor Roderick Cox for Previn’s Honey and Rue, six settings of poems by Nobel Prize winner Toni Morrison exploring loneliness,..."
      }
    ],
    "http://ogp.me/ns/fb#admins": [
      {
        "@language": "en-ca",
        "@value": "728780803"
      }
